<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- 
  The blindfold is useful for Chyrr as it gives various effects (increased psychic sensitivity, 
  no effect from ugly surroundings, etc), so allow them to make it.
  -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ideology</li>
    </mods>
    <match Class="XylRacesCore.PatchOperationAddOrMerge">
      <xpath>Defs/ThingDef[defName="Apparel_Blindfold"]</xpath>
      <value>
        <modExtensions>
          <li Class="XylRacesCore.DefModExtension_GeneDependent">
            <genePrerequisitesAny>
              <li>XylEcholocation</li>
            </genePrerequisitesAny>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- 
  Outer-layer apparel that covers the torso disables flight unless it is sufficiently light.
  The weight is chosen so that dusters and parkas stop flight, but jackets don't. The
  ChildApparelMakeableBase condition covers kid parkas.
  -->
  <Operation Class="XylRacesCore.PatchOperationAddOrMerge">
    <xpath>
      Defs/ThingDef[apparel/bodyPartGroups/li = "Torso" and
      apparel/layers/li = "Shell" and
      (statBases/Mass >= 2 or (statBases/Mass >= 1 and @ParentName = "ChildApparelMakeableBase"))]</xpath>
    <value>
      <modExtensions>
        <li Class="XylRacesCore.Genes.ThingDefExtension_Flight">
          <allowsFlight>false</allowsFlight>
        </li>
      </modExtensions>
    </value>
  </Operation>

</Patch>