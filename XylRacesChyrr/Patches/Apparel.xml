<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- 
  The blindfold is useful for Chyrr as it gives various effects (increased psychic sensitivity, no affect from ugly surroundings, etc).
  -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ideology</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="XylRacesCore.PatchOperationAddOrMerge">
          <xpath>Defs/ThingDef[defName="Apparel_Blindfold"]</xpath>
          <value>
            <modExtensions>
              <li Class="XylRacesCore.DefModExtension_GeneDependent">
                <genePrerequisitesAny>
                  <li>XylEcholocation</li>
                </genePrerequisitesAny>
              </li>
            </modExtensions>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

  <Operation Class="XylRacesCore.PatchOperationAddOrMerge">
    <xpath>
      Defs/ThingDef[apparel/bodyPartGroups/li = "Torso" and
      apparel/layers/li = "Shell" and
      (statBases/Mass >= 2 or (statBases/Mass >= 1 and @ParentName = "ChildApparelMakeableBase"))]</xpath>
    <value>
      <modExtensions>
        <li Class="XylRacesCore.Genes.ThingDefExtension_Flight">
          <allowsFlight>false</allowsFlight>
        </li>
      </modExtensions>
    </value>
  </Operation>

</Patch>