<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <hediffClass>XylRacesCore.Hediff_SubstituteCapacity</hediffClass>
    <defName>XylEcholocation</defName>
    <label>echolocation</label>
    <description>This character has echolocation.</description>
    <initialSeverity>1.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <modExtensions>
      <li Class="XylRacesCore.HediffDefExtension_SubstituteCapacity">
        <originalCapacity>Sight</originalCapacity>
        <substituteCapacity>Hearing</substituteCapacity>
        <mode>Maximum</mode>
        <excludeStats>
          <li>ReadingSpeed</li>
        </excludeStats>
      </li>
    </modExtensions>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>XylPrecognition</defName>
    <label>precognition</label>
    <description>This character has the ability to see a short distance into the future, giving bonuses to dodging and accuracy in combat. The effect scales with psychic sensitivity.</description>
    <initialSeverity>1.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
        <statFactors>
          <MeleeHitChance>1.2</MeleeHitChance>
          <MeleeDodgeChance>1.2</MeleeDodgeChance>
          <ShootingAccuracyPawn>1.2</ShootingAccuracyPawn>
        </statFactors>
        <statFactorEffectMultiplier>PsychicSensitivity</statFactorEffectMultiplier>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>XylEyelessMask</defName>
    <label>masked</label>
    <description>A mask is blocking this person's vision.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <setMax>0.2</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <isBad>false</isBad>
  </HediffDef>

</Defs>