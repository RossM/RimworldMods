<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <hediffClass>XylRacesCore.Hediff_SubstituteCapacity</hediffClass>
    <defName>XylEcholocation</defName>
    <label>echolocation</label>
    <description>This character has echolocation.</description>
    <initialSeverity>1.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <modExtensions>
      <li Class="XylRacesCore.HediffDefExtension_SubstituteCapacity">
        <originalCapacity>Sight</originalCapacity>
        <substituteCapacity>Hearing</substituteCapacity>
        <mode>Maximum</mode>
        <excludeStats>
          <li>ReadingSpeed</li>
        </excludeStats>
      </li>
    </modExtensions>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>XylPrecognition</defName>
    <label>precognition</label>
    <description>This character has the ability to see a short distance into the future, giving a chance to dodge both melee and ranged attacks in combat. The effect scales with psychic sensitivity.</description>
    <initialSeverity>1.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
        <statOffsets>
          <MeleeDodgeChance>15</MeleeDodgeChance>
          <XylRangedDodgeChance>15</XylRangedDodgeChance>
        </statOffsets>
        <statOffsetEffectMultiplier>PsychicSensitivity</statOffsetEffectMultiplier>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>XylTorpor</defName>
    <label>torpor</label>
    <description>This character's body is responding to low temperature by entering a state of hibernation. Their metabolism will slow, and they will eventually fall unconscious. The condition will reverse itself if the character is warmed up. Bring them to a warm area or give them warm clothes.</description>
    <overrideTooltip>{PAWN}'s body is responding to low temperature by entering a state of hibernation. {PAWN_possessive} metabolism will slow, and {PAWN_pronoun} will eventually fall unconscious. The condition will reverse itself if {PAWN_pronoun} is warmed up. Bring {PAWN_objective} to a warm area or give {PAWN_objective} warm clothes.</overrideTooltip>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <label>yawning</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <label>groggy</label>
        <minSeverity>0.1</minSeverity>
        <becomeVisible>true</becomeVisible>
        <hungerRateFactor>0.5</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.8</setMax>
          </li>
        </capMods>
        <statFactors>
          <XylHypothermiaProgressionFactor>0.5</XylHypothermiaProgressionFactor>
          <XylMalnutritionProgressionFactor>0.5</XylMalnutritionProgressionFactor>
        </statFactors>
      </li>
      <li>
        <label>half-asleep</label>
        <minSeverity>0.25</minSeverity>
        <hungerRateFactor>0.25</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
        <statFactors>
          <XylHypothermiaProgressionFactor>0.25</XylHypothermiaProgressionFactor>
          <XylMalnutritionProgressionFactor>0.25</XylMalnutritionProgressionFactor>
        </statFactors>
      </li>
      <li>
        <label>hibernating</label>
        <minSeverity>0.5</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <hungerRateFactor>0.1</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
        <statFactors>
          <XylHypothermiaProgressionFactor>0.1</XylHypothermiaProgressionFactor>
          <XylMalnutritionProgressionFactor>0.1</XylMalnutritionProgressionFactor>
        </statFactors>
      </li>

    </stages>
  </HediffDef>

</Defs>