    <cooldownPerCharge>true</cooldownPerCharge>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>10.9</range>
      <warmupTime>0.5</warmupTime>
      <soundCast>PsychicShockLanceCast</soundCast>
      <targetParams>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="XylRacesCore.CompProperties_AbilitySonicWave">
        <radius>2.5</radius>
