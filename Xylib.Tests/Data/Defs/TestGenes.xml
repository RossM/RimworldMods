  <Xylib.GeneSetMakerDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>XylibTestBonusBeautyMaker</defName>
    <overrideExistingGenes>true</overrideExistingGenes>
    <root Class="Xylib.GeneSetMaker_List">
      <genes>
        <li>Beauty_Beautiful</li>
      </genes>
    </root>
  </Xylib.GeneSetMakerDef>

  <GeneDef ParentName="XylibTestGeneBase" MayRequire="Ludeon.RimWorld.Biotech">
