      <genes>
        <li>XylibTestGene</li>
      </genes>
    </root>
  </Xylib.GeneSetMakerDef>

  <XenotypeDef>
    <defName>XylibTestInheritedXenotype</defName>
    <label>test inherited xenotype</label>
    <genes>
      <li>XylibTestInheritedA</li>
    </genes>
    <inheritable>true</inheritable>
    <canGenerateAsCombatant>false</canGenerateAsCombatant>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
  </XenotypeDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestTrackerFactors</defName>
    <label>tracker factors</label>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <showInXenotypeCreation>false</showInXenotypeCreation>
        <comps>
          <li Class="Xylib.GeneCompProperties_RaceModifiers">
            <bodySizeFactor>2</bodySizeFactor>
            <healthScaleFactor>3</healthScaleFactor>
          </li>
          <li Class="Xylib.GeneCompProperties_RenderNodeModifiers">
            <bodyScale>2</bodyScale>
            <headScale>0.5</headScale>
          </li>
          <li Class="Xylib.GeneCompProperties_UnlockRecipes">
            <recipes>
              <li>CookMealSimple</li>
            </recipes>
          </li>
          <li Class="Xylib.GeneCompProperties_UnlockBuildables">
            <buildables>
              <li>Wall</li>
            </buildables>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestTrackerBodySize</defName>
    <label>tracker body size</label>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <showInXenotypeCreation>false</showInXenotypeCreation>
        <comps>
          <li Class="Xylib.GeneCompProperties_RaceModifiers">
            <bodySizeFactor>0.75</bodySizeFactor>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

