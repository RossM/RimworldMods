<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneCategoryDef>
    <defName>XylibTestGenes</defName>
    <label>test genes</label>
  </GeneCategoryDef>

  <GeneDef Name="XylibTestGeneBase" Abstract="True">
    <geneClass>Xylib.GeneWithComps</geneClass>
    <description>Fixture used by the in-game tests.</description>
    <displayCategory>XylibTestGenes</displayCategory>
    <selectionWeight>0</selectionWeight>
  </GeneDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestGene</defName>
    <label>test gene</label>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <showInXenotypeCreation>false</showInXenotypeCreation>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestOtherGene</defName>
    <label>other test gene</label>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <showInXenotypeCreation>false</showInXenotypeCreation>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestThirdGene</defName>
    <label>third test gene</label>
