      <li Class="Xylib.DefModExtension_GeneWithComps">
        <showInXenotypeCreation>false</showInXenotypeCreation>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestProbe</defName>
    <label>probe gene</label>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <showInXenotypeCreation>false</showInXenotypeCreation>
        <comps>
          <li Class="Xylib.Tests.ProbeProperties" />
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestDerivedProbe</defName>
    <label>derived probe gene</label>
