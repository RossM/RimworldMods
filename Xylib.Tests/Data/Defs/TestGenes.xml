  <Xylib.GeneSetMakerDef>
    <defName>XylibTestAddBonusMaker</defName>
    <root Class="Xylib.GeneSetMaker_List">
      <genes>
        <li>XylibTestGene</li>
        <li>XylibTestOtherGene</li>
      </genes>
    </root>
  </Xylib.GeneSetMakerDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestAddBonus</defName>
    <label>bonus gene source</label>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <showInXenotypeCreation>false</showInXenotypeCreation>
        <comps>
          <li Class="Xylib.GeneCompProperties_BonusGenes">
            <maker>XylibTestAddBonusMaker</maker>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <Xylib.GeneSetMakerDef>
    <defName>XylibTestReplaceXenogenesMaker</defName>
    <overrideExistingGenes>true</overrideExistingGenes>
    <root Class="Xylib.GeneSetMaker_List">
      <genes>
        <li>XylibTestConflictD</li>
      </genes>
    </root>
  </Xylib.GeneSetMakerDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestReplaceXenogenes</defName>
