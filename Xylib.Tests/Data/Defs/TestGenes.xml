      <li Class="Xylib.DefModExtension_GeneWithComps">
        <showInXenotypeCreation>false</showInXenotypeCreation>
        <comps>
          <li Class="Xylib.Tests.ProbeProperties">
            <compClass>Xylib.Tests.DerivedProbeComp</compClass>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="XylibTestGeneBase">
    <defName>XylibTestMetabolism</defName>
    <label>metabolism gene</label>
    <biostatMet>2</biostatMet>
