<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <!-- Display categories -->

  <Operation Class="PatchOperationReplace">
    <xpath>
      Defs/GeneDef[
        defName="StrongStomach" or
        defName="RobustDigestion"
      ]/displayCategory
    </xpath>
    <value>
      <displayCategory>BS_Diet</displayCategory>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[@Name="GeneTailBase"]/displayCategory</xpath>
    <value>
      <displayCategory>AG_Cosmetic_Tails</displayCategory>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[@Name="GeneEarsBase"]/displayCategory</xpath>
    <value>
      <displayCategory>AG_Cosmetic_Ears</displayCategory>
    </value>
  </Operation>

  <!-- Exclusion tags -->

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="RobustDigestion"]</xpath>
    <value>
      <exclusionTags>
        <li>XylDigestion</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="FacialRidges"]</xpath>
    <value>
      <exclusionTags>
        <li>XylFace</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="Brow_Heavy"]</xpath>
    <value>
      <exclusionTags>
        <li>XylBrow</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[@Name="GeneHairStyleBase"]</xpath>
    <value>
      <exclusionTags>
        <li>XylHairStyleMale</li>
        <li>XylHairStyleFemale</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="KindInstinct"]</xpath>
    <value>
      <exclusionTags>
        <li>XylEmpathy</li>
      </exclusionTags>
    </value>
  </Operation>

</Patch>
