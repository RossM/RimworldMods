<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <Operation Class="Xylib.PatchOperationReplaceGenes">
    <entries>
      <li>
        <original>XylNocturnal</original>
        <replacement>BS_NightOwl</replacement>
      </li>
    </entries>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="BS_NightOwl"]</xpath>
    <value>
      <exclusionTags>
        <li>XylNightOwl</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="BS_AutoPregnancy" or defName="BS_AutoPregnancyArchite"]</xpath>
    <value>
      <exclusionTags>
        <li>XylAsexualPregnancy</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="BS_Diet_Herbivore" or defName="BS_Diet_Fuel"]</xpath>
    <value>
      <exclusionTags>
        <li>XylMeatRequirement</li>
      </exclusionTags>
    </value>
  </Operation>

  <!-- Display categories -->

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[@Name="BS_FunctionalWingBase" or defName="XylBatWings"]</xpath>
    <value>
      <displayCategory>AG_Wings</displayCategory>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="XylDwarf" or defName="XylGiant"]</xpath>
    <value>
      <displayCategory>Body_Size</displayCategory>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[@Name="GeneLearningBase" or defName="XylLearning_Focused"]</xpath>
    <value>
      <displayCategory>BS_Learning</displayCategory>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="XylLargeHorns" or defName="XylRetractableClaws"]</xpath>
    <value>
      <displayCategory>BS_InnateAttacks</displayCategory>
    </value>
  </Operation>

</Patch>
