<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <!-- Keep the shower def for existing saves, but stop the aquatic gene from unlocking construction. -->
  <Operation Class="PatchOperationRemove">
    <xpath>
      Defs/GeneDef[defName="XylAquatic"]/modExtensions/li[@Class="Xylib.DefModExtension_GeneWithComps"]/comps/
      li[@Class="Xylib.GeneCompProperties_UnlockBuildables"][buildables/li="XylShower"]
    </xpath>
  </Operation>

  <!-- 
  washAtCell does not need a marker because it takes place in a water cell, which is already wet.
  If going to a water cell specifically for wetness is needed it will be handled by JobDriver_Soak.
  -->
    
  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/JobDef[defName="useWashBucket"]</xpath>
    <value>
      <modExtensions>
        <li Class="XylXenos.DefModExtension_Job_WetnessSource">
          <overrideDuration>3000</overrideDuration>
          <wetnessLevel>0.65</wetnessLevel>
        </li>
      </modExtensions>
    </value>
  </Operation>

  <!-- 
  washPatient won't work as a wetness source yet because it would grant the wetness to the pawn
  doing the job, not the target.
  -->
    
  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/DubsBadHygiene.WashingJobDef[defName="takeShower"]</xpath>
    <value>
      <modExtensions>
        <li Class="XylXenos.DefModExtension_Job_WetnessSource">
          <overrideDuration>3000</overrideDuration>          
        </li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/DubsBadHygiene.WashingJobDef[defName="takeBath"]</xpath>
    <value>
      <modExtensions>
        <li Class="XylXenos.DefModExtension_Job_WetnessSource">
          <neverEndsEarly>true</neverEndsEarly>          
        </li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/ThingDef[@Name="DubsDirtyShowerBase"]</xpath>
    <value>
      <modExtensions>
        <li Class="XylXenos.DefModExtension_Thing_WetnessSource">
          <job>takeShower</job>
        </li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/ThingDef[@Name="DubsDirtyBathtubBase"]</xpath>
    <value>
      <modExtensions>
        <li Class="XylXenos.DefModExtension_Thing_WetnessSource">
          <job>takeBath</job>
        </li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/ThingDef[defName="WashBucket"]</xpath>
    <value>
      <modExtensions>
        <li Class="XylXenos.DefModExtension_Thing_WetnessSource">
          <job>useWashBucket</job>
        </li>
      </modExtensions>
    </value>
  </Operation>

</Patch>
