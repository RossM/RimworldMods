<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <FactionDef ParentName="OutlanderRoughBase">
    <defName>XylOutlanderRoughDvergr</defName>
    <label>rough dvergr union</label>
    <pawnSingular>dvergr</pawnSingular>
    <pawnsPlural>dvergr</pawnsPlural>
    <description>A union of industrial mining settlements led by dvergr clan corporations. Their people trace their origins to the underground cities of Svartalfheim, and build their lives around mining, manufacturing, and the interests of the clan. Their mountain halls are filled with workshops, breweries, and machinery.\n\nThey defend their claims with firearms and explosives, applying their knowledge of excavation as readily to an enemy's walls as to a mineral deposit. Competition over resources can turn violent, and their enthusiasm for blasting often exceeds their concern for safety.\n\nThis particular union is unfriendly to outsiders, but can be persuaded to trade and form alliances.</description>
    <factionIconPath>Xyl/World/WorldObjects/Expanding/TownDvergr</factionIconPath>
    <xenotypeSet Inherit="False" Class="Xylib.XenotypeSetWithDefault">
      <defaultXenotype>XylDvergr</defaultXenotype>
      <xenotypeChances>
        <Baseliner>0.1</Baseliner>
        <Dirtmole>0.15</Dirtmole>
        <Genie>0.025</Genie>
        <Hussar>0.05</Hussar>
        <Impid>0.025</Impid>
        <Neanderthal>0.025</Neanderthal>
        <Pigskin>0.025</Pigskin>
        <Waster>0.025</Waster>
        <Yttakin>0.025</Yttakin>
        <XylTitan>0.05</XylTitan>
        <XylTrog>0.025</XylTrog>
        <XylOmegabeaver>0.005</XylOmegabeaver>
      </xenotypeChances>
    </xenotypeSet>
    <colorSpectrum Inherit="false">
      <li>(0.5, 0.3, 0.2)</li>
      <li>(0.45, 0.40, 0.35)</li>
    </colorSpectrum>
    <factionNameMaker>NamerXylFactionOutlanderDvergr</factionNameMaker>
    <settlementNameMaker>NamerXylSettlementOutlanderDvergr</settlementNameMaker>
    <apparelStuffFilter Inherit="false">
      <stuffCategoriesToAllow>
        <li>Metallic</li>
        <li>Leathery</li>
      </stuffCategoriesToAllow>
      <thingDefs>
        <li>DevilstrandCloth</li>
      </thingDefs>
    </apparelStuffFilter>
    <allowedCultures Inherit="false">
      <li>XylNorisk</li>
    </allowedCultures>
    <requiredMemes Inherit="false">
      <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
    </requiredMemes>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Bloodfeeding</li>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Inhuman</li>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Ritualist</li>
    </disallowedMemes>
    <pawnGroupMakers Inherit="false">
      <li>
        <!-- Normal fights, standard mix -->
        <kindDef>Combat</kindDef>
        <options>
          <Villager_Breach_XylDvergr>5</Villager_Breach_XylDvergr>
          <Town_Guard_XylDvergr>10</Town_Guard_XylDvergr>
          <Grenadier_Destructive>5</Grenadier_Destructive>
          <Mercenary_Slasher_Plate_XylDvergr>7</Mercenary_Slasher_Plate_XylDvergr>
          <Mercenary_Gunner>5</Mercenary_Gunner>
          <Mercenary_Gunner_Short_XylDvergr>5</Mercenary_Gunner_Short_XylDvergr>
          <Mercenary_Elite>10</Mercenary_Elite>
          <Mercenary_Heavy_Rocket_XylDvergr>1.5</Mercenary_Heavy_Rocket_XylDvergr>
          <Town_Councilman>10</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Villager>10</Villager>
          <Villager_Breach_XylDvergr>10</Villager_Breach_XylDvergr>
          <Villager_Child MayRequire="Ludeon.RimWorld.Biotech">10</Villager_Child>
          <Town_Guard_XylDvergr>10</Town_Guard_XylDvergr>
          <Town_Councilman>10</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Town_Trader>1</Town_Trader>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
          <Alpaca>2</Alpaca>
          <Elephant>1</Elephant>
        </carriers>
        <guards>
          <Villager>3</Villager>
          <Town_Guard_XylDvergr>10</Town_Guard_XylDvergr>
          <Grenadier_Destructive>5</Grenadier_Destructive>
          <Mercenary_Slasher_Plate_XylDvergr>7</Mercenary_Slasher_Plate_XylDvergr>
          <Mercenary_Gunner>5</Mercenary_Gunner>
          <Mercenary_Gunner_Short_XylDvergr>5</Mercenary_Gunner_Short_XylDvergr>
          <Mercenary_Elite>10</Mercenary_Elite>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Villager>5</Villager>
          <Villager_Breach_XylDvergr>5</Villager_Breach_XylDvergr>
          <Town_Guard_XylDvergr>10</Town_Guard_XylDvergr>
          <Grenadier_Destructive>5</Grenadier_Destructive>
          <Mercenary_Slasher_Plate_XylDvergr>7</Mercenary_Slasher_Plate_XylDvergr>
          <Mercenary_Gunner>5</Mercenary_Gunner>
          <Mercenary_Gunner_Short_XylDvergr>5</Mercenary_Gunner_Short_XylDvergr>
          <Mercenary_Elite>10</Mercenary_Elite>
          <Mercenary_Heavy_Rocket_XylDvergr>1.5</Mercenary_Heavy_Rocket_XylDvergr>
          <Town_Councilman>10</Town_Councilman>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Miners</kindDef>
        <commonality>1</commonality>
        <options>
          <Miner>1</Miner>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Hunters</kindDef>
        <commonality>1</commonality>
        <options>
          <Hunter>1</Hunter>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Loggers</kindDef>
        <commonality>1</commonality>
        <options>
          <Logger>1</Logger>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Farmers</kindDef>
        <commonality>1</commonality>
        <options>
          <Farmer>1</Farmer>
        </options>
      </li>
    </pawnGroupMakers>
    <raidLootMaker>XylDvergrRaidLootMaker</raidLootMaker>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Faction">
        <allowedHilliness>
          <li>LargeHills</li>
          <li>Mountainous</li>
        </allowedHilliness>
      </li>
    </modExtensions>
  </FactionDef>

  <PawnKindDef ParentName="VillagerBase">
    <defName>Villager_Breach_XylDvergr</defName>
    <label>prospector</label>
    <defaultFactionDef>XylOutlanderRoughDvergr</defaultFactionDef>
    <canBeSapper>true</canBeSapper>
    <isGoodBreacher>true</isGoodBreacher>
    <weaponMoney>100~250</weaponMoney>
    <weaponTags Inherit="False">
      <li>NeolithicMeleeDestructive</li>
    </weaponTags>
    <apparelRequired>
      <li>Apparel_SimpleHelmet</li>
    </apparelRequired>
  </PawnKindDef>

  <PawnKindDef ParentName="MercenarySlasherBase">
    <defName>Mercenary_Slasher_Plate_XylDvergr</defName>
    <label>ironclad</label>
    <defaultFactionDef>XylOutlanderRoughDvergr</defaultFactionDef>
    <combatPower>120</combatPower>
    <apparelRequired Inherit="false">
      <li>Apparel_PlateArmor</li>
      <li>Apparel_SimpleHelmet</li>
    </apparelRequired>
    <initialResistanceRange>10~16</initialResistanceRange>
  </PawnKindDef>

  <PawnKindDef ParentName="GuardBase">
    <defName>Town_Guard_XylDvergr</defName>
    <label>claim guard</label>
    <defaultFactionDef>XylOutlanderRoughDvergr</defaultFactionDef>
    <weaponMoney>300~400</weaponMoney>
    <weaponTags Inherit="False">
      <li>PumpShotgun</li>
    </weaponTags>
    <apparelRequired>
      <li>Apparel_SimpleHelmet</li>
    </apparelRequired>
  </PawnKindDef>

  <PawnKindDef ParentName="MercenaryGunnerBase">
    <defName>Mercenary_Gunner_Short_XylDvergr</defName>
    <label>tunnel sweeper</label>
    <defaultFactionDef>XylOutlanderRoughDvergr</defaultFactionDef>
    <weaponTags Inherit="False">
      <li>ShortShots</li>
      <li>Flamethrower</li>
    </weaponTags>
    <apparelRequired>
      <li>Apparel_SimpleHelmet</li>
    </apparelRequired>
    <initialResistanceRange>6~10</initialResistanceRange>
  </PawnKindDef>

  <PawnKindDef ParentName="MercenaryHeavyBase">
    <defName>Mercenary_Heavy_Rocket_XylDvergr</defName>
    <label>rocketeer</label>
    <labelPlural>rocketeers</labelPlural>
    <defaultFactionDef>XylOutlanderRoughDvergr</defaultFactionDef>
    <combatPower>150</combatPower>
    <weaponTags Inherit="False">
      <li>GunSingleUse</li>
    </weaponTags>
    <apparelRequired>
      <li>Apparel_SimpleHelmet</li>
    </apparelRequired>
  </PawnKindDef>

  <ThingSetMakerDef>
    <defName>XylDvergrRaidLootMaker</defName>
    <debugParams>
      <totalMarketValueRange>250</totalMarketValueRange>
    </debugParams>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>Gold</li>
            <li>Jade</li>
            <li>Uranium</li>
            <li>Plasteel</li>
            <li>DevilstrandCloth</li>
            <li>MedicineIndustrial</li>
            <li>ComponentIndustrial</li>
            <li>MealSurvivalPack</li>
            <li>Beer</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>

