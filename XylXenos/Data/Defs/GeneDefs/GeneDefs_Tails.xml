<?xml version="1.0" encoding="utf-8" ?>

<Defs>
  
  <GeneDef ParentName="GeneTailBase">
    <defName>XylTail_Beaver</defName>
    <label>beaver tail</label>
    <description>Carriers of this gene grow a broad, flat tail resembling that of an alphabeaver that helps with temperature regulation.</description>
    <iconPath>Xyl/UI/Icons/Genes/Gene_TailBeaver</iconPath>
    <displayOrderInCategory>1001</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <ComfyTemperatureMax>5</ComfyTemperatureMax>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
    </statOffsets>
    <renderNodeProperties>
      <li>
        <debugLabel>BeaverTail</debugLabel>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Xyl/Things/Pawn/Humanlike/BodyAttachments/BeaverTail/BeaverTail</texPath>
        <overrideMeshSize>(1, 1)</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <color>(0.25,0.25,0.25)</color>
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>North</li>
          <li>West</li>
          <li>South</li>
        </visibleFacing>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, -0.5)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, -0.1)</offset>
          </dataSouth>
          <dataEast>
            <offset>(-0.5, 0, -0.3)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, -0.3)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

  <GeneDef ParentName="GeneTailBase">
    <defName>XylTail_Pointed</defName>
    <label>pointed tail</label>
    <description>Carriers of this gene grow a narrow, pointed tail that increases the character's impact in social interactions.</description>
    <iconPath>Xyl/UI/Icons/Genes/Gene_TailPointed</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <displayOrderInCategory>1002</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <SocialImpact>0.4</SocialImpact>
    </statOffsets>
    <renderNodeProperties>
      <li>
        <debugLabel>PointedTail</debugLabel>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Xyl/Things/Pawn/Humanlike/BodyAttachments/PointedTail/PointedTail</texPath>
        <overrideMeshSize>(1, 1)</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <colorType>Skin</colorType>
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>North</li>
          <li>West</li>
        </visibleFacing>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataEast>
            <offset>(-0.5, 0, 0)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, 0)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

  <GeneDef ParentName="GeneTailBase">
    <defName>XylTail_Squirrel</defName>
    <label>squirrel tail</label>
    <description>Carriers of this gene grow a long, fluffy tail that keeps them warm and increases the opinion of other characters towards them.</description>
    <iconPath>Xyl/UI/Icons/Genes/Gene_TailSquirrel</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <displayOrderInCategory>1003</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
    </statOffsets>
    <customEffectDescriptions>
      <!-- Beauty gives +20 opinion per met, so this is a bit less than half a met worth -->
      <li>Opinion +8</li>
    </customEffectDescriptions>
    <renderNodeProperties>
      <li>
        <debugLabel>SquirrelTail</debugLabel>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Xyl/Things/Pawn/Humanlike/BodyAttachments/SquirrelTail/SquirrelTail</texPath>
        <parentTagDef>Body</parentTagDef>
        <colorType>Hair</colorType>        
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>North</li>
          <li>West</li>
          <li>South</li>
        </visibleFacing>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, 0.2)</offset>
          </dataSouth>
          <dataEast>
            <offset>(-0.6, 0, 0)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.6, 0, 0)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>
  <ThoughtDef>
    <defName>XylSquirrelTail</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>XylXenos.ThoughtWorker_HasGene</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <nullifyingTraits>
      <li>Psychopath</li>
    </nullifyingTraits>
    <stages>
      <li>
        <label>squirrel tail</label>
        <baseOpinionOffset>8</baseOpinionOffset>
      </li>
    </stages>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Thought">
        <gene>XylTail_Squirrel</gene>
        <requiresSight>true</requiresSight>
      </li>
    </modExtensions>
  </ThoughtDef>

  <GeneDef ParentName="GeneTailBase">
    <defName>XylTail_Lizard</defName>
    <label>lizard tail</label>
    <description>Carriers of this gene grow a long, heavy tail that improves balance and mobility.</description>
    <iconPath>Xyl/UI/Icons/Genes/Gene_TailLizard</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <displayOrderInCategory>1004</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <MoveSpeed>0.1</MoveSpeed>
    </statOffsets>
    <renderNodeProperties>
      <li Class="XylXenos.PawnRenderNodeProperties_GeneDependent">
        <debugLabel>LizardTail</debugLabel>
        <useBodyGraphicScale>true</useBodyGraphicScale>
        <texPath>Xyl/Things/Pawn/Humanlike/BodyAttachments/LizardTail/LizardTail</texPath>
        <parentTagDef>Body</parentTagDef>
        <colorType>Skin</colorType>
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <disallowedGenes>
          <li>XylScaleskin</li>
        </disallowedGenes>
        <visibleFacing>
          <li>East</li>
          <li>North</li>
          <li>West</li>
          <li>South</li>
        </visibleFacing>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, 0.2)</offset>
          </dataSouth>
          <dataEast>
            <offset>(-0.5, 0, 0)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, 0)</offset>
          </dataWest>
        </drawData>
      </li>
      <li Class="XylXenos.PawnRenderNodeProperties_GeneDependent">
        <debugLabel>LizardTail_Scaleskin</debugLabel>
        <useBodyGraphicScale>true</useBodyGraphicScale>
        <texPath>Xyl/Things/Pawn/Humanlike/BodyAttachments/LizardTail/LizardTail_Scaleskin</texPath>
        <parentTagDef>Body</parentTagDef>
        <colorType>Skin</colorType>
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <requiredGenes>
          <li>XylScaleskin</li>
        </requiredGenes>
        <visibleFacing>
          <li>East</li>
          <li>North</li>
          <li>West</li>
          <li>South</li>
        </visibleFacing>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, 0.2)</offset>
          </dataSouth>
          <dataEast>
            <offset>(-0.5, 0, 0)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, 0)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

</Defs>