<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <StatDef>
    <defName>XylTreeCuttingSpeed</defName>
    <label>tree cutting speed</label>
    <description>A multiplier on how quickly this person cuts or harvests trees, in addition to their plant work speed.</description>
    <category>PawnWork</category>
    <toStringStyle>PercentZero</toStringStyle>
    <defaultBaseValue>1</defaultBaseValue>
    <hideAtValue>1</hideAtValue>
    <minValue>0</minValue>
    <displayPriorityInCategory>4549</displayPriorityInCategory>
  </StatDef>

  <StatDef>
    <defName>XylWetnessFallRate</defName>
    <label>wetness fall rate</label>
    <description>A multiplier on how quickly this character's wetness need decreases out of water.</description>
    <category>PawnHealth</category>
    <toStringStyle>PercentZero</toStringStyle>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <!-- By default, don't show on pawns. Pawns with the Aquatic gene will have it set to show by StatPart_Temperature. -->
    <showOnPawns>false</showOnPawns>
    <parts>
      <li Class="StatPart_GearStatOffset">
        <apparelStat>XylWetnessFallRateOffset</apparelStat>
        <includeWeapon>true</includeWeapon>
      </li>
      <li Class="XylXenos.StatPart_Temperature">
        <curve>
          <points>
            <li>(-19.0, 1.0)</li>
            <li>(1.0, 0.5)</li>
            <li>(6.0, 0.5)</li>
            <li>(16.0, 1.0)</li>
            <li>(21.0, 1.0)</li>
            <li>(31.0, 2.0)</li>
            <li>(41.0, 5.0)</li>
          </points>
        </curve>
        <showForPawnsWithGenes>
          <li>XylAquatic</li>
        </showForPawnsWithGenes>
      </li>
    </parts>
  </StatDef>
  <StatDef>
    <defName>XylWetnessFallRateOffset</defName>
    <label>wetness fall rate offset</label>
    <description>An offset applied to the user's wetness fall rate.</description>
    <category>Basics</category>
    <toStringStyle>PercentZero</toStringStyle>
    <defaultBaseValue>0</defaultBaseValue>
    <showOnAnimals>false</showOnAnimals>
    <showIfUndefined>false</showIfUndefined>
    <showOnPawns>false</showOnPawns>
  </StatDef>

</Defs>
