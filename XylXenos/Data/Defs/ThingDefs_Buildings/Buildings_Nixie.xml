<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>XylShower</defName>
    <label>shower</label>
    <description>A shower that can satisfy the wetness need of water-dependent pawns.</description>
    <graphicData>
      <texPath>Xyl/Things/Building/Misc/Shower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
      <drawOffset>(0,0,0.25)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <hasInteractionCell>True</hasInteractionCell>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0.0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <costStuffCount>50</costStuffCount>
    <pathCost>14</pathCost>
    <designationCategory>Misc</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Thing_WetnessSource">
        <job>XylTakeShower</job>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef Name="XylAquaticSleepingSpotBase" ParentName="SleepingSpotBase" Abstract="True">
    <terrainAffordanceNeeded>ShallowWater</terrainAffordanceNeeded>
    <canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Bed_GeneRestricted">
        <requiredGenesAny>
          <li>XylAquatic</li>
        </requiredGenesAny>
      </li>
    </modExtensions>
  </ThingDef>
  
  <ThingDef ParentName="XylAquaticSleepingSpotBase">
    <defName>XylAquaticSleepingSpot</defName>
    <label>aquatic sleeping spot</label>
    <description>Designates a spot on shallow water where people should sleep. Not comfortable.</description>
    <graphicData>
      <texPath>Things/Building/Furniture/Bed/SleepSpot</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,4)</drawSize>
    </graphicData>
    <size>(1,2)</size>
    <designationHotKey>Misc1</designationHotKey>
  </ThingDef>

  <ThingDef ParentName="XylAquaticSleepingSpotBase">
    <defName>XylAquaticDoubleSleepingSpot</defName>
    <label>aquatic double sleeping spot</label>
    <description>Designates a spot on shallow water where two people should sleep together. Not comfortable.</description>
    <graphicData>
      <texPath>Things/Building/Furniture/Bed/DoubleSleepSpot</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <size>(2,2)</size>
  </ThingDef>

</Defs>
