<?xml version="1.0" encoding="utf-8" ?>

<Patch>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/ThoughtDef[starts-with(defName,"AteNonMeat_")]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylHerbivoreStomach</li>
      </nullifyingGenes>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/ThoughtDef[starts-with(defName,"AteMeat_") and stages/li/baseMoodEffect &lt; 0]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylMeatDependence</li>
        <li>XylCarnivoreStomach</li>
      </nullifyingGenes>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/ThoughtDef[starts-with(defName,"AteHumanMeat_") and stages/li/baseMoodEffect &lt; 0]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylCarnivoreStomach</li>
      </nullifyingGenes>
    </value>
  </Operation>

</Patch>