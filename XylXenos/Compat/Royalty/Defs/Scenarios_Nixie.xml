<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <ScenarioDef ParentName="ScenarioBase" MayRequire="Ludeon.RimWorld.Royalty">
    <defName>XylTheSiren</defName>
    <label>The Siren</label>
    <description>No one was ever quite sure what the cult believed. Their words were a little too smooth, their smiles a little too still. They spoke of voices from beyond the void, of unity, of dissolving into something greater. When the authorities came, they came hard: dropships, psychic dampeners, orbital jammers. In the aftermath, the cult was gone. Scattered. Burned. Forgotten. But you survived. You've come to this rimworld not to hide, exactly, but to begin again. To wait. To gather. The song is louder here, if you know how to listen.</description>
    <scenario>
      <summary>One nixie with powerful non-combat psychic abilities. Very difficult.</summary>
      <parts>

        <!-- Config pages -->
        <li Class="XylXenos.ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes_Ext">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <overrideKinds>
            <li>
              <xenotype>XylNixie</xenotype>
              <pawnKind>XylNixie_Siren</pawnKind>
            </li>
          </overrideKinds>
          <xenotypeCounts>
            <li>
              <xenotype>XylNixie</xenotype>
              <count>1</count>
              <requiredAtStart>true</requiredAtStart>
            </li>
          </xenotypeCounts>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
        </li>

        <!-- Starting psychics -->
        <li Class="XylXenos.ScenPart_PsylinkLevels">
          <def>XylPsylinkLevels</def>
          <count>3</count>
          <givePsycasts>false</givePsycasts>
          <context>PlayerStarter</context>
        </li>
        <li Class="XylXenos.ScenPart_Psycast">
          <def>XylPsycasts</def>
          <psycast>WordOfTrust</psycast>
          <context>PlayerStarter</context>
        </li>
        <li Class="XylXenos.ScenPart_Psycast">
          <def>XylPsycasts</def>
          <psycast>WordOfJoy</psycast>
          <context>PlayerStarter</context>
        </li>
        <li Class="XylXenos.ScenPart_Psycast">
          <def>XylPsycasts</def>
          <psycast>WordOfLove</psycast>
          <context>PlayerStarter</context>
        </li>
        <li Class="XylXenos.ScenPart_Psycast">
          <def>XylPsycasts</def>
          <psycast>Waterskip</psycast>
          <context>PlayerStarter</context>
        </li>
        <!--<li Class="ScenPart_ForcedHediff">
          <hediff>XylCultistSong</hediff>
          <severityRange>1</severityRange>
          <context>PlayerStarter</context>
        </li>-->

        <!-- Player starting stuff spawn method-->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>1500</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>20</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>10</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>30</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_AssaultRifle</thingDef>
        </li>
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <count>1</count>
          <bondToRandomPlayerPawnChance>1</bondToRandomPlayerPawnChance>
        </li>

        <!-- Scatter some things near player start -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>450</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
          <allowRoofed>True</allowRoofed>
        </li>

        <!-- Game start dialog -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>You wake from cryptosleep as your pod tears through the rimworld's upper atmosphere. The restraints release. The hull groans. The air is thin and dry.\n\nThe song is loud here, louder than it has been in years. You can hear it even over the roar of re-entry. It welcomes you... or warns you. Hard to say.\n\nYou have work to do. Shelter. Supplies. Allies. You're alone for now. But you've done this before. You can do it again.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="ScenPart_CreateIncident">
          <def>CreateIncident</def>
          <incident>XylCultistJoin</incident>
          <minDays>30</minDays>
          <maxDays>60</maxDays>
          <repeat>true</repeat>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>XylNixie_Siren</defName>
    <label>colonist</label>
    <chemicalAddictionChance>0.06</chemicalAddictionChance>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialAdvanced</li>
    </apparelTags>
    <apparelRequired>
      <li>Apparel_Robe</li>
      <li>Apparel_HatHood</li>
    </apparelRequired>
    <ignoreFactionApparelStuffRequirements>true</ignoreFactionApparelStuffRequirements>
    <specificApparelRequirements Inherit="False">
      <li>
        <stuff>Hyperweave</stuff>
        <colorGenerator Class="ColorGenerator_Options">
          <options>
            <li>
              <only>(0.2, 0.4, 0.8)</only>
            </li>
            <li>
              <only>(0.3, 0.6, 0.85)</only>
            </li>
            <li>
              <only>(0.4, 0.8, 0.9)</only>
            </li>
            <li>
              <only>(0.5, 0.6, 0.9)</only>
            </li>
            <li>
              <only>(0.6, 0.4, 0.9)</only>
            </li>
            <li>
              <only>(0.45, 0.2, 0.75)</only>
            </li>
            <li>
              <only>(0.3, 0.0, 0.6)</only>
            </li>
            <li>
              <only>(0.24, 0.2, 0.7)</only>
            </li>
          </options>
        </colorGenerator>
      </li>
    </specificApparelRequirements>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <apparelMoney>0</apparelMoney>
    <backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
    <techHediffsChance>0.25</techHediffsChance>
    <techHediffsMoney>800~1200</techHediffsMoney>
    <techHediffsTags>
      <li>Simple</li>
      <li>Advanced</li>
      <li>ImplantEmpireCommon</li>
    </techHediffsTags>
    <techHediffsDisallowTags>
      <li>PainCauser</li>
    </techHediffsDisallowTags>
    <initialResistanceRange>13~21</initialResistanceRange>
  </PawnKindDef>

  <IncidentDef>
    <defName>XylCultistJoin</defName>
    <label>cultist joins</label>
    <category>Special</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>XylXenos.IncidentWorker_CultistJoin</workerClass>
    <letterLabel>The song calls</letterLabel>
    <letterText>A [PAWN_title] named [PAWN_nameDef] has heard the song and is joining the colony.</letterText>
    <baseChance>0</baseChance>
    <pawnKind>Drifter</pawnKind>
  </IncidentDef>

  <HediffDef>
    <defName>XylCultistSong</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>the song</label>
    <description>This character has heard the song and opened their mind to the cosmos. They know the truths that will never reach the ears of those who do not listen.</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <scenarioCanAdd>true</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_RemoveIfOtherHediff">
        <hediffs>
          <li>BrainwipeComa</li>
        </hediffs>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <PsychicSensitivity>0.2</PsychicSensitivity>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
