<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneCategoryDef>
    <defName>XylBody</defName>
    <label>body size and shape</label>
    <displayPriorityInXenotype>271</displayPriorityInXenotype>
  </GeneCategoryDef>

  <GeneDef>
    <defName>XylDwarf</defName>
    <label>dwarf</label>
    <description>Carriers of this gene have smaller bodies with proportionately larger heads. Their short legs somewhat reduce their movement speed.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <displayCategory>XylBody</displayCategory>
    <displayOrderInCategory>0</displayOrderInCategory>
    <!--<iconPath>Xyl/UI/Icons/Genes/Gene_Giant</iconPath>-->
    <exclusionTags>
      <li>BodySize</li>
    </exclusionTags>
    <statOffsets>
      <MoveSpeed>-0.1</MoveSpeed>
    </statOffsets>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <renderNodeModifiers>
          <li>
            <onlyRoot>true</onlyRoot>
            <scale>0.85</scale>
          </li>
          <li>
            <renderNodeClass>PawnRenderNodeWorker_Head</renderNodeClass>
            <scale>1.177</scale>
          </li>
        </renderNodeModifiers>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylGiant</defName>
    <label>giant</label>
    <description>Carriers of this gene are exceptionally large. They can take more damage, carry more, and are more resistant to drugs and toxins, but are also easier to hit with ranged weapons.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-2</biostatMet>
    <displayCategory>XylBody</displayCategory>
    <displayOrderInCategory>1</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Giant</iconPath>
    <exclusionTags>
      <li>BodySize</li>
    </exclusionTags>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <bodySizeFactor>1.5</bodySizeFactor>
        <healthScaleFactor>1.3</healthScaleFactor>
        <renderNodeModifiers>
          <li>
            <onlyRoot>true</onlyRoot>
            <scale>1.2</scale>
          </li>
          <li>
            <renderNodeClass>PawnRenderNodeWorker_Head</renderNodeClass>
            <scale>0.9</scale>
            <offset>0,0,-0.05</offset>
          </li>
        </renderNodeModifiers>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylScaleskin</defName>
    <label>scaleskin</label>
    <labelShortAdj>scaly</labelShortAdj>
    <description>Carriers of this gene grow tough but flexible scales all over their body that can deflect or absorb attacks.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-3</biostatMet>
    <displayCategory>XylBody</displayCategory>
    <displayOrderInCategory>450</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Scaleskin</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <forcedHeadTypes>
      <li>Female_Scaleskin_Average_Normal</li>
      <li>Female_Scaleskin_Average_Pointy</li>
      <li>Female_Scaleskin_Narrow_Normal</li>
      <li>Female_Scaleskin_Narrow_Pointy</li>
      <li>Male_Scaleskin_Average_Normal</li>
      <li>Male_Scaleskin_Average_Pointy</li>
      <li>Male_Scaleskin_Narrow_Normal</li>
      <li>Male_Scaleskin_Narrow_Pointy</li>
    </forcedHeadTypes>
    <exclusionTags>
      <li>Fur</li>
    </exclusionTags>
    <statOffsets>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
    </statOffsets>
    <fur>Scaleskin</fur>
    <renderNodeProperties>
      <li>
        <debugLabel>Scaleskin</debugLabel>
        <nodeClass>XylXenos.PawnRenderNode_NotFur</nodeClass>
        <workerClass>PawnRenderNodeWorker_Fur</workerClass>
        <baseLayer>1</baseLayer>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <colorType>Skin</colorType>
        <useSkinShader>true</useSkinShader>
        <parentTagDef>Body</parentTagDef>
      </li>
    </renderNodeProperties>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
      </li>
    </modExtensions>
  </GeneDef>
  <FurDef>
    <defName>Scaleskin</defName>
    <noGraphic>true</noGraphic>
    <bodyTypeGraphicPaths>
      <Male>Xyl/Things/Pawn/Humanlike/Bodies/Scaleskin_Male</Male>
      <Female>Xyl/Things/Pawn/Humanlike/Bodies/Scaleskin_Female</Female>
      <Hulk>Xyl/Things/Pawn/Humanlike/Bodies/Scaleskin_Hulk</Hulk>
      <Fat>Xyl/Things/Pawn/Humanlike/Bodies/Scaleskin_Fat</Fat>
      <Thin>Xyl/Things/Pawn/Humanlike/Bodies/Scaleskin_Thin</Thin>
      <Child>Xyl/Things/Pawn/Humanlike/Bodies/Scaleskin_Child</Child>
      <Baby>Xyl/Things/Pawn/Humanlike/Bodies/Scaleskin_Child</Baby>
      <!-- Always covered by swaddled graphic -->
    </bodyTypeGraphicPaths>
  </FurDef>

  <GeneDef>
    <defName>XylMineralizedSkin</defName>
    <label>rockskin</label>
    <labelShortAdj>rock</labelShortAdj>
    <description>Carriers of this gene have extremely tough skin studded with rock-like plates that can deflect or absorb attacks.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-4</biostatMet>
    <displayCategory>XylBody</displayCategory>
    <displayOrderInCategory>460</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_MineralizedSkin</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <forcedHeadTypes>
      <li>Female_Osteoliths_Average_Normal</li>
      <li>Female_Osteoliths_Average_Wide</li>
      <li>Female_Osteoliths_Narrow_Wide</li>
      <li>Male_Osteoliths_Average_Normal</li>
      <li>Male_Osteoliths_Average_Wide</li>
      <li>Male_Osteoliths_Narrow_Wide</li>
    </forcedHeadTypes>
    <exclusionTags>
      <li>Fur</li>
    </exclusionTags>
    <statOffsets>
      <ArmorRating_Sharp>0.7</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Heat>0.5</ArmorRating_Heat>
      <MoveSpeed>-0.4</MoveSpeed>
    </statOffsets>
    <fur>Osteoliths</fur>
    <renderNodeProperties>
      <li>
        <debugLabel>Osteoliths</debugLabel>
        <nodeClass>XylXenos.PawnRenderNode_NotFur</nodeClass>
        <workerClass>PawnRenderNodeWorker_Fur</workerClass>
        <baseLayer>1</baseLayer>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <colorType>Skin</colorType>
        <useSkinShader>true</useSkinShader>
        <parentTagDef>Body</parentTagDef>
      </li>
    </renderNodeProperties>
    <missingGeneRomanceChanceFactor>0.2</missingGeneRomanceChanceFactor>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
      </li>
    </modExtensions>
  </GeneDef>
  <FurDef>
    <defName>Osteoliths</defName>
    <noGraphic>true</noGraphic>
    <bodyTypeGraphicPaths>
      <Male>Xyl/Things/Pawn/Humanlike/Bodies/Osteoliths_Male</Male>
      <Female>Xyl/Things/Pawn/Humanlike/Bodies/Osteoliths_Female</Female>
      <Hulk>Xyl/Things/Pawn/Humanlike/Bodies/Osteoliths_Hulk</Hulk>
      <Fat>Xyl/Things/Pawn/Humanlike/Bodies/Osteoliths_Fat</Fat>
      <Thin>Xyl/Things/Pawn/Humanlike/Bodies/Osteoliths_Thin</Thin>
      <Child>Xyl/Things/Pawn/Humanlike/Bodies/Osteoliths_Child</Child>
      <Baby>Xyl/Things/Pawn/Humanlike/Bodies/Osteoliths_Child</Baby>
      <!-- Always covered by swaddled graphic -->
    </bodyTypeGraphicPaths>
  </FurDef>

</Defs>
