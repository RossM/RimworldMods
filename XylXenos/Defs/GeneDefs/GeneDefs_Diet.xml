<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneCategoryDef>
    <defName>XylDiet</defName>
    <label>diet</label>
    <displayPriorityInXenotype>275</displayPriorityInXenotype>
  </GeneCategoryDef>

  <GeneDef>
    <defName>XylCarnivoreStomach</defName>
    <label>carnivore stomach</label>
    <labelShortAdj>carnivorous</labelShortAdj>
    <description>Carriers of this gene have specialized stomachs that can extract more nutrition from raw meat, but are poor at digesting plant-based foods. They never get negative thoughts from eating meat.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <displayCategory>XylDiet</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_CarnivoreStomach</iconPath>
    <exclusionTags>
      <li>Digestion</li>
    </exclusionTags>
    <statFactors>
      <XylRawMeatNutritionFactor>1.8</XylRawMeatNutritionFactor>
      <XylRawVegetableNutritionFactor>0.5</XylRawVegetableNutritionFactor>
      <XylCookedVegetableNutritionFactor>0.8</XylCookedVegetableNutritionFactor>
      <XylRawMeatFoodPoisonChanceFactor>0</XylRawMeatFoodPoisonChanceFactor>
    </statFactors>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="XylXenos.GeneCompProperties_IngestionThoughtOverrides">
            <overrides>
              <li>
                <allowedFoodTypes>
                  <li>Meat</li>
                </allowedFoodTypes>
                <thoughts>
                  <li>AteRawFood</li>
                </thoughts>
              </li>
            </overrides>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylHerbivoreStomach</defName>
    <label>herbivore stomach</label>
    <labelShortAdj>herbivorous</labelShortAdj>
    <description>Carriers of this gene have specialized stomachs that can extract more nutrition from raw plant-based foods, but are poor at digesting meat. They never get negative thoughts from eating plant-based foods.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <displayCategory>XylDiet</displayCategory>
    <displayOrderInCategory>101</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_HerbivoreStomach</iconPath>
    <exclusionTags>
      <li>Digestion</li>
    </exclusionTags>
    <statFactors>
      <XylRawVegetableNutritionFactor>1.8</XylRawVegetableNutritionFactor>
      <XylRawMeatNutritionFactor>0.5</XylRawMeatNutritionFactor>
      <XylCookedMeatNutritionFactor>0.8</XylCookedMeatNutritionFactor>
      <XylRawVegetableFoodPoisonChanceFactor>0</XylRawVegetableFoodPoisonChanceFactor>
    </statFactors>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="XylXenos.GeneCompProperties_IngestionThoughtOverrides">
            <overrides>
              <li>
                <allowedFoodTypes>
                  <li>Vegetable</li>
                </allowedFoodTypes>
                <thoughts>
                  <li>AteRawFood</li>
                </thoughts>
              </li>
            </overrides>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylFungusEater</defName>
    <label>fungus eater</label>
    <labelShortAdj>fungus-eating</labelShortAdj>
    <description>Carriers of this gene have special digestive enzymes that extract more nutrition from raw fungus - but they don't do anything about the taste.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>XylDiet</displayCategory>
    <displayOrderInCategory>102</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_MushroomEater</iconPath>
    <exclusionTags>
      <li>Digestion</li>
    </exclusionTags>
    <statFactors>
      <XylRawFungusNutritionFactor>1.8</XylRawFungusNutritionFactor>
    </statFactors>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="Xylib.GeneCompProperties_UnlockBuildables">
            <buildables>
              <li MayRequire="Ludeon.RimWorld.Ideology">FungalGravel</li>
            </buildables>
          </li>
          <li Class="Xylib.GeneCompProperties_UnlockRecipes">
            <recipes>
              <li>XylMake_Wort_Fungus</li>
            </recipes>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylMeatDependence</defName>
    <label>meat dependence</label>
    <labelShortAdj>meat-dependent</labelShortAdj>
    <description>Carriers of this gene are unable to synthesize certain essential nutrients and must obtain them by eating raw meat. Without it, their health and mood will steadily decline, leading to pain, muscle weakness, mental instability, coma, and eventually death.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>3</biostatMet>
    <displayCategory>XylDiet</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_MeatDependence</iconPath>
    <minAgeActive>13</minAgeActive>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="Xylib.GeneCompProperties_PermanentHediffs">
            <hediffs>
              <li>
                <hediff>XylGeneticMeatNeed</hediff>
              </li>
            </hediffs>
          </li>
          <li Class="Xylib.GeneCompProperties_StartingItems">
            <items>
              <li>
                <foodType>Meat</foodType>
                <nutritionAmount>1~2</nutritionAmount>
              </li>
            </items>
          </li>
          <li Class="XylXenos.GeneCompProperties_IngestionThoughtOverrides">
            <overrides>
              <li>
                <allowedFoodTypes>
                  <li>Meat</li>
                </allowedFoodTypes>
                <disallowedFoodTypes>
                  <li>Humanlike</li>
                  <li>Insect</li>
                </disallowedFoodTypes>
                <thoughts>
                  <li>AteRawFood</li>
                </thoughts>
              </li>
            </overrides>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylGeneticMeatNeed</defName>
    <label>raw meat dependency</label>
    <description>This individual is unable to synthesize certain essential nutrients and must obtain them by eating raw meat. Without it, their health and mood will steadily decline, leading to pain, muscle weakness, mental instability, coma, and eventually death.</description>
    <hediffClass>XylXenos.Hediff_DietDependency</hediffClass>
    <descriptionHyperlinks>
      <GeneDef>XylMeatDependence</GeneDef>
    </descriptionHyperlinks>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0</initialSeverity>
    <maxSeverity>15</maxSeverity>
    <lethalSeverity>15</lethalSeverity>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0.5</severityPerDay>
        <minAge>13</minAge>
      </li>
      <li Class="Xylib.HediffCompProperties_Genetic">
        <gene>XylMeatDependence</gene>
      </li>
    </comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.001</minSeverity>
        <becomeVisible>true</becomeVisible>
      </li>
      <li>
        <label>craving</label>
        <minSeverity>1</minSeverity>
      </li>
      <li>
        <label>mild deficiency</label>
        <minSeverity>2.5</minSeverity>
        <painOffset>0.1</painOffset>
        <mentalStateGivers>
          <li>
            <mentalState>XylHuntingVermin</mentalState>
            <mtbDays>0.5</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <label>severe deficiency</label>
        <minSeverity>5</minSeverity>
        <painOffset>0.5</painOffset>
        <mentalBreakMtbDays>1.0</mentalBreakMtbDays>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>XylHuntingVermin</mentalState>
            <mtbDays>0.5</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <label>coma</label>
        <minSeverity>7.5</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.5</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Hediff_DietDependency">
        <foodLabel>raw meat</foodLabel>
        <foods>
          <li>Meat</li>
        </foods>
        <rawOnly>true</rawOnly>
        <!-- 
        This requires that the warcat eat 0.5 nutrition per day in raw meat out of a total
        nutrition requirement of 1.44, or 35% of their diet.
        -->
        <severityReductionPerNutrition>1.0</severityReductionPerNutrition>
      </li>
    </modExtensions>
  </HediffDef>

  <MentalBreakDef>
    <defName>XylHuntingVermin</defName>
    <mentalState>XylHuntingVermin</mentalState>
    <intensity>Minor</intensity>
    <baseCommonality>1</baseCommonality>
    <requiredGene>XylMeatDependence</requiredGene>
  </MentalBreakDef>
  
  <MentalStateDef ParentName="BaseMentalState">
    <defName>XylHuntingVermin</defName>
    <stateClass>XylXenos.MentalState_HuntingVermin</stateClass>
    <workerClass>XylXenos.MentalStateWorker_HuntingVermin</workerClass>
    <label>hunting vermin</label>
    <category>Aggro</category>
    <blockInteractionInitiationExcept>
      <li>Insult</li>
    </blockInteractionInitiationExcept>
    <blockInteractionRecipientExcept>
      <li>Insult</li>
    </blockInteractionRecipientExcept>
    <blockRandomInteraction>true</blockRandomInteraction>
    <colonistsOnly>true</colonistsOnly>
    <minTicksBeforeRecovery>15000</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>15000</maxTicksBeforeRecovery>
    <recoverFromSleep>true</recoverFromSleep>
    <nameColor>(0.9,0.2,0.5)</nameColor>
    <recoveryMessage>{0} is no longer hunting.</recoveryMessage>
    <beginLetter>{0} has decided to kill and eat {1}.</beginLetter>
    <beginLetterDef>ThreatSmall</beginLetterDef>
    <baseInspectLine>Mental state: Hunting vermin</baseInspectLine>
    <allowBeatfire>true</allowBeatfire>
  </MentalStateDef>

</Defs>
