<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef>
    <geneClass>XylXenos.Genes.AddHediff</geneClass>
    <defName>XylPrecognition</defName>
    <label>precognition</label>
    <description>Carriers of this gene can see a short distance into the future, giving the ability to dodge both melee and ranged attacks. The effect scales with psychic sensitivity.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <displayCategory>Violence</displayCategory>
    <displayOrderInCategory>120</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Precognition</iconPath>
    <modExtensions>
      <li Class="XylXenos.Genes.GeneDefExtension_Hediff">
        <hediffGivers>
          <li Class="HediffGiver_Event">
            <hediff>XylPrecognition</hediff>
            <partsToAffect>
              <li>Head</li>
            </partsToAffect>
          </li>
        </hediffGivers>
        <applyImmediately>true</applyImmediately>
        <reapplyOnPartRestored>true</reapplyOnPartRestored>
      </li>
    </modExtensions>
    <customEffectDescriptions>
      <li>Melee dodge chance: +15</li>
      <li>Ranged dodge chance: +15</li>
    </customEffectDescriptions>
  </GeneDef>

  <GeneDef>
    <geneClass>XylXenos.Genes.Flight</geneClass>
    <defName>XylBatWings</defName>
    <label>bat wings</label>
    <description>Carriers of this gene have bat-like wings, allowing them to fly for short periods. Wearing some heavy torso-covering items will prevent flight.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-3</biostatMet>
    <displayCategory>Movement</displayCategory>
    <displayOrderInCategory>510</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_BatWings</iconPath>
    <renderNodeProperties>
      <li>
        <nodeClass>XylXenos.PawnRenderNode_Wings</nodeClass>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPaths>
          <li>Xyl/Things/Pawn/Humanlike/BodyAttachments/BatWings/BatWings</li>
          <li>Xyl/Things/Pawn/Humanlike/BodyAttachments/BatWings/BatWingsExtended</li>
        </texPaths>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <colorType>Hair</colorType>
        <parentTagDef>Body</parentTagDef>
        <drawData>
          <defaultData>
            <layer>10</layer>
            <offset>(0,0,-0.1)</offset>
          </defaultData>
          <dataNorth>
            <layer>80</layer>
            <offset>(0,0,-0.1)</offset>
          </dataNorth>
          <dataSouth>
            <layer>-10</layer>
            <offset>(0,0,-0.1)</offset>
          </dataSouth>
        </drawData>
      </li>
    </renderNodeProperties>
    <capMods>
      <li>
        <capacity>Manipulation</capacity>
        <offset>-0.1</offset>
      </li>
    </capMods>
    <statOffsets>
      <MaxFlightTime>8</MaxFlightTime>
      <FlightCooldown>45</FlightCooldown>
    </statOffsets>
    <modExtensions>
      <li Class="XylXenos.Genes.GeneDefExtension_Flight">
        <iconPath>Xyl/UI/Icons/Genes/Gene_BatWings</iconPath>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <geneClass>XylXenos.Genes.Torpor</geneClass>
    <defName>XylTorpor</defName>
    <label>torpor</label>
    <description>The body of a carrier of this gene automatically goes into hibernation in cold temperatures. This will impair their capabilities and eventually cause unconsciousness. It also reduces food consumption and slows the progression of hypothermia and starvation.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <displayCategory>Temperature</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <!--<iconPath>Xyl/UI/Icons/Abilities/SonicWave</iconPath>-->
    <modExtensions>
      <li Class="XylXenos.Genes.GeneDefExtension_Torpor">
        <hediff>XylTorpor</hediff>
        <temperatureThreshold>11</temperatureThreshold>
        <comfyTemperatureImportance>0.3</comfyTemperatureImportance>
        <severityGainPerDayPerDegree>0.02</severityGainPerDayPerDegree>
        <severityLossPerDayPerDegree>0.02</severityLossPerDayPerDegree>
      </li>
    </modExtensions>  
  </GeneDef>

</Defs>