<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneDef Name="XylGenderRatioBase" Abstract="True">
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>Reproduction</displayCategory>
    <selectionWeight>0</selectionWeight>
    <exclusionTags>
      <li>Gender</li>
    </exclusionTags>
  </GeneDef>

  <GeneDef ParentName="XylGenderRatioBase">
    <defName>XylGender_AlwaysFemale</defName>
    <label>always female</label>
    <description>Carriers of this gene are always female.\n\nThis gene has no effect unless it is a germline gene.</description>
    <displayOrderInCategory>300</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_AlwaysFemale</iconPath>
    <symbolPack>
      <prefixSymbols>
        <li>
          <symbol>gyno</symbol>
        </li>
        <li>
          <symbol>fem</symbol>
        </li>
      </prefixSymbols>
      <suffixSymbols>
        <li>
          <symbol>woman</symbol>
        </li>
      </suffixSymbols>
    </symbolPack>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <geneType>Endogene</geneType>
        <comps>
          <li Class="XylXenos.GeneCompProperties_GenderRatio">
            <femaleChance>1.0</femaleChance>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>
  
  <GeneDef ParentName="XylGenderRatioBase">
    <defName>XylGender_UsuallyFemale</defName>
    <label>usually female</label>
    <description>Carriers of this gene are mostly female.\n\nThis gene has no effect unless it is a germline gene.</description>
    <displayOrderInCategory>301</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_UsuallyFemale</iconPath>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <geneType>Endogene</geneType>
        <comps>
          <li Class="XylXenos.GeneCompProperties_GenderRatio">
            <femaleChance>0.75</femaleChance>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>
  
  <GeneDef ParentName="XylGenderRatioBase">
    <defName>XylGender_UsuallyMale</defName>
    <label>usually male</label>
    <description>Carriers of this gene are mostly male.\n\nThis gene has no effect unless it is a germline gene.</description>
    <displayOrderInCategory>302</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_UsuallyMale</iconPath>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <geneType>Endogene</geneType>
        <comps>
          <li Class="XylXenos.GeneCompProperties_GenderRatio">
            <femaleChance>0.25</femaleChance>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>
  
  <GeneDef ParentName="XylGenderRatioBase">
    <defName>XylGender_AlwaysMale</defName>
    <label>always male</label>
    <description>Carriers of this gene are always male.\n\nThis gene has no effect unless it is a germline gene.</description>
    <displayOrderInCategory>303</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_AlwaysMale</iconPath>
    <symbolPack>
      <prefixSymbols>
        <li>
          <symbol>andro</symbol>
        </li>
        <li>
          <symbol>man</symbol>
        </li>
      </prefixSymbols>
      <suffixSymbols>
        <li>
          <symbol>man</symbol>
        </li>
      </suffixSymbols>
    </symbolPack>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <geneType>Endogene</geneType>
        <comps>
          <li Class="XylXenos.GeneCompProperties_GenderRatio">
            <femaleChance>0.0</femaleChance>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylStrongGenes</defName>
    <label>strong genes</label>
    <description>When a carrier of this gene has a baby with a parent of a different xenotype, the baby will have an exact copy of the carrier's endogenes unless the other parent also has this gene.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>Reproduction</displayCategory>
    <displayOrderInCategory>400</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/NoArt</iconPath>
    <exclusionTags>
      <li>XenotypeStrength</li>
    </exclusionTags>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="XylXenos.GeneCompProperties_XenotypeStrength">
            <strength>1</strength>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylWeakGenes</defName>
    <label>weak genes</label>
    <description>When a carrier of this gene has a baby with a parent of a different xenotype, the baby will have an exact copy of the other parent's endogenes unless the other parent also has this gene.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>Reproduction</displayCategory>
    <displayOrderInCategory>401</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/NoArt</iconPath>
    <exclusionTags>
      <li>XenotypeStrength</li>
    </exclusionTags>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="XylXenos.GeneCompProperties_XenotypeStrength">
            <strength>-1</strength>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylParthenogenic</defName>
    <label>parthenogenic</label>
    <description>Female carriers of this gene can become spontaneously pregnant without a father.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayCategory>Reproduction</displayCategory>
    <displayOrderInCategory>410</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/NoArt</iconPath>
    <minAgeActive>16</minAgeActive>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <gender>Female</gender>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <mtbDays>120</mtbDays>
            <hediff>PregnantHuman</hediff>
          </li>
        </hediffGivers>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylLoveEuphoria</defName>
    <label>love euphoria</label>
    <description>Carriers of this gene secrete chemicals that cause a euphoric, drug-like high in their partner after lovin'. The chemicals grant a long-lasting mood bonus, but are highly addictive.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayCategory>Reproduction</displayCategory>
    <displayOrderInCategory>500</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/NoArt</iconPath>
    <minAgeActive>16</minAgeActive>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="XylXenos.GeneCompProperties_LoveEuphoria">
            <need>XylLovin</need>
            <hediffs>
              <li>XylLoveEuphoria</li>
              <li>XylLovinAddiction</li>
            </hediffs>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <NeedDef>
    <defName>XylLovin</defName>
    <needClass>XylXenos.Need_Lovin</needClass>
    <label>lovin'</label>
    <description>Because of a lovin' addiction, this person needs to regularly make physical love with a carrier of the love euphoria gene to avoid withdrawal symptoms.</description>
    <listPriority>50</listPriority>
    <minIntelligence>Humanlike</minIntelligence>
    <fallPerDay>0.33</fallPerDay>
    <onlyIfCausedByHediff>true</onlyIfCausedByHediff>
  </NeedDef>

  <HediffDef>
    <defName>XylLoveEuphoria</defName>
    <hediffClass>XylXenos.HediffWithCompsExt</hediffClass>
    <label>love euphoria</label>
    <description>This character is experiencing elevated mood due to lovin' with a carrier of the love euphoria gene.</description>
    <overrideTooltip>{PAWN_nameIndef} is experiencing elevated mood due to lovin' with {SOURCE_nameIndef}.</overrideTooltip>
    <descriptionHyperlinks>
      <GeneDef>XylLoveEuphoria</GeneDef>
    </descriptionHyperlinks>
    <defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="XylXenos.HediffCompProperties_RandomInspiration">
        <mtbDays>10</mtbDays>
        <letter>Thanks to love euphoria from {SOURCE_nameIndef}, {PAWN_nameIndef} has experienced an inspiration!</letter>
      </li>
    </comps>
    <stages>
      <li/>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>XylLoveEuphoria</defName>
    <workerClass>XylXenos.ThoughtWorker_WithSource</workerClass>
    <hediff>XylLoveEuphoria</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>love euphoria</label>
        <description>I can't get enough of {SOURCE_nameIndef}!</description>
        <baseMoodEffect>14</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <HediffDef>
    <defName>XylLovinAddiction</defName>
    <hediffClass>XylXenos.Hediff_LovinAddiction</hediffClass>
    <label>lovin' addiction</label>
    <description>This character has developed a neurochemical need for physical love with a carrier of the love euphoria gene.</description>
    <overrideTooltip>{PAWN_nameIndef} has developed a neurochemical need for physical love with {SOURCE_nameIndef} or another carrier of the love euphoria gene.</overrideTooltip>
    <descriptionHyperlinks>
      <GeneDef>XylLoveEuphoria</GeneDef>
    </descriptionHyperlinks>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <chemicalNeed>XylLovin</chemicalNeed>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.0333</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
      <li Class="HediffCompProperties_GiveLovinMTBFactor">
        <lovinMTBFactor>0.5</lovinMTBFactor>
      </li>
    </comps>
    <stages>
      <li>
        <!-- Dummy value just to shut up a config error -->
        <minSeverity>-1</minSeverity>
      </li>
      <li>
        <label>withdrawal</label>
        <statOffsets>
          <RestFallRateFactor>0.4</RestFallRateFactor>
          <WorkSpeedGlobal>-0.2</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>XylLovinWithdrawal</defName>
    <workerClass>XylXenos.ThoughtWorker_WithSource</workerClass>
    <hediff>XylLovinAddiction</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <stages>
      <li IsNull="True" />
      <li>
        <label>lovin' withdrawal ({SOURCE_nameDef})</label>
        <description>I can't forget the feel of {SOURCE_possessive} touch...</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <GeneDef>
    <defName>XylYouthful</defName>
    <label>youthful</label>
    <description>Carriers of this gene stop aging externally at the age of 18, and retain a youthful appearance well into old age. This gene doesn't protect against age-related health issues, nor does it make a character live longer.</description>
    <biostatCpx>1</biostatCpx>
    <displayCategory>Reproduction</displayCategory>
    <displayOrderInCategory>501</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/NoArt</iconPath>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="XylXenos.GeneCompProperties_Youthful">
            <maxAge>18</maxAge>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

</Defs>
