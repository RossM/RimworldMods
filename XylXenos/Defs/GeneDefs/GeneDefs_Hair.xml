  <GeneDef ParentName="GeneHairStyleBase">
    <defName>XylHair_BaldOnly_Male</defName>
    <label>bald males</label>
    <labelShortAdj>male bald</labelShortAdj>
    <description>Male carriers of this gene grow no hair on the head.</description>
    <iconPath>Xyl/UI/Icons/Genes/NoArt</iconPath>
    <displayOrderInCategory>57.4</displayOrderInCategory>
    <hairTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>Bald</li>
      </tags>
    </hairTagFilter>
    <exclusionTags Inherit="false">
      <li>HairStyleMale</li>
    </exclusionTags>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <gender>Male</gender>
      </li>
    </modExtensions>
  </GeneDef>

