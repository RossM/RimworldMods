<Defs>

  <GeneDef ParentName="GeneHairStyleBase">
    <defName>XylHair_BaldOnly_Male</defName>
    <label>bald males</label>
    <labelShortAdj>male bald</labelShortAdj>
    <description>Male carriers of this gene grow no hair on the head.</description>
    <iconPath>UI/Icons/Genes/Gene_HairStyleBaldOnly</iconPath>
    <displayOrderInCategory>150</displayOrderInCategory>
    <hairTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>Bald</li>
      </tags>
    </hairTagFilter>
    <modExtensions>
      <li Class="XylXenos.Genes.GeneDefExtension_GenderLocked">
        <activeGender>Male</activeGender>
      </li>
    </modExtensions>
  </GeneDef>

