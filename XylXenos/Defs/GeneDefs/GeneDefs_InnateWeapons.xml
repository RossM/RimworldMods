<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneDef>
    <defName>XylLargeHorns</defName>
    <label>large horns</label>
    <description>Carriers of this gene have large horns that function as a weapon.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayCategory>Violence</displayCategory>
    <displayOrderInCategory>110</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_LargeHorns</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <exclusionTags>
      <li>Headbone</li>
    </exclusionTags>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Xyl/Things/Pawn/Humanlike/HeadAttachments/LargeHorns/LargeHorns</texPath>
        <color>(255, 255, 255)</color>
        <parentTagDef>Head</parentTagDef>
        <drawData>
          <defaultData>
            <layer>80</layer>
          </defaultData>
          <dataNorth>
            <layer>10</layer>
          </dataNorth>
        </drawData>
      </li>
    </renderNodeProperties>
    <exclusionTags>
      <li>Headbone</li>
    </exclusionTags>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <permanentHediffs>
          <li>
            <hediff>XylLargeHorns</hediff>
            <partsToAffect>
              <li>Head</li>
            </partsToAffect>
          </li>
        </permanentHediffs>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylLargeHorns</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>large horns</label>
    <description>Large, dangerous horns that can be used as a weapon.</description>
    <descriptionHyperlinks>
      <GeneDef>XylLargeHorns</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>1.0</initialSeverity>
    <addedPartProps>
      <solid>true</solid>
    </addedPartProps>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>horns</label>
            <capacities>
              <li>Stab</li>
            </capacities>
            <power>22</power>
            <cooldownTime>3.0</cooldownTime>
            <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
          </li>
        </tools>
      </li>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylLargeHorns</gene>
      </li>
    </comps>
  </HediffDef>

  <GeneDef>
    <defName>XylRetractableClaws</defName>
    <label>retractable claws</label>
    <labelShortAdj>claws</labelShortAdj>
    <description>Carriers of this gene have retractable claws that function as weapons.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayCategory>Violence</displayCategory>
    <displayOrderInCategory>111</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_RetractableClaws</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <exclusionTags>
      <li>Hands</li>
    </exclusionTags>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <permanentHediffs>
          <li>
            <hediff>XylRetractableClaws</hediff>
            <partsToAffect>
              <li>Hand</li>
            </partsToAffect>
            <countToAffect>2</countToAffect>
          </li>
        </permanentHediffs>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylRetractableClaws</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>retractable claws</label>
    <description>Retractable claws. They can perform rapid slashing attacks, but are poor at penetrating armor.</description>
    <descriptionHyperlinks>
      <GeneDef>XylRetractableClaws</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>1.0</initialSeverity>
    <addedPartProps>
      <solid>true</solid>
    </addedPartProps>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>claws</label>
            <capacities>
              <li>Scratch</li>
            </capacities>
            <power>8.5</power>
            <armorPenetration>0.0</armorPenetration>
            <cooldownTime>1.2</cooldownTime>
            <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
          </li>
        </tools>
      </li>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylRetractableClaws</gene>
      </li>
    </comps>
  </HediffDef>

</Defs>
