<?xml version="1.0" encoding="utf-8" ?>

<Defs>

  <GeneDef>
    <geneClass>XylXenos.Genes.AddHediff</geneClass>
    <defName>XylEcholocation</defName>
    <label>echolocation</label>
    <description>Carriers of this gene can use high-frequency sound waves to "see" with their ears instead of their eyes.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>73</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Echolocation</iconPath>
    <modExtensions>
      <li Class="XylXenos.Genes.GeneDefExtension_Hediff">
        <hediffGivers>
          <li Class="HediffGiver_Event">
            <hediff>XylEcholocation</hediff>
            <partsToAffect>
              <li>Head</li>
            </partsToAffect>
          </li>
        </hediffGivers>
        <applyImmediately>true</applyImmediately>
        <reapplyOnPartRestored>true</reapplyOnPartRestored>
      </li>
      <li Class="XylXenos.DefModExtension_StartingItemSource">
        <item MayRequire="Ludeon.RimWorld.Ideology">Apparel_Blindfold</item>
        <chance>0.5</chance>
      </li>
      <li Class="XylXenos.Genes.GeneDefExtension_CongenitalHediff">
        <hediffGivers>
          <li Class="HediffGiver_Event">
            <hediff>Blindness</hediff>
            <partsToAffect>
              <li>Eye</li>
            </partsToAffect>
            <countToAffect>2</countToAffect>
          </li>
        </hediffGivers>
        <chance>0.15</chance>
      </li>
    </modExtensions>
    <customEffectDescriptions>
      <li>Sight: use hearing if higher</li>
    </customEffectDescriptions>
  </GeneDef>

  <GeneDef>
    <defName>XylKeenEars</defName>
    <label>keen ears</label>
    <description>Carriers of this gene have improved hearing.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>72</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_KeenEars</iconPath>
    <capMods>
      <li>
        <capacity>Hearing</capacity>
        <offset>0.2</offset>
      </li>
    </capMods>
  </GeneDef>

</Defs>