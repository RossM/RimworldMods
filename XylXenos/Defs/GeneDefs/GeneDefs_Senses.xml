<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneCategoryDef>
    <defName>XylSenses</defName>
    <label>senses</label>
    <displayPriorityInXenotype>380</displayPriorityInXenotype>
  </GeneCategoryDef>

  <GeneDef>
    <defName>XylEcholocation</defName>
    <label>echolocation</label>
    <description>Carriers of this gene can use high-frequency sound waves to "see" with their ears instead of their eyes.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <displayCategory>XylSenses</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Echolocation</iconPath>
    <customEffectDescriptions>
      <li>Sight: use hearing if higher</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="Xylib.DefModExtension_Gene">
        <extraApparel>
          <li>
            <item MayRequire="Ludeon.RimWorld.Ideology">Apparel_Blindfold</item>
            <chance>0.2</chance>
            <ignoreRestrictions>true</ignoreRestrictions>
          </li>
        </extraApparel>
        <comps>
          <li Class="Xylib.GeneCompProperties_PermanentHediffs">
            <hediffs>
              <li>
                <hediff>XylEcholocation</hediff>
                <partsToAffect>
                  <li>Head</li>
                </partsToAffect>
              </li>
            </hediffs>
          </li>
          <li Class="Xylib.GeneCompProperties_CongenitalHediffs">
            <hediffs>
              <li>
                <chance>0.15</chance>
                <hediff>Blindness</hediff>
                <partsToAffect>
                  <li>Eye</li>
                </partsToAffect>
                <countToAffect>2</countToAffect>
              </li>
            </hediffs>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylEcholocation</defName>
    <hediffClass>XylXenos.Hediff_SubstituteCapacity</hediffClass>
    <label>echolocation</label>
    <description>This character has echolocation.</description>
    <descriptionHyperlinks>
      <GeneDef>XylEcholocation</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>1.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <comps>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylEcholocation</gene>
      </li>
    </comps>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Hediff_SubstituteCapacity">
        <originalCapacity>Sight</originalCapacity>
        <substituteCapacity>Hearing</substituteCapacity>
        <mode>Maximum</mode>
        <excludeStats>
          <li>ReadingSpeed</li>
        </excludeStats>
      </li>
    </modExtensions>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>XylKeenEars</defName>
    <label>keen ears</label>
    <description>Carriers of this gene have improved hearing.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayCategory>XylSenses</displayCategory>
    <displayOrderInCategory>210</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_KeenEars</iconPath>
    <capMods>
      <li>
        <capacity>Hearing</capacity>
        <postFactor>1.2</postFactor>
      </li>
    </capMods>
    <modExtensions>
      <li Class="Xylib.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

</Defs>
