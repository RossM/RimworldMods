<?xml version="1.0" encoding="utf-8" ?>

<Defs>

  <GeneDef>
    <defName>XylDrugSensitive</defName>
    <label>drug sensitive</label>
    <description>Carriers of this gene are easily affected by drugs. Effects from a single dose last longer, they gain tolerance faster, and they are more likely to become addicted.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_DrugSensitive</iconPath>
    <exclusionTags>
      <li>XylDrugSensitivity</li>
    </exclusionTags>
    <statOffsets>
      <XylDrugEffectMultiplier>0.4</XylDrugEffectMultiplier>
    </statOffsets>
    <statFactors>
      <XylGlobalAddictionChanceFactor>2.0</XylGlobalAddictionChanceFactor>
    </statFactors>
    <modExtensions>
      <li Class="XylXenos.Genes.GeneDefExtension_Chemicals">
        <showInDrugPolicies>true</showInDrugPolicies>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylDrugResistant</defName>
    <label>drug resistant</label>
    <description>Carriers of this gene are less affected by drugs. Effects from a single dose wear off faster, they gain tolerance slower, and they are less likely to become addicted.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <displayOrderInCategory>210</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_DrugResistant</iconPath>
    <exclusionTags>
      <li>XylDrugSensitivity</li>
    </exclusionTags>
    <statOffsets>
      <XylDrugEffectMultiplier>-0.5</XylDrugEffectMultiplier>
    </statOffsets>
    <statFactors>
      <XylGlobalAddictionChanceFactor>0.7</XylGlobalAddictionChanceFactor>
    </statFactors>
    <modExtensions>
      <li Class="XylXenos.Genes.GeneDefExtension_Chemicals">
        <showInDrugPolicies>true</showInDrugPolicies>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylLithoid</defName>
    <geneClass>XylXenos.Genes.ChemicalImmunity</geneClass>
    <label>lithoid</label>
    <description>Carriers of this gene have a unique biochemistry that incorporates carbon-silicates. They are completely unaffected by most drugs that work on normal humans, and instead must use specialized drugs designed for lithoids.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>1</biostatMet>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <displayOrderInCategory>250</displayOrderInCategory>
    <exclusionTags>
      <li>Addiction_Alcohol</li>
      <li>Addiction_GoJuice</li>
      <li>Addiction_Psychite</li>
      <li>Addiction_Smokeleaf</li>
      <li>Addiction_WakeUp</li>
    </exclusionTags>
    <!--<iconPath>Xyl/UI/Icons/Genes/Gene_EvenTemper</iconPath>-->
    <suppressedTraits>
      <li>
        <def>DrugDesire</def>
        <degree>2</degree>
      </li>
      <li>
        <def>DrugDesire</def>
        <degree>1</degree>
      </li>
    </suppressedTraits>
    <modExtensions>
      <li Class="XylXenos.Genes.GeneDefExtension_Chemicals">
        <showInDrugPolicies>true</showInDrugPolicies>
      </li>
      <li Class="XylXenos.DefModExtension_StartingItemSource">
        <item>XylAtlasite</item>
        <chance>0.02</chance>
        <count>2~5</count>
      </li>
    </modExtensions>
  </GeneDef>

</Defs>