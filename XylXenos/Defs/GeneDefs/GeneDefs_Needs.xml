<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneDef>
    <defName>XylAquatic</defName>
    <label>aquatic</label>
    <description>Carriers of this gene have a need to periodically soak in water, and will become unhappy if they stay dry for too long.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>3</biostatMet>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>10</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Aquatic</iconPath>
    <iconColor>(0.6, 0.6, 0.9)</iconColor>
    <statOffsets>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
    </statOffsets>
    <enablesNeeds>
      <li>XylWetness</li>
    </enablesNeeds>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <joyGiverChanceFactors>
          <GoSwimming MayRequire="Ludeon.RimWorld.Odyssey">5</GoSwimming>
        </joyGiverChanceFactors>
        <addDesignators>
          <li>XylShower</li>
        </addDesignators>
      </li>
    </modExtensions>
  </GeneDef>

  <NeedDef>
    <defName>XylWetness</defName>
    <needClass>XylXenos.Need_Wetness</needClass>
    <label>wetness</label>
    <description>This character needs to keep their skin moist by periodically soaking in water. This need can be met by standing in water, being outside in the rain, or using a shower.</description>
    <minIntelligence>Humanlike</minIntelligence>
    <seekerRisePerHour>0.1986</seekerRisePerHour>
    <seekerFallPerHour>0.0139</seekerFallPerHour>
    <onlyIfCausedByGene>true</onlyIfCausedByGene>
    <freezeWhileSleeping>false</freezeWhileSleeping>
    <freezeInMentalState>false</freezeInMentalState>
  </NeedDef>

  <ThoughtDef>
    <defName>XylNeedWetness</defName>
    <workerClass>XylXenos.ThoughtWorker_Need</workerClass>
    <stages>
      <li>
        <label>parched</label>
        <description>My skin is cracked and bleeding. Please! I need water!</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
      <li>
        <label>very dry skin</label>
        <description>My skin is dry and itchy. It's very unpleasant.</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
      <li>
        <label>dry skin</label>
        <description>My skin is a bit dry. I should find some water.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li IsNull="True" />
      <li>
        <label>soaking wet</label>
        <description>I'm soaking wet and I love it!</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="XylXenos.ThoughtDefExtension_Need">
        <need>XylWetness</need>
      </li>
    </modExtensions>
  </ThoughtDef>

  <GeneDef>
    <defName>XylJoyless</defName>
    <label>joyless</label>
    <description>Carriers of this gene are genetically incapable of feeling joy. They have no need for recreation, and get no mood bonuses or penalties from it. </description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <displayCategory>Mood</displayCategory>
    <displayOrderInCategory>1100</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Joyless</iconPath>
    <disablesNeeds>
      <li>Joy</li>
    </disablesNeeds>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

</Defs>
