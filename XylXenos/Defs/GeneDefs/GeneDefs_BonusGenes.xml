<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneCategoryDef>
    <defName>XylRandom</defName>
    <label>random</label>
    <displayPriorityInXenotype>210</displayPriorityInXenotype>
  </GeneCategoryDef>

  <GeneDef>
    <defName>XylGeneticAtavism</defName>
    <label>genetic atavism</label>
    <description>Carriers of this gene have an unstable genome that may have random extra genes.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>XylRandom</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_GeneticAtavism</iconPath>
    <customEffectDescriptions>
      <li>Extra gene chance: 50%</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="XylXenos.GeneCompProperties_BonusGenes">
            <geneChance>0.5</geneChance>
            <addedGeneType>Xenogene</addedGeneType>
            <maker Class="XylXenos.GeneSetMaker_Biostats">
              <biostatArc>0~0</biostatArc>
              <biostatCpx>1~99</biostatCpx>
              <biostatMet>-2~2</biostatMet>
            </maker>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef Name="XylSpecialistBase" Abstract="true">
    <displayCategory>XylRandom</displayCategory>
    <exclusionTags>
      <li>XylSpecialist</li>
    </exclusionTags>
  </GeneDef>

  <GeneDef ParentName="XylSpecialistBase">
    <defName>XylSpecialist</defName>
    <label>specialist</label>
    <description>The carrier's aptitude in one random skill is increased by 4. Aptitude acts like an offset on skill level.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayOrderInCategory>201</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/NoArt</iconPath>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <geneType>Xenogene</geneType>
        <comps>
          <li Class="XylXenos.GeneCompProperties_BonusGenes">
            <removeAfterAdding>true</removeAfterAdding>
            <maker Class="XylXenos.GeneSetMaker_List">
              <genes>
                <!--<li>AptitudeStrong_Shooting</li>-->
                <!--<li>AptitudeStrong_Melee</li>-->
                <li>AptitudeStrong_Construction</li>
                <li>AptitudeStrong_Mining</li>
                <li>AptitudeStrong_Cooking</li>
                <li>AptitudeStrong_Plants</li>
                <li>AptitudeStrong_Animals</li>
                <li>AptitudeStrong_Crafting</li>
                <li>AptitudeStrong_Artistic</li>
                <li>AptitudeStrong_Medicine</li>
                <li>AptitudeStrong_Social</li>
                <li>AptitudeStrong_Intellectual</li>
              </genes>
            </maker>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="XylSpecialistBase">
    <defName>XylSuperSpecialist</defName>
    <label>super-specialist</label>
    <description>The carrier's aptitude in one random skill is increased by 8. Aptitude acts like an offset on skill level. Additionally, one level of passion is added to that skill.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayOrderInCategory>202</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/NoArt</iconPath>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <geneType>Xenogene</geneType>
        <comps>
          <li Class="XylXenos.GeneCompProperties_BonusGenes">
            <removeAfterAdding>true</removeAfterAdding>
            <maker Class="XylXenos.GeneSetMaker_List">
              <genes>
                <!--<li>AptitudeRemarkable_Shooting</li>-->
                <!--<li>AptitudeRemarkable_Melee</li>-->
                <li>AptitudeRemarkable_Construction</li>
                <li>AptitudeRemarkable_Mining</li>
                <li>AptitudeRemarkable_Cooking</li>
                <li>AptitudeRemarkable_Plants</li>
                <li>AptitudeRemarkable_Animals</li>
                <li>AptitudeRemarkable_Crafting</li>
                <li>AptitudeRemarkable_Artistic</li>
                <li>AptitudeRemarkable_Medicine</li>
                <li>AptitudeRemarkable_Social</li>
                <li>AptitudeRemarkable_Intellectual</li>
              </genes>
            </maker>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylScalebornLineage</defName>
    <label>scaleborn lineage</label>
    <description>TODO</description>
    <biostatCpx>5</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>XylRandom</displayCategory>
    <displayOrderInCategory>300</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/NoArt</iconPath>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <comps>
          <li Class="XylXenos.GeneCompProperties_BonusGenes">
            <removeAfterAdding>true</removeAfterAdding>
            <maker Class="XylXenos.GeneSetMaker_Option">
              <options>
                <li>
                  <maker Class="XylXenos.GeneSetMaker_List">
                    <count>3</count>
                    <genes>
                      <li>FireSpew</li>
                      <li>FireResistant</li>
                      <li>Skin_DeepRed</li>                      
                    </genes>
                  </maker>
                </li>
                <li>
                  <maker Class="XylXenos.GeneSetMaker_List">
                    <count>3</count>
                    <genes>
                      <li>AcidSpray</li>
                      <li>ToxResist_Partial</li>
                      <li>XylSkin_DarkGreen</li>                      
                    </genes>
                  </maker>
                </li>
                <li>
                  <maker Class="XylXenos.GeneSetMaker_List">
                    <count>3</count>
                    <genes>
                      <li>FoamSpray</li>
                      <li>FireResistant</li>
                      <li>Skin_SheerWhite</li>                      
                    </genes>
                  </maker>
                </li>
              </options>
            </maker>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

</Defs>
