<?xml version="1.0" encoding="utf-8" ?>

<Defs>

  <GeneDef>
    <defName>XylHyperlactation</defName>
    <label>hyperlactation</label>
    <description>Female carriers of this gene produce large amounts of breast milk, and lactate even when not pregnant or breastfeeding. This gene is inactive on males.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>Reproduction</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Hyperlactation</iconPath>
    <minAgeActive>13</minAgeActive>
    <customEffectDescriptions>
      <li>Enables being milked</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="Xylib.DefModExtension_GeneWithComps">
        <extraIconPath>Things/Item/Resource/Milk</extraIconPath>
        <gender>Female</gender>
        <comps>
          <li Class="XylXenos.GeneCompProperties_Hyperlactation">
            <item>Milk</item>
            <chargePerItem>0.1</chargePerItem>
            <hediff>XylHyperlactating</hediff>
            <milkedThoughts>
              <li>XylMilked</li>
              <li>XylMilkedMood</li>
              <li>XylMilked_Masochist</li>
              <li>XylMilkedMood_Masochist</li>
            </milkedThoughts>
          </li>
          <li Class="Xylib.GeneCompProperties_StartingItems">
            <items>
              <li>
                <item>Milk</item>
                <chance>0.2</chance>
                <count>5~10</count>
              </li>
            </items>
          </li>
        </comps>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef ParentName="Lactating">
    <defName>XylHyperlactating</defName>
    <label>hyperlactating</label>
    <description>The condition of being able to breastfeed a baby. The breasts are actively producing and storing milk. This character produces milk continually as long as they get adequate food.</description>
    <descriptionHyperlinks>
      <GeneDef>XylHyperlactation</GeneDef>
    </descriptionHyperlinks>
    <comps Inherit="False">
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0</severityPerDay>
      </li>
      <li Class="HediffCompProperties_MessageOnRemoval">
        <messageOnNonZeroSeverity>false</messageOnNonZeroSeverity>
        <message>{0} is no longer lactating.</message>
        <messageType>SilentInput</messageType>
        <onlyMessageForColonistsOrPrisoners>true</onlyMessageForColonistsOrPrisoners>
      </li>
      <li Class="HediffCompProperties_Lactating">
        <ticksToFullCharge>60000</ticksToFullCharge>
        <!-- 6 hrs: 2 to feed a baby and 4 to recover. -->
        <initialCharge>0.125</initialCharge>
        <fullChargeAmount>0.5</fullChargeAmount>
        <labelInBrackets>milk fullness {CHARGEFACTOR_percentage}</labelInBrackets>
        <minChargeToActivate>0.031</minChargeToActivate>
        <!-- some hysteresis so when breastfeeding starts we're sure it can continue for a while. -->
      </li>
      <li Class="HediffCompProperties_RemoveIfOtherHediff">
        <hediffs>
          <li>Malnutrition</li>
        </hediffs>
        <stages>2~</stages>
        <mtbHours>4</mtbHours>
        <message>{0} is no longer lactating due to malnutrition.</message>
        <messageType>SilentInput</messageType>
        <onlyMessageForColonistsOrPrisoners>true</onlyMessageForColonistsOrPrisoners>
      </li>
      <li Class="Xylib.HediffCompProperties_Genetic">
        <gene>XylHyperlactation</gene>
      </li>
    </comps>
    <!-- Default Lactating has a fertilityFactor of 0.05. Remove that. -->
    <stages IsNull="True"/>
  </HediffDef>

  <ThoughtDef>
    <defName>XylSoreBreasts</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>XylXenos.ThoughtWorker_SoreBreasts</workerClass>
    <requiredGenes>
      <li>XylHyperlactation</li>
    </requiredGenes>
    <stages>
      <li IsNull="true" />
      <li>
        <label>full milk (sore)</label>
        <description>My breasts are full, heavy, and sore. This is uncomfortable.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
      <li>
        <label>full milk (painful)</label>
        <description>My breasts are very full, heavy, and sore. This painful.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>XylMilked</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <nullifyingTraits>
      <li>Masochist</li>
    </nullifyingTraits>
    <stages>
      <li>
        <label>milked</label>
        <labelSocial>milked me</labelSocial>
        <description>I was milked like an animal. It was humiliating.</description>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>XylMilkedMood</defName>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <nullifyingTraits>
      <li>Masochist</li>
    </nullifyingTraits>
    <stages>
      <li>
        <label>milked</label>
        <description>I was milked like an animal. It was humiliating.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>XylMilked_Masochist</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <requiredTraits>
      <li>Masochist</li>
    </requiredTraits>
    <replaceThoughts>
      <li>XylMilked</li>
    </replaceThoughts>
    <stages>
      <li>
        <label>masochist milked</label>
        <labelSocial>milked me</labelSocial>
        <description>I was milked like an animal. It was thrilling.</description>
        <baseOpinionOffset>5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>XylMilkedMood_Masochist</defName>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <requiredTraits>
      <li>Masochist</li>
    </requiredTraits>
    <replaceThoughts>
      <li>XylMilkedMood</li>
    </replaceThoughts>
    <stages>
      <li>
        <label>masochist milked</label>
        <description>I was milked like an animal. It was thrilling.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>