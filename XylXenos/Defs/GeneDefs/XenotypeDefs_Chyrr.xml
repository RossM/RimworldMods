<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <XenotypeDef>
    <defName>XylChyrr</defName>
    <label>chyrr</label>
    <description>Chyrr are nocturnal, flying mystics native to steaming jungles and sun-blasted deserts. They perceive the world through sound and low-level psychic sensing, aided by a hazy thread of precognition that lets them act just before things happen. Though physically fragile, they defend themselves with a keening cry that leaves foes reeling.</description>
    <iconPath>Xyl/UI/Icons/Xenotypes/Chyrr_small</iconPath>
    <displayPriority>-102</displayPriority>
    <combatPowerFactor>0.9</combatPowerFactor>
    <nameMaker>NamerXylPersonChyrrMale</nameMaker>
    <nameMakerFemale>NamerXylPersonChyrrFemale</nameMakerFemale>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <inheritable>true</inheritable>
    <genes>
      <li>XylSonicWave</li>
      <li>Immunity_Weak</li>
      <li>XylBatWings</li>
      <li>MinTemp_SmallIncrease</li>
      <li>MaxTemp_SmallIncrease</li>
      <li>XylTorpor</li>
      <li>UVSensitivity_Mild</li>
      <li>Delicate</li>
      <li>Body_Standard</li>
      <li>Body_Thin</li>
      <li>Beard_NoBeardOnly</li>
      <li>XylEars_SmallPointed</li>
      <li>DarkVision</li>
      <li>XylNocturnal</li>
      <li>XylKeenEars</li>
      <li>XylEcholocation</li>
      <li>AptitudePoor_Mining</li>
      <li>AptitudeStrong_Medicine</li>
    </genes>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Xenotype">
        <allowSolidBackstories>false</allowSolidBackstories>
        <agreeingMemes>
          <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
        </agreeingMemes>
      </li>
    </modExtensions>
  </XenotypeDef>

</Defs>
