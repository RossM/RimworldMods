  <GeneDef>
    <defName>XylPrecognition</defName>
    <label>precognition</label>
    <description>Carriers of this gene can see a short distance into the future, giving the ability to dodge both melee and ranged attacks. The effect scales with psychic sensitivity.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <displayCategory>Violence</displayCategory>
    <displayOrderInCategory>130</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Precognition</iconPath>
    <customEffectDescriptions>
      <li>Melee dodge chance: +15</li>
      <li>Ranged dodge chance: +15</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <permanentHediffs>
          <li Class="HediffGiver_Event">
            <hediff>XylPrecognition</hediff>
            <partsToAffect>
              <li>Head</li>
            </partsToAffect>
          </li>
        </permanentHediffs>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylPrecognition</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>precognition</label>
    <description>This character has the ability to see a short distance into the future, giving a chance to dodge both melee and ranged attacks in combat. The effect scales with psychic sensitivity.</description>
    <descriptionHyperlinks>
      <GeneDef>XylPrecognition</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>1.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <comps>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylPrecognition</gene>
      </li>
    </comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
        <statOffsets>
          <MeleeDodgeChance>15</MeleeDodgeChance>
          <XylRangedDodgeChance>15</XylRangedDodgeChance>
        </statOffsets>
        <statOffsetEffectMultiplier>PsychicSensitivity</statOffsetEffectMultiplier>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>XylBatWings</defName>
    <geneClass>XylXenos.Gene_Flight</geneClass>
    <label>bat wings</label>
