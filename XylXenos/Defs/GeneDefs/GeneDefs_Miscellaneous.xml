<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneDef ParentName="GeneAggressionBase">
    <defName>XylDocile</defName>
    <label>docile</label>
    <description>Carriers of this gene are generally docile. They are easy to enslave and rarely rebel. They are also less likely to start prison breaks, and never start social fights.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayOrderInCategory>5</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Docile</iconPath>
    <socialFightChanceFactor>0</socialFightChanceFactor>
    <prisonBreakMTBFactor>4</prisonBreakMTBFactor>
    <statFactors>
      <SlaveSuppressionFallRate MayRequire="Ludeon.RimWorld.Ideology">0.25</SlaveSuppressionFallRate>
      <XylWillFallRate>4</XylWillFallRate>
      <XylSlaveRebellionMtbFactor>4</XylSlaveRebellionMtbFactor>
    </statFactors>
    <suppressedTraits>
      <Bloodlust />
    </suppressedTraits>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <slaveRebellionThresholdDays>120</slaveRebellionThresholdDays>
        <manhunterOnTameFailChanceFactor>0</manhunterOnTameFailChanceFactor>
      </li>
    </modExtensions>
  </GeneDef>

  <ThoughtDef>
    <defName>XylDocileEnslaved</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>XylXenos.ThoughtWorker_PawnStatus</workerClass>
    <requiredGenes>
      <li>XylDocile</li>
    </requiredGenes>
    <stages>
      <li>
        <label>docile enslaved</label>
        <description>It's so comforting having someone else to tell me what to do.</description>
        <baseMoodEffect>20</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Thought_PawnStatus">
        <status>Slave</status>
      </li>
    </modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>XylDocileImprisoned</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>XylXenos.ThoughtWorker_PawnStatus</workerClass>
    <requiredGenes>
      <li>XylDocile</li>
    </requiredGenes>
    <stages>
      <li>
        <label>docile imprisoned</label>
        <description>It's so comforting having someone else to tell me what to do.</description>
        <baseMoodEffect>20</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Thought_PawnStatus">
        <status>Prisoner</status>
      </li>
    </modExtensions>
  </ThoughtDef>

  <GeneDef>
    <defName>XylSeeingRed</defName>
    <geneClass>XylXenos.Gene_SeeingRed</geneClass>
    <label>seeing red</label>
    <description>Carriers of this gene have a chance of going into a blind range when they are damaged in combat, charging the nearest enemy and fighting in melee until all enemies are dead. During this state they are faster, stronger, and nearly immune to pain. This ability can't be controlled.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>4</biostatMet>
    <displayCategory>Violence</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_SeeingRed</iconPath>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <manhunterOnDamageChanceFactor>2</manhunterOnDamageChanceFactor>
        <seeingRed>
          <chance>0.15</chance>
          <hediffDef>XylSeeingRed</hediffDef>
        </seeingRed>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylSeeingRed</defName>
    <label>seeing red</label>
    <description>A temporary frenzy state. The character can't be controlled until the frenzy ends.</description>
    <descriptionHyperlinks>
      <GeneDef>XylSeeingRed</GeneDef>
    </descriptionHyperlinks>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <!--15 seconds-->
        <disappearsAfterTicks>900</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="XylXenos.HediffCompProperties_ForceMentalState">
        <mentalState>XylSeeingRed</mentalState>
      </li>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylSeeingRed</gene>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.5</offset>
          </li>
        </capMods>
        <statFactors>
          <MeleeDamageFactor>1.5</MeleeDamageFactor>
        </statFactors>
        <painFactor>0.1</painFactor>
      </li>
    </stages>
  </HediffDef>

  <MentalStateDef ParentName="Berserk">
    <defName>XylSeeingRed</defName>
    <stateClass>XylXenos.MentalState_SeeingRed</stateClass>
    <label>seeing red</label>
    <minTicksBeforeRecovery>99999999</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>99999999</maxTicksBeforeRecovery>
    <baseInspectLine>Mental state: Seeing red</baseInspectLine>
    <nameColor>(0.8,0.1,0.2)</nameColor>
    <beginLetter></beginLetter>
    <recoveryMessage></recoveryMessage>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_MentalState_SeeingRed">
        <iconPath>Xyl/UI/Icons/Genes/Gene_SeeingRed</iconPath>
      </li>
    </modExtensions>
  </MentalStateDef>

  <GeneDef>
    <defName>XylPrecognition</defName>
    <label>precognition</label>
    <description>Carriers of this gene can see a short distance into the future, giving the ability to dodge both melee and ranged attacks. The effect scales with psychic sensitivity.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <displayCategory>Violence</displayCategory>
    <displayOrderInCategory>130</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Precognition</iconPath>
    <customEffectDescriptions>
      <li>Melee dodge chance: +15</li>
      <li>Ranged dodge chance: +15</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <permanentHediffs>
          <li Class="HediffGiver_Event">
            <hediff>XylPrecognition</hediff>
            <partsToAffect>
              <li>Head</li>
            </partsToAffect>
          </li>
        </permanentHediffs>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylPrecognition</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>precognition</label>
    <description>This character has the ability to see a short distance into the future, giving a chance to dodge both melee and ranged attacks in combat. The effect scales with psychic sensitivity.</description>
    <descriptionHyperlinks>
      <GeneDef>XylPrecognition</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>1.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <comps>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylPrecognition</gene>
      </li>
    </comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
        <statOffsets>
          <MeleeDodgeChance>15</MeleeDodgeChance>
          <XylRangedDodgeChance>15</XylRangedDodgeChance>
        </statOffsets>
        <statOffsetEffectMultiplier>PsychicSensitivity</statOffsetEffectMultiplier>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>XylBatWings</defName>
    <geneClass>XylXenos.Gene_Flight</geneClass>
    <label>bat wings</label>
    <description>Carriers of this gene have bat-like wings, allowing them to fly for short periods. Wearing some heavy torso-covering items will prevent flight.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-3</biostatMet>
    <displayCategory>Movement</displayCategory>
    <displayOrderInCategory>510</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_BatWings</iconPath>
    <renderNodeProperties>
      <li>
        <nodeClass>XylXenos.PawnRenderNode_Wings</nodeClass>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPaths>
          <li>Xyl/Things/Pawn/Humanlike/BodyAttachments/BatWings/BatWings</li>
          <li>Xyl/Things/Pawn/Humanlike/BodyAttachments/BatWings/BatWingsExtended</li>
        </texPaths>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <colorType>Hair</colorType>
        <parentTagDef>Body</parentTagDef>
        <drawData>
          <defaultData>
            <layer>50</layer>
            <offset>(0,0,-0.1)</offset>
          </defaultData>
          <dataNorth>
            <layer>80</layer>
            <offset>(0,0,-0.1)</offset>
          </dataNorth>
          <dataSouth>
            <layer>-10</layer>
            <offset>(0,0,-0.1)</offset>
          </dataSouth>
        </drawData>
      </li>
    </renderNodeProperties>
    <capMods>
      <li>
        <capacity>Manipulation</capacity>
        <offset>-0.1</offset>
      </li>
    </capMods>
    <statOffsets>
      <MaxFlightTime>8</MaxFlightTime>
      <FlightCooldown>45</FlightCooldown>
    </statOffsets>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <flight/>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylTorpor</defName>
    <label>torpor</label>
    <description>The body of a carrier of this gene automatically goes into hibernation in cold temperatures. This will impair their capabilities and eventually cause unconsciousness. It also reduces food consumption and slows the progression of hypothermia and starvation.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <displayCategory>Temperature</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <!--<iconPath>Xyl/UI/Icons/Abilities/SonicWave</iconPath>-->
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <hediffGivers>
          <li Class="XylXenos.HediffGiver_Torpor">
            <hediff>XylTorpor</hediff>
            <temperatureThreshold>11</temperatureThreshold>
            <comfyTemperatureImportance>0.3</comfyTemperatureImportance>
            <severityGainPerDayPerDegree>0.02</severityGainPerDayPerDegree>
            <severityLossPerDayPerDegree>0.02</severityLossPerDayPerDegree>
          </li>
        </hediffGivers>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylTorpor</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>torpor</label>
    <description>This character's body is responding to low temperature by entering a state of hibernation. Their metabolism will slow, and they will eventually fall unconscious. The condition will reverse itself if the character is kept warm.</description>
    <overrideTooltip>{PAWN}'s body is responding to low temperature by entering a state of hibernation. {PAWN_possessive} metabolism will slow, and {PAWN_pronoun} will eventually fall unconscious. The condition will reverse itself if {PAWN_pronoun} is kept warm.</overrideTooltip>
    <descriptionHyperlinks>
      <GeneDef>XylTorpor</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_MessageAboveSeverity">
        <severity>0.1</severity>
        <message>{0} is beginning to enter torpor.</message>
        <messageType>NegativeHealthEvent</messageType>
      </li>
      <li Class="XylXenos.HediffCompProperties_SetNeed">
        <need>Rest</need>
        <levelPercentage>0~0.1</levelPercentage>
        <severityRange>0.5~999</severityRange>
      </li>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylTorpor</gene>
      </li>
    </comps>
    <stages>
      <li>
        <label>yawning</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <label>groggy</label>
        <minSeverity>0.1</minSeverity>
        <becomeVisible>true</becomeVisible>
        <hungerRateFactor>0.5</hungerRateFactor>
        <restFallFactor>1.25</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.8</setMax>
          </li>
        </capMods>
        <statFactors>
          <XylHypothermiaProgressionFactor>0.5</XylHypothermiaProgressionFactor>
          <XylMalnutritionProgressionFactor>0.5</XylMalnutritionProgressionFactor>
        </statFactors>
      </li>
      <li>
        <label>half-asleep</label>
        <minSeverity>0.25</minSeverity>
        <hungerRateFactor>0.25</hungerRateFactor>
        <restFallFactor>2</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
        <statFactors>
          <XylHypothermiaProgressionFactor>0.25</XylHypothermiaProgressionFactor>
          <XylMalnutritionProgressionFactor>0.25</XylMalnutritionProgressionFactor>
        </statFactors>
      </li>
      <li>
        <label>hibernating</label>
        <minSeverity>0.5</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <hungerRateFactor>0.1</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
        <statFactors>
          <XylHypothermiaProgressionFactor>0.1</XylHypothermiaProgressionFactor>
          <XylMalnutritionProgressionFactor>0.1</XylMalnutritionProgressionFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>XylInsectPheromones</defName>
    <label>insect pheromones</label>
    <description>Carriers of this gene produce special pheromones which make wild insects not attack them.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-3</biostatMet>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>501</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_InsectPheromones</iconPath>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <disableHostilityFromFactions>
          <li>Insect</li>
        </disableHostilityFromFactions>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylBioRejection</defName>
    <label>bio-rejection</label>
    <description>Carriers of this gene have a severe allergic reaction to any sort of artificial implant or body part. They will suffer continual pain until the implant or part is removed.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <displayOrderInCategory>300</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_BioRejection</iconPath>
    <suppressedTraits>
      <Transhumanist />
    </suppressedTraits>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <permanentHediffs>
          <li>
            <hediff>XylBioRejection</hediff>
          </li>
        </permanentHediffs>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylBioRejection</defName>
    <hediffClass>XylXenos.Hediff_BioRejection</hediffClass>
    <label>bio-rejection</label>
    <description>Suffering from a severe allergic reaction to an artificial body part or implant. The only way to stop the reaction is to remove the artificial part or parts.</description>
    <descriptionHyperlinks>
      <GeneDef>XylBioRejection</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>0.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>true</isBad>
    <comps>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylBioRejection</gene>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <painOffset>0.4</painOffset>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>XylEmergencyReserves</defName>
    <label>emergency reserves</label>
    <description>Carriers of this gene store extra oxygen and special proteins in their bone marrow. When the carrier is exposed to extreme heat, cold, toxins, or vacuum, these reserves temporarily flood the body, protecting tissues from damage.</description>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <displayOrderInCategory>90</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-2</biostatMet>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylGravitySickness</defName>
    <label>gravity sickness</label>
    <description>Carriers of this gene are prone to debilitating bouts of gravity sickness while on a planet's surface. They periodically suffer pain, nausea, and reduced consciousness for a day or so, or until they return to orbit.</description>
    <displayCategory>Healing</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>5</biostatMet>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylMechAffinity</defName>
    <label>mech affinity</label>
    <description>Carriers of this gene are naturally adept at being mechanitors.</description>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>1100</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <MechBandwidth>3</MechBandwidth>
    </statOffsets>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylLearning_Focused</defName>
    <label>focused</label>
    <description>Carriers of this gene care deeply about subjects they are interested in. They learn faster for skills they have a burning passion in, but much slower at skills they have no passion in.</description>
    <!--<iconPath>UI/Icons/Genes/Gene_SlowLearning</iconPath>-->
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>36</displayOrderInCategory>
    <statOffsets>
      <XylLearnFactorPassionMajor>0.5</XylLearnFactorPassionMajor>
      <XylLearnFactorPassionNone>-0.25</XylLearnFactorPassionNone>
    </statOffsets>
    <biostatCpx>2</biostatCpx>
    <biostatMet>1</biostatMet>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylWoundHealing_UltraFast</defName>
    <geneClass>XylXenos.Gene_Regeneration</geneClass>
    <label>ultra-fast wound healing</label>
    <description>Carriers of this gene heal wounds unnaturally quickly, often recovering from even the most serious injuries in mere hours. It won't fix permanent scars or blood loss.</description>
    <displayCategory>Archite</displayCategory>
    <displayOrderInCategory>0</displayOrderInCategory>
    <biostatCpx>4</biostatCpx>
    <biostatArc>1</biostatArc>
    <exclusionTags>
      <li>WoundHealingRate</li>
    </exclusionTags>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <regeneration>
          <healthPerHour>40</healthPerHour>
        </regeneration>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylUnnaturalToughness</defName>
    <label>unnatural toughness</label>
    <description>Carriers of this gene take much less injuries than others from the same damage. Archites in their bones and flesh toughen every part of their body.</description>
    <displayCategory>Archite</displayCategory>
    <displayOrderInCategory>0</displayOrderInCategory>
    <biostatCpx>3</biostatCpx>
    <biostatArc>1</biostatArc>
    <statFactors>
      <IncomingDamageFactor>0.5</IncomingDamageFactor>
    </statFactors>
    <exclusionTags>
      <li>Toughness</li>
    </exclusionTags>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

</Defs>
