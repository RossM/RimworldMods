          <dataNorth>
            <layer>80</layer>
            <offset>(0,0,-0.1)</offset>
          </dataNorth>
          <dataSouth>
            <layer>-10</layer>
            <offset>(0,0,-0.1)</offset>
          </dataSouth>
        </drawData>
      </li>
