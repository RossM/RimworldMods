  <GeneDef>
    <defName>XylEmergencyReserves</defName>
    <label>emergency reserves</label>
    <description>Carriers of this gene store extra oxygen and special proteins in their bone marrow. When the carrier is exposed to extreme heat, cold, toxins, or vacuum, these reserves temporarily flood the body, protecting tissues from damage.</description>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <displayOrderInCategory>90</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-2</biostatMet>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylGravitySickness</defName>
    <label>gravity sickness</label>
    <description>Carriers of this gene are prone to debilitating bouts of gravity sickness while on a planet's surface. They periodically suffer pain, nausea, and reduced consciousness for a day or so, or until they return to orbit.</description>
    <displayCategory>Healing</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>5</biostatMet>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylMechAffinity</defName>
    <label>mech affinity</label>
    <description>Carriers of this gene are naturally adept at being mechanitors.</description>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>1100</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <MechBandwidth>3</MechBandwidth>
    </statOffsets>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylPetrification</defName>
    <label>petrification</label>
    <description>Carriers of this gene have a chance to develop a disease named petrification. Petrification slowly replaces tissues throughout the body with stone. The disease is incurable, but progress can be slowed with medical treatment, and the affected tissues can be removed surgically.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>4</biostatMet>
    <displayCategory>Healing</displayCategory>
    <displayOrderInCategory>210</displayOrderInCategory>
    <!--<iconPath>Xyl/UI/Icons/Genes/Gene_EvenTemper</iconPath>-->
    <prerequisite>XylLithoid</prerequisite>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <startingItems>
          <li>
            <item>XylSoftener</item>
            <chance>0.05</chance>
            <count>5~10</count>
          </li>
        </startingItems>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylPetrification</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>petrification</label>
    <description>An incurable, progressive genetic disease that affects titans. Tissues throughout the body are gradually replaced with hard, rocky growths. If untreated, it will eventually become fatal.</description>
    <descriptionHyperlinks>
      <GeneDef>XylPetrification</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>0.1</initialSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <minSeverity>0.01</minSeverity>
    <maxSeverity>1.0</maxSeverity>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <everCurableByItem>false</everCurableByItem>
    <tendable>true</tendable>
    <comps>
      <li Class="XylXenos.HediffCompProperties_GrowthModeExt">
        <modes>
          <li>
            <label>active</label>
            <isActive>true</isActive>
            <severityPerDayRange>0.008~0.012</severityPerDayRange>
            <message>{PAWN_labelShort}'s petrification has become active.</message>
            <messageType>NegativeHealthEvent</messageType>
          </li>
          <li>
            <label>dormant</label>
            <causesNoPain>true</causesNoPain>
            <allowTend>false</allowTend>
            <changeMtbDays>120</changeMtbDays>
            <message>{PAWN_labelShort}'s petrification has gone dormant.</message>
            <messageType>NeutralEvent</messageType>
            <tipString>The disease is currently dormant, but could become active at any time.</tipString>
          </li>
        </modes>
      </li>
      <li Class="XylXenos.HediffCompProperties_PetrificationTendDuration">
        <baseTendDurationHours>120</baseTendDurationHours>
        <severityPerDayTended>0.01</severityPerDayTended>
        <changeModeAtTotalTendQuality>3</changeModeAtTotalTendQuality>
      </li>
      <li Class="XylXenos.HediffCompProperties_GiveHediffExt">
        <hediffs>
          <li>
            <mtbDays>15</mtbDays>
            <hediff>XylPetrifiedFlesh</hediff>
            <severityRange>2~5</severityRange>
            <canAffectAnyLivePart>true</canAffectAnyLivePart>
            <allowDuplicates>true</allowDuplicates>
          </li>
          <li>
            <mtbDays>5</mtbDays>
            <minSeverity>0.4</minSeverity>
            <hediff>XylPetrifiedFlesh</hediff>
            <severityRange>5~10</severityRange>
            <canAffectAnyLivePart>true</canAffectAnyLivePart>
            <allowDuplicates>true</allowDuplicates>
          </li>
        </hediffs>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <painOffset>0.1</painOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>major</label>
        <painOffset>0.2</painOffset>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <painOffset>0.4</painOffset>
        <lifeThreatening>true</lifeThreatening>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>XylPetrifiedFlesh</defName>
    <hediffClass>XylXenos.Hediff_PetrifiedFlesh</hediffClass>
    <label>petrified</label>
    <labelNoun>petrified flesh</labelNoun>
    <description>This body part has been partially replaced with hard, rocky growths. They must be surgically removed to allow the part to heal.</description>
    <descriptionHyperlinks>
      <GeneDef>XylPetrification</GeneDef>
      <HediffDef>XylPetrification</HediffDef>
    </descriptionHyperlinks>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <comps>
      <li Class="XylXenos.HediffCompProperties_GiveHediffExt">
        <hediffs>
          <li>
            <triggeredOnRemoval>true</triggeredOnRemoval>
            <hediff>SurgicalCut</hediff>
            <inheritSeverity>true</inheritSeverity>
            <sameBodyPart>true</sameBodyPart>
          </li>
        </hediffs>
      </li>
    </comps>
    <onlyLifeThreateningTo>
      <li>Head</li>
      <li>Brain</li>
      <li>Neck</li>
      <li>Spine</li>
      <li>Torso</li>
      <li>Heart</li>
    </onlyLifeThreateningTo>
    <stages>
      <li>
        <label>minor</label>
        <partEfficiencyOffset>-1.0</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>major</label>
        <partEfficiencyOffset>-1.0</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <partEfficiencyOffset>-1.0</partEfficiencyOffset>
        <lifeThreatening>true</lifeThreatening>
      </li>
      <li>
        <minSeverity>1.0</minSeverity>
        <label>total</label>
        <partEfficiencyOffset>-1.0</partEfficiencyOffset>
        <lifeThreatening>true</lifeThreatening>
        <overrideTooltip>This body part has been completely replaced with hard, rocky growths and no longer functions. It can be surgically removed.</overrideTooltip>
      </li>
    </stages>
    <spawnThingOnRemoved>ChunkLimestone</spawnThingOnRemoved>
  </HediffDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>XylExcisePetrifiedFlesh</defName>
    <label>excise petrified flesh</label>
    <description>Excise petrified flesh.</description>
    <workerClass>XylXenos.Recipe_RemoveHediff_Petrified</workerClass>
    <jobString>Excising petrified flesh.</jobString>
    <workAmount>3000</workAmount>
    <removesHediff>XylPetrifiedFlesh</removesHediff>
    <successfullyRemovedHediffMessage>{0} has successfully excised {1}'s petrified flesh.</successfullyRemovedHediffMessage>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>

  <GeneDef>
    <defName>XylLearning_Focused</defName>
    <label>focused</label>
    <description>Carriers of this gene care deeply about subjects they are interested in. They learn faster for skills they have a burning passion in, but much slower at skills they have no passion in.</description>
    <!--<iconPath>UI/Icons/Genes/Gene_SlowLearning</iconPath>-->
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>36</displayOrderInCategory>
    <statOffsets>
      <XylLearnFactorPassionMajor>0.5</XylLearnFactorPassionMajor>
      <XylLearnFactorPassionNone>-0.25</XylLearnFactorPassionNone>
    </statOffsets>
    <biostatCpx>2</biostatCpx>
    <biostatMet>1</biostatMet>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylWoundHealing_UltraFast</defName>
    <geneClass>XylXenos.Gene_Regeneration</geneClass>
    <label>ultra-fast wound healing</label>
    <description>Carriers of this gene heal wounds unnaturally quickly, often recovering from even the most serious injuries in mere hours. It won't fix permanent scars or blood loss.</description>
    <displayCategory>Archite</displayCategory>
    <displayOrderInCategory>0</displayOrderInCategory>
    <biostatCpx>4</biostatCpx>
    <biostatArc>1</biostatArc>
    <exclusionTags>
      <li>WoundHealingRate</li>
    </exclusionTags>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <regeneration>
          <healthPerHour>40</healthPerHour>
        </regeneration>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylUnnaturalToughness</defName>
    <label>unnatural toughness</label>
    <description>Carriers of this gene take much less injuries than others from the same damage. Archites in their bones and flesh toughen every part of their body.</description>
    <displayCategory>Archite</displayCategory>
    <displayOrderInCategory>0</displayOrderInCategory>
    <biostatCpx>3</biostatCpx>
    <biostatArc>1</biostatArc>
    <statFactors>
      <IncomingDamageFactor>0.5</IncomingDamageFactor>
    </statFactors>
    <exclusionTags>
      <li>Toughness</li>
    </exclusionTags>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
      </li>
    </modExtensions>
  </GeneDef>

</Defs>
