<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneDef ParentName="GeneAggressionBase">
    <defName>XylDocile</defName>
    <label>docile</label>
    <description>Carriers of this gene are generally docile. They are easy to enslave and rarely rebel. They are also less likely to start prison breaks, and never start social fights.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayOrderInCategory>5</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Docile</iconPath>
    <socialFightChanceFactor>0</socialFightChanceFactor>
    <prisonBreakMTBFactor>4</prisonBreakMTBFactor>
    <statFactors>
      <SlaveSuppressionFallRate MayRequire="Ludeon.RimWorld.Ideology">0.25</SlaveSuppressionFallRate>
      <XylWillFallRate>4</XylWillFallRate>
      <XylSlaveRebellionMtbFactor>4</XylSlaveRebellionMtbFactor>
    </statFactors>
    <suppressedTraits>
      <Bloodlust />
    </suppressedTraits>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <slaveRebellionThresholdDays>120</slaveRebellionThresholdDays>
        <manhunterOnTameFailChanceFactor>0</manhunterOnTameFailChanceFactor>
      </li>
    </modExtensions>
  </GeneDef>

  <ThoughtDef>
    <defName>XylDocileEnslaved</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>XylXenos.ThoughtWorker_PawnStatus</workerClass>
    <requiredGenes>
      <li>XylDocile</li>
    </requiredGenes>
    <stages>
      <li>
        <label>docile enslaved</label>
        <description>It's so comforting having someone else to tell me what to do.</description>
        <baseMoodEffect>20</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Thought_PawnStatus">
        <status>Slave</status>
      </li>
    </modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>XylDocileImprisoned</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>XylXenos.ThoughtWorker_PawnStatus</workerClass>
    <requiredGenes>
      <li>XylDocile</li>
    </requiredGenes>
    <stages>
      <li>
        <label>docile imprisoned</label>
        <description>It's so comforting having someone else to tell me what to do.</description>
        <baseMoodEffect>20</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Thought_PawnStatus">
        <status>Prisoner</status>
      </li>
    </modExtensions>
  </ThoughtDef>

  <GeneDef>
    <defName>XylSeeingRed</defName>
    <geneClass>XylXenos.Gene_SeeingRed</geneClass>
    <label>seeing red</label>
    <description>Carriers of this gene have a chance of going into a blind range when they are damaged in combat, charging the nearest enemy and fighting in melee until all enemies are dead. During this state they are faster, stronger, and nearly immune to pain. This ability can't be controlled.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>4</biostatMet>
    <displayCategory>Violence</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_SeeingRed</iconPath>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <manhunterOnDamageChanceFactor>2</manhunterOnDamageChanceFactor>
        <seeingRed>
          <chance>0.15</chance>
          <hediffDef>XylSeeingRed</hediffDef>
        </seeingRed>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>XylSeeingRed</defName>
    <label>seeing red</label>
    <description>A temporary frenzy state. The character can't be controlled until the frenzy ends.</description>
    <descriptionHyperlinks>
      <GeneDef>XylSeeingRed</GeneDef>
    </descriptionHyperlinks>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <!--15 seconds-->
        <disappearsAfterTicks>900</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="XylXenos.HediffCompProperties_ForceMentalState">
        <mentalState>XylSeeingRed</mentalState>
      </li>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylSeeingRed</gene>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.5</offset>
          </li>
        </capMods>
        <statFactors>
          <MeleeDamageFactor>1.5</MeleeDamageFactor>
        </statFactors>
        <painFactor>0.1</painFactor>
      </li>
    </stages>
  </HediffDef>

  <MentalStateDef ParentName="Berserk">
    <defName>XylSeeingRed</defName>
    <stateClass>XylXenos.MentalState_SeeingRed</stateClass>
    <label>seeing red</label>
    <minTicksBeforeRecovery>99999999</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>99999999</maxTicksBeforeRecovery>
    <baseInspectLine>Mental state: Seeing red</baseInspectLine>
    <nameColor>(0.8,0.1,0.2)</nameColor>
    <beginLetter></beginLetter>
    <recoveryMessage></recoveryMessage>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_MentalState_SeeingRed">
        <iconPath>Xyl/UI/Icons/Genes/Gene_SeeingRed</iconPath>
      </li>
    </modExtensions>
  </MentalStateDef>

  <GeneDef>
    <defName>XylHyperlactation</defName>
    <geneClass>XylXenos.Gene_Hyperlactation</geneClass>
    <label>hyperlactation</label>
    <description>Female carriers of this gene produce large amounts of breast milk, and lactate even when not pregnant or breastfeeding. This gene is inactive on males.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>Reproduction</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Hyperlactation</iconPath>
    <minAgeActive>13</minAgeActive>
    <customEffectDescriptions>
      <li>Enables being milked</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Gene">
        <extraIconPath>Things/Item/Resource/Milk</extraIconPath>
        <gender>Female</gender>
        <startingItems>
          <li>
            <item>Milk</item>
            <chance>0.2</chance>
            <count>5~10</count>
          </li>
        </startingItems>
        <hyperlactation>
          <item>Milk</item>
          <chargePerItem>0.1</chargePerItem>
          <hediff>XylHyperlactating</hediff>
          <milkedThoughts>
            <li>XylMilked</li>
            <li>XylMilkedMood</li>
            <li>XylMilked_Masochist</li>
            <li>XylMilkedMood_Masochist</li>
          </milkedThoughts>
        </hyperlactation>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef ParentName="Lactating">
    <defName>XylHyperlactating</defName>
    <label>hyperlactating</label>
    <description>The condition of being able to breastfeed a baby. The breasts are actively producing and storing milk. This character produces milk continually as long as they get adequate food.</description>
    <descriptionHyperlinks>
      <GeneDef>XylHyperlactation</GeneDef>
    </descriptionHyperlinks>
    <comps Inherit="False">
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0</severityPerDay>
      </li>
      <li Class="HediffCompProperties_MessageOnRemoval">
        <messageOnNonZeroSeverity>false</messageOnNonZeroSeverity>
        <message>{0} is no longer lactating.</message>
        <messageType>SilentInput</messageType>
        <onlyMessageForColonistsOrPrisoners>true</onlyMessageForColonistsOrPrisoners>
      </li>
      <li Class="HediffCompProperties_Lactating">
        <ticksToFullCharge>60000</ticksToFullCharge>
        <!-- 6 hrs: 2 to feed a baby and 4 to recover. -->
        <initialCharge>0.125</initialCharge>
        <fullChargeAmount>0.5</fullChargeAmount>
        <labelInBrackets>milk fullness {CHARGEFACTOR_percentage}</labelInBrackets>
        <minChargeToActivate>0.031</minChargeToActivate>
        <!-- some hysteresis so when breastfeeding starts we're sure it can continue for a while. -->
      </li>
      <li Class="HediffCompProperties_RemoveIfOtherHediff">
        <hediffs>
          <li>Malnutrition</li>
        </hediffs>
        <stages>2~</stages>
        <mtbHours>4</mtbHours>
        <message>{0} is no longer lactating due to malnutrition.</message>
        <messageType>SilentInput</messageType>
        <onlyMessageForColonistsOrPrisoners>true</onlyMessageForColonistsOrPrisoners>
      </li>
      <li Class="XylXenos.HediffCompProperties_Genetic">
        <gene>XylHyperlactation</gene>
      </li>
    </comps>
    <!-- Default Lactating has a fertilityFactor of 0.05. Remove that. -->
    <stages IsNull="True"/>
  </HediffDef>

  <ThoughtDef>
    <defName>XylSoreBreasts</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>XylXenos.ThoughtWorker_SoreBreasts</workerClass>
    <requiredGenes>
      <li>XylHyperlactation</li>
    </requiredGenes>
    <stages>
      <li>
        <label>full breasts</label>
        <description>My breasts are getting full and heavy. This is slightly uncomfortable.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>sore breasts</label>
        <description>My breasts are full, heavy, and sore. This is very uncomfortable.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>very sore breasts</label>
        <description>My breasts are very full, heavy, and sore. This very uncomfortable.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

