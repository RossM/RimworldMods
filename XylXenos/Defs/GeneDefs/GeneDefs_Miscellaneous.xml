<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <GeneDef ParentName="GeneAggressionBase">
    <defName>XylDocile</defName>
    <label>docile</label>
    <description>Carriers of this gene are generally docile. They are easy to enslave and rarely rebel. They are also less likely to start prison breaks, and never start social fights.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayOrderInCategory>5</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Docile</iconPath>
    <socialFightChanceFactor>0</socialFightChanceFactor>
    <prisonBreakMTBFactor>4</prisonBreakMTBFactor>
    <statFactors>
      <SlaveSuppressionFallRate MayRequire="Ludeon.RimWorld.Ideology">0.25</SlaveSuppressionFallRate>
      <XylWillFallRate>4</XylWillFallRate>
    </statFactors>
    <suppressedTraits>
      <li>
        <def>Bloodlust</def>
      </li>
    </suppressedTraits>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <slaveRebellionMtbFactor>4</slaveRebellionMtbFactor>
        <slaveRebellionThresholdDays>120</slaveRebellionThresholdDays>
        <manhunterOnTameFailChanceFactor>0</manhunterOnTameFailChanceFactor>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <geneClass>XylXenos.Genes.SeeingRed</geneClass>
    <defName>XylSeeingRed</defName>
    <label>seeing red</label>
    <description>Carriers of this gene have a chance of going into a blind range when they are damaged in combat, charging the nearest enemy and fighting in melee until all enemies are dead. During this state they are faster, stronger, and nearly immune to pain. This ability can't be controlled.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>4</biostatMet>
    <displayCategory>Violence</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_SeeingRed</iconPath>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <manhunterOnDamageChanceFactor>2</manhunterOnDamageChanceFactor>
        <seeingRed>
          <chance>0.15</chance>
          <hediffDef>XylSeeingRed</hediffDef>
        </seeingRed>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <geneClass>XylXenos.Genes.Hyperlactation</geneClass>
    <defName>XylHyperlactation</defName>
    <label>hyperlactation</label>
    <description>Female carriers of this gene produce large amounts of breast milk, and lactate even when not pregnant or breastfeeding. This gene is inactive on males.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>Reproduction</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Hyperlactation</iconPath>
    <minAgeActive>13</minAgeActive>
    <customEffectDescriptions>
      <li>Enables being milked</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <extraIconPath>Things/Item/Resource/Milk</extraIconPath>
        <gender>Female</gender>
        <startingItems>
          <li>
            <item>Milk</item>
            <chance>0.2</chance>
            <count>5~10</count>
          </li>
        </startingItems>
        <hyperlactation>
          <item>Milk</item>
          <chargePerItem>0.1</chargePerItem>
          <hediff>XylHyperlactating</hediff>
          <milkedThoughts>
            <li>XylMilked</li>
            <li>XylMilkedMood</li>
            <li>XylMilked_Masochist</li>
            <li>XylMilkedMood_Masochist</li>
          </milkedThoughts>
        </hyperlactation>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylPrecognition</defName>
    <label>precognition</label>
    <description>Carriers of this gene can see a short distance into the future, giving the ability to dodge both melee and ranged attacks. The effect scales with psychic sensitivity.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <displayCategory>Violence</displayCategory>
    <displayOrderInCategory>130</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Precognition</iconPath>
    <customEffectDescriptions>
      <li>Melee dodge chance: +15</li>
      <li>Ranged dodge chance: +15</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <permanentHediffs>
          <li Class="HediffGiver_Event">
            <hediff>XylPrecognition</hediff>
            <partsToAffect>
              <li>Head</li>
            </partsToAffect>
          </li>
        </permanentHediffs>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <geneClass>XylXenos.Genes.Flight</geneClass>
    <defName>XylBatWings</defName>
    <label>bat wings</label>
    <description>Carriers of this gene have bat-like wings, allowing them to fly for short periods. Wearing some heavy torso-covering items will prevent flight.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-3</biostatMet>
    <displayCategory>Movement</displayCategory>
    <displayOrderInCategory>510</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_BatWings</iconPath>
    <renderNodeProperties>
      <li>
        <nodeClass>XylXenos.PawnRenderNode_Wings</nodeClass>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPaths>
          <li>Xyl/Things/Pawn/Humanlike/BodyAttachments/BatWings/BatWings</li>
          <li>Xyl/Things/Pawn/Humanlike/BodyAttachments/BatWings/BatWingsExtended</li>
        </texPaths>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <colorType>Hair</colorType>
        <parentTagDef>Body</parentTagDef>
        <drawData>
          <defaultData>
            <layer>10</layer>
            <offset>(0,0,-0.1)</offset>
          </defaultData>
          <dataNorth>
            <layer>80</layer>
            <offset>(0,0,-0.1)</offset>
          </dataNorth>
          <dataSouth>
            <layer>-10</layer>
            <offset>(0,0,-0.1)</offset>
          </dataSouth>
        </drawData>
      </li>
    </renderNodeProperties>
    <capMods>
      <li>
        <capacity>Manipulation</capacity>
        <offset>-0.1</offset>
      </li>
    </capMods>
    <statOffsets>
      <MaxFlightTime>8</MaxFlightTime>
      <FlightCooldown>45</FlightCooldown>
    </statOffsets>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <flight/>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <geneClass>XylXenos.Genes.Torpor</geneClass>
    <defName>XylTorpor</defName>
    <label>torpor</label>
    <description>The body of a carrier of this gene automatically goes into hibernation in cold temperatures. This will impair their capabilities and eventually cause unconsciousness. It also reduces food consumption and slows the progression of hypothermia and starvation.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <displayCategory>Temperature</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <!--<iconPath>Xyl/UI/Icons/Abilities/SonicWave</iconPath>-->
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <torpor>
          <hediff>XylTorpor</hediff>
          <temperatureThreshold>11</temperatureThreshold>
          <comfyTemperatureImportance>0.3</comfyTemperatureImportance>
          <severityGainPerDayPerDegree>0.02</severityGainPerDayPerDegree>
          <severityLossPerDayPerDegree>0.02</severityLossPerDayPerDegree>
        </torpor>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylIndustrious</defName>
    <label>industrious</label>
    <description>Carriers of this gene are exceptionally fast workers.</description>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>25</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_Industrious</iconPath>
    <iconColor>(0.35, 0.55, 0.35)</iconColor>
    <statOffsets>
      <WorkSpeedGlobal>0.15</WorkSpeedGlobal>
    </statOffsets>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylInsectPheromones</defName>
    <label>insect pheromones</label>
    <description>Carriers of this gene produce special pheromones which make wild insects not attack them.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-3</biostatMet>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>501</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_InsectPheromones</iconPath>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <disableHostilityFromFactions>
          <li>Insect</li>
        </disableHostilityFromFactions>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylBioRejection</defName>
    <label>bio-rejection</label>
    <description>Carriers of this gene have a severe allergic reaction to any sort of artificial implant or body part. They will suffer continual pain until the implant or part is removed.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <displayOrderInCategory>300</displayOrderInCategory>
    <iconPath>Xyl/UI/Icons/Genes/Gene_BioRejection</iconPath>
    <suppressedTraits>
      <li>
        <def>Transhumanist</def>
      </li>
    </suppressedTraits>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <permanentHediffs>
          <li>
            <hediff>XylBioRejection</hediff>
          </li>
        </permanentHediffs>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylEmergencyReserves</defName>
    <label>emergency reserves</label>
    <description>Carriers of this gene store extra oxygen and special proteins in their bone marrow. When the carrier is exposed to extreme heat, cold, toxins, or vacuum, these reserves temporarily flood the body, protecting tissues from damage.</description>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <displayOrderInCategory>90</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-2</biostatMet>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylGravitySickness</defName>
    <label>gravity sickness</label>
    <description>Carriers of this gene are prone to debilitating bouts of gravity sickness while on a planet's surface. They periodically suffer pain, nausea, and reduced consciousness for a day or so, or until they return to orbit.</description>
    <displayCategory>Healing</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>5</biostatMet>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylMechAffinity</defName>
    <label>mech affinity</label>
    <description>Carriers of this gene are naturally adept at being mechanitors.</description>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>1100</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <MechBandwidth>3</MechBandwidth>
    </statOffsets>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylPetrification</defName>
    <label>petrification</label>
    <description>Carriers of this gene have a chance to develop a disease named petrification. Petrification slowly replaces tissues throughout the body with stone. The disease is incurable, but progress can be slowed with medical treatment, and the affected tissues can be removed surgically.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>4</biostatMet>
    <displayCategory>Healing</displayCategory>
    <displayOrderInCategory>210</displayOrderInCategory>
    <!--<iconPath>Xyl/UI/Icons/Genes/Gene_EvenTemper</iconPath>-->
    <prerequisite>XylLithoid</prerequisite>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
        <startingItems>
          <li>
            <item>XylSoftener</item>
            <chance>0.05</chance>
            <count>5~10</count>
          </li>
        </startingItems>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>XylLearning_Focused</defName>
    <label>focused</label>
    <description>Carriers of this gene care deeply about subjects they are interested in. They learn faster for skills they have a burning passion in, but much slower at skills they have no passion in.</description>
    <!--<iconPath>UI/Icons/Genes/Gene_SlowLearning</iconPath>-->
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>36</displayOrderInCategory>
    <statOffsets>
      <XylLearnFactorPassionMajor>0.5</XylLearnFactorPassionMajor>
      <XylLearnFactorPassionNone>-0.25</XylLearnFactorPassionNone>
    </statOffsets>
    <biostatCpx>2</biostatCpx>
    <biostatMet>1</biostatMet>
    <modExtensions>
      <li Class="XylXenos.Genes.DefExt">
      </li>
    </modExtensions>
  </GeneDef>


</Defs>
