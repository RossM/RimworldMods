<?xml version="1.0" encoding="utf-8" ?>

<Defs>
  
  <GeneDef ParentName="GeneTailBase">
    <defName>XylTail_Beaver</defName>
    <label>beaver tail</label>
    <description>Carriers of this gene grow a broad, flat tail resembling that of an alphabeaver that helps with temperature regulation.</description>
    <iconPath>Xyl/UI/Icons/Genes/Gene_TailBeaver</iconPath>
    <displayOrderInCategory>1001</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <ComfyTemperatureMax>5</ComfyTemperatureMax>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
    </statOffsets>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Xyl/Things/Pawn/Humanlike/BodyAttachments/BeaverTail/BeaverTail</texPath>
        <overrideMeshSize>(1, 1)</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <color>(0.25,0.25,0.25)</color>
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>North</li>
          <li>West</li>
        </visibleFacing>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, -0.5)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataEast>
            <offset>(-0.5, 0, -0.3)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, -0.3)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

  <GeneDef ParentName="GeneTailBase">
    <defName>XylTail_Demon</defName>
    <label>pointed tail</label>
    <description>Carriers of this gene grow a narrow, pointed tail that increases the character's impact in social interactions.</description>
    <iconPath>Xyl/UI/Icons/Genes/Gene_TailDemon</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <displayOrderInCategory>1002</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <SocialImpact>0.4</SocialImpact>
    </statOffsets>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Xyl/Things/Pawn/Humanlike/BodyAttachments/DemonTail/DemonTail</texPath>
        <overrideMeshSize>(1, 1)</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <colorType>Skin</colorType>
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>North</li>
          <li>West</li>
        </visibleFacing>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataEast>
            <offset>(-0.5, 0, 0)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, 0)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

  <GeneDef ParentName="GeneTailBase">
    <defName>XylTail_Squirrel</defName>
    <label>squirrel tail</label>
    <description>Carriers of this gene grow a long, fluffy tail that keeps them warm and increases the opinion of other characters towards them.</description>
    <iconPath>Xyl/UI/Icons/Genes/Gene_TailSquirrel</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <displayOrderInCategory>1003</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
    </statOffsets>
    <customEffectDescriptions>
      <li>Opinion +3</li>
    </customEffectDescriptions>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Xyl/Things/Pawn/Humanlike/BodyAttachments/SquirrelTail/SquirrelTail</texPath>
        <!--<overrideMeshSize>(1, 1)</overrideMeshSize>-->
        <parentTagDef>Body</parentTagDef>
        <colorType>Hair</colorType>        
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>North</li>
          <li>West</li>
          <li>South</li>
        </visibleFacing>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, 0.3)</offset>
          </dataSouth>
          <dataEast>
            <offset>(-0.5, 0, 0)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.5, 0, 0)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>
  <ThoughtDef>
    <defName>XylSquirrelTail</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>XylXenos.ThoughtWorker_HasGene</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>squirrel tail</label>
        <baseOpinionOffset>3</baseOpinionOffset>
      </li>
    </stages>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Thought">
        <gene>XylTail_Squirrel</gene>
      </li>
    </modExtensions>
  </ThoughtDef>

</Defs>