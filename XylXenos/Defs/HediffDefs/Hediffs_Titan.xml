<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <HediffDef>
    <defName>XylPetrification</defName>
    <hediffClass>XylXenos.Hediff_Petrification</hediffClass>
    <label>petrification</label>
    <description>An incurable, progressive genetic disease that affects titans. Tissues throughout the body are gradually replaced with hard, rocky growths. If untreated, it will eventually become fatal.</description>
    <descriptionHyperlinks>
      <GeneDef>XylPetrification</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>0.01</initialSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <minSeverity>0.01</minSeverity>
    <maxSeverity>1.0</maxSeverity>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <everCurableByItem>false</everCurableByItem>
    <tendable>true</tendable>
    <comps>
      <li Class="XylXenos.HediffCompProperties_GrowthMode_Petrification">
        <severityPerDayRange>0.008~0.012</severityPerDayRange>
        <becomeActiveMtbDays>120</becomeActiveMtbDays>
        <messageBecomeActive>{PAWN_labelShort}'s petrification has become active.</messageBecomeActive>
        <messageBecomeDormant>{PAWN_labelShort}'s petrification has gone dormant.</messageBecomeDormant>
        <tipStringDormant>The disease is currently dormant, but could become active at any time.</tipStringDormant>
      </li>
      <li Class="XylXenos.HediffCompProperties_TendDuration_Petrification">
        <baseTendDurationHours>120</baseTendDurationHours>
        <severityPerDayTended>0.01</severityPerDayTended>
        <changeModeAtTotalTendQuality>3</changeModeAtTotalTendQuality>
      </li>
      <li Class="XylXenos.HediffCompProperties_GiveHediffExt">
        <hediffs>
          <li>
            <mtbDays>15</mtbDays>
            <hediff>XylPetrified</hediff>
            <severityRange>0.05~0.2</severityRange>
            <canAffectAnyLivePart>true</canAffectAnyLivePart>
          </li>
          <li>
            <mtbDays>5</mtbDays>
            <minSeverity>0.4</minSeverity>
            <hediff>XylPetrified</hediff>
            <severityRange>0.1~0.4</severityRange>
            <canAffectAnyLivePart>true</canAffectAnyLivePart>
          </li>
        </hediffs>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <painOffset>0.1</painOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>major</label>
        <painOffset>0.2</painOffset>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <painOffset>0.4</painOffset>
        <lifeThreatening>true</lifeThreatening>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>XylPetrified</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>petrified</label>
    <labelNoun>petrified flesh</labelNoun>
    <description>This body part has been partially replaced with hard, rocky growths. They must be surgically removed to allow the part to heal.</description>
    <descriptionHyperlinks>
      <GeneDef>XylPetrification</GeneDef>
      <HediffDef>XylPetrification</HediffDef>
    </descriptionHyperlinks>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="XylXenos.HediffCompProperties_GiveHediffExt">
        <hediffs>
          <li>
            <triggeredOnRemoval>true</triggeredOnRemoval>
            <hediff>SurgicalCut</hediff>
            <inheritSeverity>true</inheritSeverity>
            <sameBodyPart>true</sameBodyPart>
          </li>
        </hediffs>
      </li>
    </comps>
    <onlyLifeThreateningTo>
      <li>Head</li>
      <li>Brain</li>
      <li>Neck</li>
      <li>Spine</li>
      <li>Torso</li>
      <li>Heart</li>
    </onlyLifeThreateningTo>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.1</minSeverity>
        <label>minor</label>
        <partEfficiencyOffset>-0.1</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>minor</label>
        <partEfficiencyOffset>-0.2</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>minor</label>
        <partEfficiencyOffset>-0.3</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>major</label>
        <partEfficiencyOffset>-0.4</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>major</label>
        <partEfficiencyOffset>-0.5</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>major</label>
        <partEfficiencyOffset>-0.6</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>major</label>
        <partEfficiencyOffset>-0.7</partEfficiencyOffset>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <partEfficiencyOffset>-0.8</partEfficiencyOffset>
        <lifeThreatening>true</lifeThreatening>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>extreme</label>
        <partEfficiencyOffset>-0.9</partEfficiencyOffset>
        <lifeThreatening>true</lifeThreatening>
      </li>
      <li>
        <minSeverity>1.0</minSeverity>
        <label>total</label>
        <partEfficiencyOffset>-1.0</partEfficiencyOffset>
        <lifeThreatening>true</lifeThreatening>
        <overrideTooltip>This body part has been completely replaced with hard, rocky growths and no longer functions. It can be surgically removed.</overrideTooltip>
      </li>
    </stages>
    <spawnThingOnRemoved>ChunkLimestone</spawnThingOnRemoved>
  </HediffDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>XylExcisePetrifiedFlesh</defName>
    <label>excise petrified flesh</label>
    <description>Excise petrified flesh.</description>
    <workerClass>XylXenos.Recipe_RemoveHediff_Petrified</workerClass>
    <jobString>Excising petrified flesh.</jobString>
    <workAmount>3000</workAmount>
    <removesHediff>XylPetrified</removesHediff>
    <successfullyRemovedHediffMessage>{0} has successfully excised {1}'s petrified flesh.</successfullyRemovedHediffMessage>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>

</Defs>
