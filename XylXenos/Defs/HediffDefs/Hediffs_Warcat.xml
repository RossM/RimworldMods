<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>XylRetractableClaws</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>retractable claws</label>
    <description>Retractable claws. They can perform rapid slashing attacks, but are poor at penetrating armor.</description>
    <descriptionHyperlinks>
      <GeneDef>XylRetractableClaws</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>1.0</initialSeverity>
    <addedPartProps>
      <solid>true</solid>
    </addedPartProps>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>claws</label>
            <capacities>
              <li>Scratch</li>
            </capacities>
            <power>8.5</power>
            <armorPenetration>0.0</armorPenetration>
            <cooldownTime>1.2</cooldownTime>
            <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
          </li>
        </tools>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>XylFeralRage</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>feral rage</label>
    <description>A temporary frenzy state. It increases movement and melee attack speed.</description>
    <descriptionHyperlinks>
      <GeneDef>XylFeralRage</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="XylXenos.HediffCompProperties_GiveHediffExt">
        <hediffs>
          <li>
            <triggeredOnRemoval>true</triggeredOnRemoval>
            <hediff>XylFeralRageBacklash</hediff>
          </li>
        </hediffs>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <!-- This value doesn't matter, the actual duration is set by the AbilityDef -->
        <disappearsAfterTicks>15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.5</offset>
          </li>
        </capMods>
        <statFactors>
          <MeleeCooldownFactor>0.67</MeleeCooldownFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>XylFeralRageBacklash</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>feral rage (backlash)</label>
    <description>Recovering from a frenzy state. Causes pain and decreases movement speed.</description>
    <descriptionHyperlinks>
      <GeneDef>XylFeralRage</GeneDef>
    </descriptionHyperlinks>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
         <!--12 hours--> 
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
        <painOffset>0.1</painOffset>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>XylMoody</defName>
    <label>moody</label>
    <description>This character is genetically predisposed to severely fluctuating moods.</description>
    <descriptionHyperlinks>
      <GeneDef>XylMoody</GeneDef>
    </descriptionHyperlinks>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <!-- 8~16 hours -->
        <disappearsAfterTicks>20000~40000</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_GiveRandomSituationalThought">
        <thoughtDefs>
          <li>XylMoody_Up</li>
          <li>XylMoody_Down</li>
        </thoughtDefs>
      </li>
    </comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>XylGeneticMeatNeed</defName>
    <label>raw meat dependency</label>
    <description>This individual is unable to synthesize certain essential nutrients and must obtain them by eating raw meat. Without it, their health and mood will steadily decline, leading to pain, muscle weakness, mental instability, coma, and eventually death.</description>
    <hediffClass>XylXenos.Hediff_DietDependency</hediffClass>
    <descriptionHyperlinks>
      <GeneDef>XylMeatDependence</GeneDef>
    </descriptionHyperlinks>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0</initialSeverity>
    <maxSeverity>15</maxSeverity>
    <lethalSeverity>15</lethalSeverity>
    <allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.001</minSeverity>
        <becomeVisible>true</becomeVisible>
      </li>
      <li>
        <label>craving</label>
        <minSeverity>1</minSeverity>
      </li>
      <li>
        <label>mild deficiency</label>
        <minSeverity>2.5</minSeverity>
        <painOffset>0.1</painOffset>
        <mentalStateGivers>
          <li>
            <mentalState>XylHuntingVermin</mentalState>
            <mtbDays>0.5</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <label>severe deficiency</label>
        <minSeverity>5</minSeverity>
        <painOffset>0.5</painOffset>
        <mentalBreakMtbDays>1.0</mentalBreakMtbDays>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>XylHuntingVermin</mentalState>
            <mtbDays>0.5</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <label>coma</label>
        <minSeverity>7.5</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.5</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
        </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0.5</severityPerDay>
        <minAge>13</minAge>
      </li>
    </comps>
  </HediffDef>

</Defs>