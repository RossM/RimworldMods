<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <ThinkTreeDef>
    <defName>XylCastPsycast</defName>
    <insertTag>Humanlike_PostMentalState</insertTag>
    <insertPriority>0</insertPriority>
    <thinkRoot Class="ThinkNode_ConditionalColonist">
      <invert>true</invert>
      <subNodes>
        <li Class="ThinkNode_ConditionalUnderCombatPressure">
          <maxThreatDistance>45</maxThreatDistance>
          <minCloseTargets>1</minCloseTargets>
          <subNodes>

            <!-- Defensive behaviors -->
            <li Class="ThinkNode_Priority">
              <subNodes>

                <!-- Chaos skip on self -->
                <li Class="XylXenos.ThinkNode_ConditionalHasGene" MayRequire="Ludeon.RimWorld.Royalty">
                  <gene>XylPsycast_ChaosSkip</gene>
                  <subNodes>
                    <li Class="ThinkNode_ConditionalUnderCombatPressure">
                      <maxThreatDistance>2</maxThreatDistance>
                      <minCloseTargets>2</minCloseTargets>
                      <subNodes>
                        <li Class="JobGiver_AICastAbilityOnSelf">
                          <ability>ChaosSkip</ability>
                        </li>
                      </subNodes>
                    </li>
                  </subNodes>
                </li>

              </subNodes>
            </li>

            <!-- High priority buffs -->
            <li Class="ThinkNode_Random">
              <subNodes>

                <!-- Focus on self -->
                <li Class="XylXenos.ThinkNode_ConditionalHasGene" MayRequire="Ludeon.RimWorld.Royalty">
                  <gene>XylPsycast_Focus</gene>
                  <subNodes>
                    <li Class="ThinkNode_ConditionalAbilityCastLastTick">
                      <ability>Focus</ability>
                      <maxTicksAgo>60</maxTicksAgo>
                      <invert>true</invert>
                      <subNodes>
                        <li Class="XylXenos.JobGiver_AICastAbilityOnTarget">
                          <ability>Focus</ability>
                          <targetSelf>true</targetSelf>
                        </li>
                      </subNodes>
                    </li>
                  </subNodes>
                </li>

              </subNodes>
            </li>

            <!-- Buffs and offensive behaviors -->
            <li Class="ThinkNode_Random">
              <subNodes>

                <!-- Focus on ally -->
                <li Class="XylXenos.ThinkNode_ConditionalHasGene" MayRequire="Ludeon.RimWorld.Royalty">
                  <gene>XylPsycast_Focus</gene>
                  <subNodes>
                    <li Class="ThinkNode_ConditionalAbilityCastLastTick">
                      <ability>Focus</ability>
                      <maxTicksAgo>60</maxTicksAgo>
                      <invert>true</invert>
                      <subNodes>
                        <li Class="XylXenos.JobGiver_AICastAbilityOnTarget">
                          <ability>Focus</ability>
                          <targetAllies>True</targetAllies>
                        </li>
                      </subNodes>
                    </li>
                  </subNodes>
                </li>

                <!-- Stun on enemy -->
                <li Class="XylXenos.ThinkNode_ConditionalHasGene" MayRequire="Ludeon.RimWorld.Royalty">
                  <gene>XylPsycast_Stun</gene>
                  <subNodes>
                    <li Class="ThinkNode_ConditionalAbilityCastLastTick">
                      <ability>Stun</ability>
                      <maxTicksAgo>60</maxTicksAgo>
                      <invert>true</invert>
                      <subNodes>
                        <li Class="XylXenos.JobGiver_AICastAbilityOnTarget">
                          <ability>Stun</ability>
                          <targetEnemies>true</targetEnemies>
                        </li>
                      </subNodes>
                    </li>
                  </subNodes>
                </li>

                <!-- Burden on enemy -->
                <li Class="XylXenos.ThinkNode_ConditionalHasGene" MayRequire="Ludeon.RimWorld.Royalty">
                  <gene>XylPsycast_Burden</gene>
                  <subNodes>
                    <li Class="ThinkNode_ConditionalAbilityCastLastTick">
                      <ability>Burden</ability>
                      <maxTicksAgo>60</maxTicksAgo>
                      <invert>true</invert>
                      <subNodes>
                        <li Class="XylXenos.JobGiver_AICastAbilityOnTarget">
                          <ability>Burden</ability>
                          <targetEnemies>true</targetEnemies>
                          <onlyTargetMelee>true</onlyTargetMelee>
                          <minDistance>8</minDistance>
                        </li>
                      </subNodes>
                    </li>
                  </subNodes>
                </li>

                <!-- Blinding pulse on enemy -->
                <li Class="XylXenos.ThinkNode_ConditionalHasGene" MayRequire="Ludeon.RimWorld.Royalty">
                  <gene>XylPsycast_BlindingPulse</gene>
                  <subNodes>
                    <li Class="ThinkNode_ConditionalAbilityCastLastTick">
                      <ability>BlindingPulse</ability>
                      <maxTicksAgo>60</maxTicksAgo>
                      <invert>true</invert>
                      <subNodes>
                        <li Class="XylXenos.JobGiver_AICastAbilityOnTarget">
                          <ability>BlindingPulse</ability>
                          <targetEnemies>true</targetEnemies>
                        </li>
                      </subNodes>
                    </li>
                  </subNodes>
                </li>

                <!-- Vertigo pulse on enemy -->
                <li Class="XylXenos.ThinkNode_ConditionalHasGene" MayRequire="Ludeon.RimWorld.Royalty">
                  <gene>XylPsycast_VertigoPulse</gene>
                  <subNodes>
                    <li Class="ThinkNode_ConditionalAbilityCastLastTick">
                      <ability>VertigoPulse</ability>
                      <maxTicksAgo>60</maxTicksAgo>
                      <invert>true</invert>
                      <subNodes>
                        <li Class="XylXenos.JobGiver_AICastAbilityOnTarget">
                          <ability>VertigoPulse</ability>
                          <targetEnemies>true</targetEnemies>
                        </li>
                      </subNodes>
                    </li>
                  </subNodes>
                </li>

                <!-- Chaos skip on enemy in cover -->
                <li Class="XylXenos.ThinkNode_ConditionalHasGene" MayRequire="Ludeon.RimWorld.Royalty">
                  <gene>XylPsycast_ChaosSkip</gene>
                  <subNodes>
                    <li Class="ThinkNode_ConditionalAbilityCastLastTick">
                      <ability>ChaosSkip</ability>
                      <maxTicksAgo>300</maxTicksAgo>
                      <invert>true</invert>
                      <subNodes>
                        <li Class="XylXenos.JobGiver_AICastAbilityOnTarget">
                          <ability>ChaosSkip</ability>
                          <targetEnemies>true</targetEnemies>
                          <onlyTargetMelee>true</onlyTargetMelee>
                          <onlyInCover>true</onlyInCover>
                        </li>
                      </subNodes>
                    </li>
                  </subNodes>
                </li>

                <!-- Beckon on enemy in cover -->
                <li Class="XylXenos.ThinkNode_ConditionalHasGene" MayRequire="Ludeon.RimWorld.Royalty">
                  <gene>XylPsycast_Beckon</gene>
                  <subNodes>
                    <li Class="ThinkNode_ConditionalAbilityCastLastTick">
                      <ability>Beckon</ability>
                      <maxTicksAgo>300</maxTicksAgo>
                      <invert>true</invert>
                      <subNodes>
                        <li Class="XylXenos.JobGiver_AICastAbilityOnTarget">
                          <ability>Beckon</ability>
                          <onlyTargetMelee>true</onlyTargetMelee>
                          <onlyInCover>true</onlyInCover>
                        </li>
                      </subNodes>
                    </li>
                  </subNodes>
                </li>
                
                <!-- TODO Skip -->
                <!-- TODO Smokepop -->
                <!-- TODO Waterskip -->

              </subNodes>
            </li>

          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

</Defs>
