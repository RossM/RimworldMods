<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <ResearchProjectDef>
    <defName>XylLithoidDrugs</defName>
    <label>lithoid drugs</label>
    <description>Produce lithoid-specific drugs: softener, which can prevent petrification before it starts, and crystal, a highly addictive stimulant.</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>DrugProduction</li>
    </prerequisites>
    <researchViewX>4.00</researchViewX>
    <researchViewY>0.70</researchViewY>
    <generalRules>
      <rulesStrings>
        <li>subject->lithoid drug production</li>

        <li>subject_story->researched carbon-silicate nanocomposites</li>
        <li>subject_story->ran Nova Leon's largest producer of industrial chemicals</li>
        <li>subject_story->participated in the reclaimation of Paracron VI</li>

        <li>subject_gerund->synthesizing lithoid drugs</li>
      </rulesStrings>
    </generalRules>
  </ResearchProjectDef>

  <ThingDef ParentName="MakeableDrugPillBase">
    <defName>XylSoftener</defName>
    <label>softener</label>
    <description>A drug for preventing petrification before it takes hold. Must be taken every five days to remain effective.\n\nThis drug only prevents petrification from developing. It has no effect on an existing disease.</description>
    <descriptionHyperlinks>
      <HediffDef>XylSoftenerHigh</HediffDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Xyl/Things/Item/Drug/Softener</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <socialPropernessMatters>false</socialPropernessMatters>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToMake>1200</WorkToMake>
      <MarketValue>55</MarketValue>
      <Mass>0.005</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <techLevel>Industrial</techLevel>
    <ingestible>
      <drugCategory>Medical</drugCategory>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>XylSoftenerHigh</hediffDef>
          <severity>1.0</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <recipeMaker>
      <researchPrerequisite>XylLithoidDrugs</researchPrerequisite>
      <recipeUsers>
        <li>DrugLab</li>
      </recipeUsers>
      <displayPriority>3000</displayPriority>
    </recipeMaker>
    <costList>
      <Neutroamine>4</Neutroamine>
    </costList>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>XylSoftener</chemical>
        <listOrder>2000</listOrder>
        <overdoseSeverityOffset>0.08~0.14</overdoseSeverityOffset>
      </li>
    </comps>
  </ThingDef>

  <ChemicalDef>
    <defName>XylSoftener</defName>
    <label>softener</label>
    <canBinge>false</canBinge>
    <canBeAddicted>false</canBeAddicted>
    <generateAddictionGenes>false</generateAddictionGenes>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Chemical">
        <requiredGenesAll>
          <li>XylLithoid</li>
          <li>XylPetrification</li>
        </requiredGenesAll>
      </li>
    </modExtensions>
  </ChemicalDef>

  <HediffDef>
    <defName>XylSoftenerHigh</defName>
    <hediffClass>Hediff_High</hediffClass>
    <label>softener</label>
    <description>Softener-induced immunity to petrification. This drug only prevents petrification from developing. It has no effect on an existing disease, even if it is currently dormant.</description>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.18</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <makeImmuneTo>
          <li>XylPetrification</li>
        </makeImmuneTo>
      </li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="DrugPillBase">
    <defName>XylAtlasite</defName>
    <label>atlasite</label>
    <description>A concoction of atlas mechanites specifically designed for lithoids. A dose every three days will provide slight improvements in mood and performance. As long as the user continues taking atlasite regularly, the mechanites will gradually saturate their system, remaking it to be resistant to damage and hostile environments. However, even a single missed dose will disrupt the mechanites and rapidly reset the saturation process.</description>
    <descriptionHyperlinks>
      <HediffDef>XylAtlasiteHigh</HediffDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Xyl/Things/Item/Drug/Atlasite</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.75</drawSize>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>70</MarketValue>
      <Mass>0.01</Mass>
    </statBases>
    <techLevel>Ultra</techLevel>
    <minRewardCount>10</minRewardCount>
    <ingestible>
      <drugCategory>Medical</drugCategory>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>XylAtlasiteHigh</hediffDef>
          <severity>1.0</severity>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>XylAtlasiteSaturation</hediffDef>
          <severity>0.001</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>XylAtlasite</chemical>
        <isCombatEnhancingDrug>true</isCombatEnhancingDrug>
        <listOrder>2200</listOrder>
      </li>
    </comps>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardCore</li>
    </thingSetMakerTags>
    <allowedArchonexusCount>50</allowedArchonexusCount>
  </ThingDef>

  <ChemicalDef>
    <defName>XylAtlasite</defName>
    <label>atlasite</label>
    <canBinge>false</canBinge>
    <canBeAddicted>false</canBeAddicted>
    <generateAddictionGenes>false</generateAddictionGenes>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Chemical">
        <requiredGenesAll>
          <li>XylLithoid</li>
        </requiredGenesAll>
      </li>
    </modExtensions>
  </ChemicalDef>

  <HediffDef>
    <defName>XylAtlasiteHigh</defName>
    <label>atlasite</label>
    <labelNoun>atlasite</labelNoun>
    <description>Atlas mechanites in the body. They provide slight benefits to mood and performance, and increase atlasite saturation gradually over time.</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.3</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.1</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.1</offset>
          </li>
        </capMods>
        <statFactors>
          <RestFallRateFactor>0.8</RestFallRateFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>XylAtlasiteHigh</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>XylAtlasiteHigh</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>atlasite buzz</label>
        <description>I feel warm and tingly.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <HediffDef>
    <defName>XylAtlasiteSaturation</defName>
    <label>atlasite saturation</label>
    <labelNoun>accumulated atlasite</labelNoun>
    <description>Accumulated effects of atlas mechanites in the body. They gradually remake the body to be tougher against all sorts of dangers. The saturation will rapidly decline if there are no atlas mechanites active.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <initialSeverity>0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="XylXenos.HediffCompProperties_Saturation">
        <sourceHediff>XylAtlasiteHigh</sourceHediff>
        <severityGainPerDay>0.033</severityGainPerDay>
        <severityLossPerDay>-0.5</severityLossPerDay>
      </li>
    </comps>
    <stages>
      <li>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <ComfyTemperatureMin>-5</ComfyTemperatureMin>
          <ComfyTemperatureMax>5</ComfyTemperatureMax>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.1</VacuumResistance>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
          <ComfyTemperatureMin>-10</ComfyTemperatureMin>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.2</VacuumResistance>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <statOffsets>
          <ComfyTemperatureMin>-20</ComfyTemperatureMin>
          <ComfyTemperatureMax>20</ComfyTemperatureMax>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.3</VacuumResistance>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.9</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <ComfyTemperatureMin>-50</ComfyTemperatureMin>
          <ComfyTemperatureMax>50</ComfyTemperatureMax>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.55</VacuumResistance>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.7</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.99</minSeverity>
        <statOffsets>
          <ComfyTemperatureMin>-100</ComfyTemperatureMin>
          <ComfyTemperatureMax>100</ComfyTemperatureMax>
          <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.95</VacuumResistance>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.5</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="MakeableDrugBase">
    <defName>XylCrystal</defName>
    <label>crystal</label>
    <description>A lithoid-specific drug that causes euphoria, heightens performance, and deadens pain. It's highly addictive.</description>
    <descriptionHyperlinks>
      <HediffDef>XylCrystalHigh</HediffDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Xyl/Things/Item/Drug/Crystal</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.6,0.55,1.0)</color>
    </graphicData>
    <socialPropernessMatters>false</socialPropernessMatters>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToMake>550</WorkToMake>
      <MarketValue>26</MarketValue>
      <Mass>0.005</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <techLevel>Industrial</techLevel>
    <ingestible>
      <foodType>Processed</foodType>
      <joyKind>Chemical</joyKind>
      <joy>0.80</joy>
      <drugCategory>Hard</drugCategory>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>XylCrystalHigh</hediffDef>
          <severity>0.75</severity>
          <toleranceChemical>XylCrystal</toleranceChemical>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>XylCrystalTolerance</hediffDef>
          <toleranceChemical>XylCrystal</toleranceChemical>
          <severity>0.040</severity>
          <divideByBodySize>true</divideByBodySize>
          <multiplyByGeneToleranceFactors>true</multiplyByGeneToleranceFactors>
        </li>
      </outcomeDoers>
    </ingestible>
    <recipeMaker IsNull="true" />
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>XylCrystal</chemical>
        <addictiveness>0.02</addictiveness>
        <existingAddictionSeverityOffset>0.40</existingAddictionSeverityOffset>
        <needLevelOffset>0.9</needLevelOffset>
        <listOrder>2100</listOrder>
        <overdoseSeverityOffset>0.08~0.14</overdoseSeverityOffset>
      </li>
    </comps>
  </ThingDef>
  
