<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <FactionDef ParentName="TribeSavageBase">
    <defName>XylTribeSavageTrog</defName>
    <label>savage trog tribe</label>
    <pawnSingular>trog</pawnSingular>
    <pawnsPlural>trogs</pawnsPlural>
    <description>A collection of warlike xenohuman tribes dominated by hideous trogs. Belligerent and insular, they refuse all dealings with outsiders. They may be primitive, but their ability to tame and control giant insects makes them a serious threat.\n\nTrogs are found across the rimworlds, the mutated descendants of interbreeding between countless xenohuman lineages in barely survivable conditions. What they lack in intelligence, they make up for in brute strength and sheer tenacity.</description>
    <factionIconPath>Xyl/World/WorldObjects/Expanding/VillageTrog</factionIconPath>
    <xenotypeSet Inherit="False" Class="XylXenos.XenotypeSetWithDefault">
      <defaultXenotype>XylTrog</defaultXenotype>
      <xenotypeChances>
        <Baseliner>0.025</Baseliner>
        <Dirtmole>0.1</Dirtmole>
        <Impid>0.025</Impid>
        <Neanderthal>0.1</Neanderthal>
        <Pigskin>0.025</Pigskin>
        <Waster>0.1</Waster>
        <Yttakin>0.025</Yttakin>
        <XylBossaps>0.025</XylBossaps>
        <XylChyrr>0.01</XylChyrr>
        <XylDvergr>0.025</XylDvergr>
        <XylNixie>0.025</XylNixie>
        <XylWarcat>0.025</XylWarcat>
      </xenotypeChances>
    </xenotypeSet>
    <colorSpectrum Inherit="false">
      <li>(0.3, 0.5, 0.125)</li>
      <li>(0.45, 0.35, 0)</li>
    </colorSpectrum>
    <factionNameMaker>XylNamerFactionTribalTrog</factionNameMaker>
    <settlementNameMaker>XylNamerSettlementTribalTrog</settlementNameMaker>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>50</configurationListOrderPriority>
    <permanentEnemy>true</permanentEnemy>
    <apparelStuffFilter Inherit="false">
      <stuffCategoriesToAllow>
        <li>Metallic</li>
        <li>Leathery</li>
        <li>Woody</li>
      </stuffCategoriesToAllow>
    </apparelStuffFilter>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
    </requiredMemes>
    <disallowedMemes IsNull="True"/>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Darkness</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HighLife</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
    </allowedMemes>
    <pawnGroupMakers Inherit="False">
      <li>
        <!-- Normal fights, ranged with melee mix-ins -->
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <Tribal_Penitent>5</Tribal_Penitent>
          <Tribal_Warrior>5</Tribal_Warrior>
          <Tribal_Archer>5</Tribal_Archer>
          <Tribal_Hunter>5</Tribal_Hunter>
          <Tribal_HeavyArcher>5</Tribal_HeavyArcher>
          <Tribal_Berserker>5</Tribal_Berserker>
          <Tribal_ChiefRanged>1.5</Tribal_ChiefRanged>
          <Tribal_ChiefMelee>1.5</Tribal_ChiefMelee>
          <Megascarab>10</Megascarab>
          <Spelopede>10</Spelopede>
          <Megaspider>5</Megaspider>
        </options>
      </li>
      <li>
        <!-- Normal fights, melee only -->
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <Tribal_Penitent>10</Tribal_Penitent>
          <Tribal_Warrior>10</Tribal_Warrior>
          <Tribal_Berserker>10</Tribal_Berserker>
          <Tribal_ChiefMelee>5</Tribal_ChiefMelee>
          <Megascarab>10</Megascarab>
          <Spelopede>10</Spelopede>
          <Megaspider>5</Megaspider>
        </options>
      </li>
      <li>
        <!-- breach-capable fights, breachers plus ranged with melee mix-ins -->
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <Tribal_Breacher>5</Tribal_Breacher>
          <Tribal_Penitent>5</Tribal_Penitent>
          <Tribal_Warrior>5</Tribal_Warrior>
          <Tribal_Archer>5</Tribal_Archer>
          <Tribal_Hunter>5</Tribal_Hunter>
          <Tribal_HeavyArcher>5</Tribal_HeavyArcher>
          <Tribal_Berserker>5</Tribal_Berserker>
          <Tribal_ChiefRanged>1.5</Tribal_ChiefRanged>
          <Tribal_ChiefMelee>1.5</Tribal_ChiefMelee>
          <Megascarab>10</Megascarab>
          <Spelopede>10</Spelopede>
          <Megaspider>5</Megaspider>
        </options>
      </li>
      <li>
        <!-- Peaceful -->
        <kindDef>Peaceful</kindDef>
        <options>
          <Tribal_Warrior>20</Tribal_Warrior>
          <Tribal_Child MayRequire="Ludeon.RimWorld.Biotech">10</Tribal_Child>
          <Tribal_Archer>10</Tribal_Archer>
          <Tribal_Hunter>10</Tribal_Hunter>
          <Tribal_HeavyArcher>10</Tribal_HeavyArcher>
          <Tribal_Berserker>5</Tribal_Berserker>
          <Tribal_ChiefRanged>1.5</Tribal_ChiefRanged>
          <Tribal_ChiefMelee>1.5</Tribal_ChiefMelee>
          <Megascarab>5</Megascarab>
          <Spelopede>1</Spelopede>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Tribal_Trader>1</Tribal_Trader>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
          <Alpaca>2.5</Alpaca>
          <Elephant>2</Elephant>
        </carriers>
        <guards>
          <Tribal_Warrior>10</Tribal_Warrior>
          <Tribal_Archer>5</Tribal_Archer>
          <Tribal_Hunter>5</Tribal_Hunter>
          <Tribal_HeavyArcher>5</Tribal_HeavyArcher>
          <Tribal_Berserker>10</Tribal_Berserker>
          <Megascarab>5</Megascarab>
          <Spelopede>1</Spelopede>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Tribal_Warrior>10</Tribal_Warrior>
          <Tribal_Archer>5</Tribal_Archer>
          <Tribal_Hunter>5</Tribal_Hunter>
          <Tribal_HeavyArcher>5</Tribal_HeavyArcher>
          <Tribal_Berserker>10</Tribal_Berserker>
          <Tribal_ChiefRanged>5</Tribal_ChiefRanged>
          <Tribal_ChiefMelee>5</Tribal_ChiefMelee>
          <Megascarab>10</Megascarab>
          <Spelopede>10</Spelopede>
          <Megaspider>5</Megaspider>
        </options>
      </li>
      <li>
        <kindDef>Settlement_RangedOnly</kindDef>
        <options>
          <Tribal_Archer>10</Tribal_Archer>
          <Tribal_Hunter>10</Tribal_Hunter>
          <Tribal_HeavyArcher>10</Tribal_HeavyArcher>
          <Tribal_ChiefRanged>10</Tribal_ChiefRanged>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Miners</kindDef>
        <commonality>1</commonality>
        <options>
          <Tribal_Miner>1</Tribal_Miner>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Hunters</kindDef>
        <commonality>1</commonality>
        <options>
          <Tribal_Hunter>1</Tribal_Hunter>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Loggers</kindDef>
        <commonality>1</commonality>
        <options>
          <Tribal_Logger>1</Tribal_Logger>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Farmers</kindDef>
        <commonality>1</commonality>
        <options>
          <Tribal_Farmer>1</Tribal_Farmer>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Faction">
        <nearbyPollution>0.01 ~ 9999</nearbyPollution>
      </li>
    </modExtensions>
  </FactionDef>

</Defs>
