<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <FactionDef ParentName="TribeRoughBase">
    <defName>XylTribeCannibalWarcat</defName>
    <label>cannibal warcat tribe</label>
    <pawnSingular>warcat</pawnSingular>
    <pawnsPlural>warcats</pawnsPlural>
    <description>A loose confederation of roaming warcat hunting bands, descended from soldiers grown in gene-vats. Driven by their need for raw meat, they hunt whatever they can overpower with their razor-sharp claws. Successful hunters hang the skulls of eaten enemies from their belts.\n\nWin their friendship and they’ll put those claws to work for you, though sharing a battlefield with them is easier than sharing the victory feast.</description>
    <factionIconPath>Xyl/World/WorldObjects/Expanding/VillageWarcat</factionIconPath>
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <XylWarcat>999</XylWarcat>
      </xenotypeChances>
    </xenotypeSet>
    <colorSpectrum Inherit="false">
      <li>(0.85, 0.55, 0)</li>
      <li>(0.9, 0.8, 0.3)</li>
    </colorSpectrum>
    <factionNameMaker>NamerXylFactionTribalWarcat</factionNameMaker>
    <settlementNameMaker>NamerXylSettlementTribalWarcat</settlementNameMaker>
    <replacesFaction MayRequire="Ludeon.Rimworld.Ideology">TribeCannibal</replacesFaction>
    <naturalEnemy>true</naturalEnemy>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
    </requiredMemes>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Individualist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
    </allowedMemes>
    <disallowedMemes IsNull="true"/>
    <raidLootMaker>XylWarcatRaidLootMaker</raidLootMaker>
  </FactionDef>

  <ThingSetMakerDef>
    <defName>XylWarcatRaidLootMaker</defName>
    <debugParams>
      <totalMarketValueRange>250</totalMarketValueRange>
    </debugParams>
    <root Class="ThingSetMaker_Sum">
      <resolveInOrder>true</resolveInOrder>
      <options>
        <li>
          <chance>0.2</chance>
          <thingSetMaker Class="ThingSetMaker_Count">
            <fixedParams>
              <countRange>1~3</countRange>
              <filter>
                <thingDefs>
                  <li>Skull</li>
                </thingDefs>
              </filter>
            </fixedParams>
          </thingSetMaker>
        </li>
        <li>
          <thingSetMaker Class="ThingSetMaker_MarketValue">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li>Silver</li>
                  <li>Jade</li>
                  <li>MedicineHerbal</li>
                  <li>Pemmican</li>
                  <li>Leather_Human</li>
                </thingDefs>
              </filter>
            </fixedParams>
          </thingSetMaker>
        </li>
      </options>
    </root>
  </ThingSetMakerDef>

</Defs>
