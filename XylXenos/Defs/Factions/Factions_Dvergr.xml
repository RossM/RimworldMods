<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <FactionDef ParentName="OutlanderRoughBase">
    <defName>XylOutlanderRoughDvergr</defName>
    <label>rough dvergr union</label>
    <pawnSingular>dvergr</pawnSingular>
    <pawnsPlural>dvergr</pawnsPlural>
    <description>A loose confederation of settlements primarily consisting of alcohol-loving dvergr. They're unruly and hard to please, but if you manage to win them over they can become powerful allies.\n\nDvergr originate from the mineral world Svartalfheim, where they've built vast underground cities powered by the planet's many magma upwellings.</description>
    <factionIconPath>Xyl/World/WorldObjects/Expanding/TownDvergr</factionIconPath>
    <xenotypeSet Inherit="False" Class="XylXenos.XenotypeSetWithDefault">
      <defaultXenotype>XylDvergr</defaultXenotype>
      <xenotypeChances>
        <Baseliner>0.1</Baseliner>
        <Dirtmole>0.15</Dirtmole>
        <Genie>0.01</Genie>
        <Hussar>0.05</Hussar>
        <Impid>0.025</Impid>
        <Neanderthal>0.025</Neanderthal>
        <Pigskin>0.025</Pigskin>
        <Waster>0.025</Waster>
        <Yttakin>0.025</Yttakin>
        <XylTitan>0.05</XylTitan>
        <XylTrog>0.025</XylTrog>
      </xenotypeChances>
    </xenotypeSet>
    <colorSpectrum Inherit="false">
      <li>(0.5, 0.3, 0.2)</li>
      <li>(0.45, 0.40, 0.35)</li>
    </colorSpectrum>
    <factionNameMaker>XylNamerFactionOutlanderDvergr</factionNameMaker>
    <settlementNameMaker>XylNamerSettlementOutlanderDvergr</settlementNameMaker>
    <apparelStuffFilter Inherit="false">
      <stuffCategoriesToAllow>
        <li>Metallic</li>
        <li>Leathery</li>
      </stuffCategoriesToAllow>
      <thingDefs>
        <li>DevilstrandCloth</li>
      </thingDefs>
    </apparelStuffFilter>
    <allowedCultures Inherit="false">
      <li>XylNorisk</li>
    </allowedCultures>
    <requiredMemes Inherit="false">
      <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
    </requiredMemes>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Bloodfeeding</li>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Inhuman</li>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Ritualist</li>
    </disallowedMemes>
    <raidLootMaker>XylDvergrRaidLootMaker</raidLootMaker>
    <modExtensions>
      <li Class="XylXenos.DefModExtension_Faction">
        <allowedHilliness>
          <li>LargeHills</li>
          <li>Mountainous</li>
        </allowedHilliness>
      </li>
    </modExtensions>
  </FactionDef>

  <ThingSetMakerDef>
    <defName>XylDvergrRaidLootMaker</defName>
    <debugParams>
      <totalMarketValueRange>250</totalMarketValueRange>
    </debugParams>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>Gold</li>
            <li>Jade</li>
            <li>Uranium</li>
            <li>Plasteel</li>
            <li>DevilstrandCloth</li>
            <li>MedicineIndustrial</li>
            <li>ComponentIndustrial</li>
            <li>MealSurvivalPack</li>
            <li>Beer</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>

  <CultureDef>
