<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <RulePackDef Name="XylNamerPersonChyrrBase" Abstract="True">
    <rulePack>
      <rulesStrings>
        <li>r_name->[firstName] [lastName]</li>
        <li>r_name(p=3)->[firstName] '[nickName]' [lastName]</li>

        <li>firstName->[consonant]'[consonant][vowel]</li>

        <li>lastName->[SylStart][SylEnd][nameEnd]</li>
        <li>lastName(p=0.2)->[SylStart][SylStart][SylEnd][nameEnd]</li>

        <li>consonant->b</li>
        <li>consonant->ch</li>
        <li>consonant->d</li>
        <li>consonant->g</li>
        <li>consonant->k</li>
        <li>consonant->n</li>
        <li>consonant->q</li>
        <li>consonant->sk</li>
        <li>consonant->t</li>
        <li>consonant->z</li>
        <li>vowel->ah</li>
        <li>vowel->ee</li>
        <li>vowel->eh</li>
        <li>vowel->oh</li>
        <li>vowel->u</li>
        <li>vowel->ua</li>

        <li>nameEnd->ops</li>
        <li>nameEnd->us</li>
        <li>nameEnd->a</li>
        <li>nameEnd->yx</li>
        <li>nameEnd->is</li>
        <li>nameEnd->um</li>
        <li>nameEnd->essa</li>
        <li>nameEnd->sa</li>
        <li>nameEnd->io</li>
        <li>nameEnd->ia</li>
        <li>nameEnd->or</li>
        <li>nameEnd->ax</li>
        <li>nameEnd->ens</li>
        <li>nameEnd->lopex</li>
        <li>nameEnd->os</li>
        <li>nameEnd->on</li>
        <li>nameEnd->ias</li>
        <li>nameEnd->ugo</li>

      </rulesStrings>
      <rulesFiles>
        <li>SylStart->Xyl/WordParts/Syllables_Starts_Chyrr</li>
        <li>SylEnd->Xyl/WordParts/Syllables_Ends_Chyrr</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

  <RulePackDef ParentName="XylNamerPersonChyrrBase">
    <defName>XylNamerPersonChyrrMale</defName>
    <rulePack>
      <rulesStrings>
        <li>nickName->[PersonJob]</li>
        <li>nickName->[Color]</li>
        <li>nickName->[AdjectiveAny]</li>
        <li>nickName->[ConceptAny]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef ParentName="XylNamerPersonChyrrBase">
    <defName>XylNamerPersonChyrrFemale</defName>
    <rulePack>
      <rulesStrings>
        <li>nickName->[NaturalObject]</li>
        <li>nickName->[TreeType]</li>
        <li>nickName->[TerrainFeature]</li>
        <li>nickName->[Vegetable]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

</Defs>
