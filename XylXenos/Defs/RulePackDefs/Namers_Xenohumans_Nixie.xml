<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <RulePackDef>
    <defName>NamerXylPersonNixie</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[firstName] [lastName]</li>
        <li>r_name->[firstName] '[nickName]' [lastName]</li>

        <li>firstName->[SylG]-[SylG]</li>
        <li>firstName->[SylG][SylG]-[SylG]</li>

        <li>lastName->[SylG][suffix]</li>
        <li>lastName->[SylG][SylG][suffix]</li>

        <li>nickName->[adjective]</li>
        <li>nickName->[animal]</li>
      </rulesStrings>
      <rulesFiles>
        <li>adjective->Xyl/Words/Nixie/Adjectives</li>
        <li>animal->Xyl/Words/Nixie/Animals</li>
        <li>suffix->Xyl/WordParts/Nixie/Name_Suffixes</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

</Defs>
