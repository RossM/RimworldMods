<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <RulePackDef>
    <defName>NamerXylPersonTrog</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[firstName] [lastName]</li>

        <li>firstName->[consonant1][vowel][consonant2]</li>

        <li>lastName(p=2)->[Color][BodyPart]</li>
        <li>lastName->[weapon][BodyPart]</li>
        <li>lastName->[Color][weapon]</li>
      </rulesStrings>
      <rulesFiles>
        <li>weapon->Xyl/Words/Trog/Weapons</li>
        <li>consonant1->Xyl/WordParts/Trog/Consonants_1</li>
        <li>consonant2->Xyl/WordParts/Trog/Consonants_2</li>
        <li>vowel->Xyl/WordParts/Trog/Vowels</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

</Defs>
