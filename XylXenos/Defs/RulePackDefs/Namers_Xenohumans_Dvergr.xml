<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <RulePackDef>
    <defName>NamerXylPersonDvergr</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[firstName] [lastName]</li>
        <li>r_name->[firstName] '[nickName]' [lastName]</li>

        <li>firstName->[syl][syl]</li>

        <li>lastName->[syl][syl][syl]</li>

        <li>nickName->[nick1][nick2]</li>
        <li>nickName(p=0.1)->[nickFull]</li>
      </rulesStrings>
      <rulesFiles>
        <li>syl->Xyl/WordParts/Dvergr/Syllables</li>
        <li>nick1->Xyl/Names/Dvergr/Nicks_1</li>
        <li>nick2->Xyl/Names/Dvergr/Nicks_2</li>
        <li>nickFull->Xyl/Names/Dvergr/Nicks_Full</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

</Defs>
