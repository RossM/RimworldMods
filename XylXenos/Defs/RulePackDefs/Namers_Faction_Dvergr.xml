<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <RulePackDef>
    <defName>XylNamerFactionOutlanderDvergr</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[AdjectiveBadass] [adjective] [groupName]</li>
        <li>r_name->[Syl][Syl] [adjective] [groupName]</li>
      </rulesStrings>
      <rulesFiles>
        <li>syl->Xyl/WordParts/Dvergr/Syllables</li>
        <li>adjective->Xyl/Words/Dvergr/Adjectives</li>
        <li>groupName->Xyl/Words/Dvergr/Group_Names</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>XylNamerSettlementOutlanderDvergr</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->fort [nameCore]</li>
        <li>r_name->[nameCore] [locationFeature]</li>

        <li>maybeHyphen(p=3)-></li>
        <li>maybeHyphen->-</li>

        <li>nameCore->[syl][suffix]</li>
        <li>nameCore->[syl][syl][maybeHyphen][suffix]</li>

      </rulesStrings>
      <rulesFiles>
        <li>syl->Xyl/WordParts/Dvergr/Syllables</li>
        <li>suffix->Xyl/WordParts/Dvergr/Place_Suffixes</li>
        <li>locationFeature->Xyl/Words/Dvergr/Location_Features</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

</Defs>
