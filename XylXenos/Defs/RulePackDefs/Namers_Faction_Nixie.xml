<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <RulePackDef>
    <defName>XylNamerFactionTribalNixie</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[adjective] [animal] of [nameCore]</li>
        <li>r_name->[nameCore] [animal] [groupName]</li>
        <li>r_name->[nameCore] [locationFeature] [groupName]</li>

        <li>maybeHyphen(p=3)-></li>
        <li>maybeHyphen->-</li>

        <li>nameCore->[SylG][maybeHyphen][SylG]</li>
        <li>nameCore->[SylG][maybeHyphen][SylG][maybeHyphen][SylG]</li>
      </rulesStrings>
      <rulesFiles>
        <li>adjective->Xyl/Words/Nixie/Adjectives</li>
        <li>animal->Xyl/Words/Nixie/Animals</li>
        <li>locationFeature->Xyl/Words/Nixie/Location_Features</li>
        <li>groupName->Xyl/Words/Nixie/Group_Names</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>XylNamerSettlementTribalNixie</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[nameCore] [coastalFeature]</li>
        <li>r_name->[coastalFeature] of [nameCore]</li>
        <li>r_name(p=0.2)->[nameCore]-by-the-[coastalFeature]</li>

        <li>maybeHyphen(p=3)-></li>
        <li>maybeHyphen->-</li>

        <li>nameCore->[SylG][maybeHyphen][SylG]</li>
        <li>nameCore->[SylG][maybeHyphen][SylG][maybeHyphen][SylG]</li>
      </rulesStrings>
      <rulesFiles>
        <li>coastalFeature->Xyl/Words/Nixie/Location_Features</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

</Defs>
