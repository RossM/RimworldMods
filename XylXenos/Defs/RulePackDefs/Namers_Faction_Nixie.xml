<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <RulePackDef>
    <defName>XylNamerFactionTribalNixie</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[aquaticAdjective] [aquaticAnimal] of [nameCore]</li>
        <li>r_name->[nameCore] [aquaticAnimal] [people]</li>
        <li>r_name->[nameCore] [coastalFeature] [people]</li>

        <li>maybeHyphen(p=3)-></li>
        <li>maybeHyphen->-</li>

        <li>nameCore->[SylG][maybeHyphen][SylG]</li>
        <li>nameCore->[SylG][maybeHyphen][SylG][maybeHyphen][SylG]</li>

        <li>people->alliance</li>
        <li>people->clan</li>
        <li>people->community</li>
        <li>people->folk</li>
        <li>people->people</li>
        <li>people->tribe</li>
      </rulesStrings>
      <rulesFiles>
        <li>aquaticAdjective->Xyl/Words/Adjectives/AquaticAdjectives</li>
        <li>aquaticAnimal->Xyl/Words/Nouns/AquaticAnimals</li>
        <li>coastalFeature->Xyl/Words/Nouns/CoastalFeatures</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>XylNamerSettlementTribalNixie</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[nameCore] [coastalFeature]</li>
        <li>r_name->[coastalFeature] of [nameCore]</li>
        <li>r_name(p=0.2)->[nameCore]-by-the-[coastalFeature]</li>

        <li>maybeHyphen(p=3)-></li>
        <li>maybeHyphen->-</li>

        <li>nameCore->[SylG][maybeHyphen][SylG]</li>
        <li>nameCore->[SylG][maybeHyphen][SylG][maybeHyphen][SylG]</li>
      </rulesStrings>
      <rulesFiles>
        <li>coastalFeature->Xyl/Words/Nouns/CoastalFeatures</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

</Defs>
