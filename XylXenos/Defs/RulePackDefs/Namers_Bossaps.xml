<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <RulePackDef Name="NamerXylPersonBossapsBase" Abstract="True">
    <include>
      <li>NamerAnimalUtility</li>
      <li>TribalWordUtility</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_name(p=2)->[firstName] [lastName]</li>
        <li>r_name->[firstName] '[nickName]' [lastName]</li>

        <li>firstName->[NameAnimalUnisex]</li>

        <li>nickName->[nickUnisex]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="XylXenos.Rule_NamePersonExt">
          <keyword>lastName</keyword>
          <slot>Last</slot>
        </li>
      </rulesRaw>
      <rulesFiles>
        <li>nickFemale->Xyl/Names/Bossaps/Nicks_Female</li>
        <li>nickMale->Xyl/Names/Bossaps/Nicks_Male</li>
        <li>nickUnisex->Xyl/Names/Bossaps/Nicks_Unisex</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

  <RulePackDef ParentName="NamerXylPersonBossapsBase">
    <defName>NamerXylPersonBossapsMale</defName>
    <rulePack>
      <rulesStrings>
        <li>firstName(p=2)->[firstNameHumanMale]</li>
        <li>firstName->[NameAnimalMale]</li>

        <li>nickName->[nickMale]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="XylXenos.Rule_NamePersonExt">
          <keyword>firstNameHumanMale</keyword>
          <gender>Male</gender>
          <slot>First</slot>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef ParentName="NamerXylPersonBossapsBase">
    <defName>NamerXylPersonBossapsFemale</defName>
    <rulePack>
      <rulesStrings>
        <li>firstName(p=2)->[firstNameHumanFemale]</li>
        <li>firstName->[NameAnimalFemale]</li>

        <li>nickName->[nickFemale]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="XylXenos.Rule_NamePersonExt">
          <keyword>firstNameHumanFemale</keyword>
          <gender>Female</gender>
          <slot>First</slot>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

</Defs>
