<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <RulePackDef Name="XylNamerPersonBossapsBase" Abstract="True">
    <include>
      <li>NamerAnimalUtility</li>
      <li>TribalWordUtility</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_name(p=2)->[firstName] [lastName]</li>
        <li>r_name->[firstName] '[nickName]' [lastName]</li>

        <li>firstName->[NameAnimalUnisex]</li>
        <li>firstName->[WordTribal]</li>

        <li>lastName->[WordTribal]</li>
        <li>lastName->[SylE][SylE]</li>

        <li>nickName->[nickUnisex]</li>
      </rulesStrings>
      <rulesFiles>
        <li>nickFemale->Xyl/Names/Bossaps/Nicks_Female</li>
        <li>nickMale->Xyl/Names/Bossaps/Nicks_Male</li>
        <li>nickUnisex->Xyl/Names/Bossaps/Nicks_Unisex</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

  <RulePackDef ParentName="XylNamerPersonBossapsBase">
    <defName>XylNamerPersonBossapsMale</defName>
    <rulePack>
      <rulesStrings>
        <li>firstName->[NameAnimalMale]</li>
        <li>firstName->[NameHumanMale]</li>

        <li>nickName->[nickMale]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef ParentName="XylNamerPersonBossapsBase">
    <defName>XylNamerPersonBossapsFemale</defName>
    <rulePack>
      <rulesStrings>
        <li>firstName->[NameAnimalFemale]</li>
        <li>firstName->[NameHumanFemale]</li>

        <li>nickName->[nickFemale]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

</Defs>
