<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>XylXenos</AssemblyName>
    <RootNamespace>XylXenos</RootNamespace>

    <Version>1.0.0.0</Version>
    <AssemblyInformationalVersion>1.0.0-alpha</AssemblyInformationalVersion>

    <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
    <PublicizerLogFilePath>../Build/Publicizer.log.txt</PublicizerLogFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="PolySharp" Version="1.16.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Assembly-CSharp:RimWorld.GameConditionManager.AllowEnjoyableOutsideNow" />
    <Publicize Include="Assembly-CSharp:RimWorld.Pawn_FlightTracker.flightCooldownTicks" />
    <Publicize Include="Assembly-CSharp:RimWorld.XenotypeSet.xenotypeChances" />
    <Publicize Include="Assembly-CSharp:Verse.HediffComp_TendDuration.totalTendQuality" />
    <Publicize Include="Assembly-CSharp:Verse.ShotReport.factorFromCoveringGas" />
    <Publicize Include="Assembly-CSharp:Verse.XmlToObjectUtils.customDataLoadMethodCache" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XylXenos.Data\XylXenos.Data.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Xylib\Xylib.csproj" />
    <ProjectReference Include="..\Xylib.Analyzer\Xylib.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisharmonySourceDirectory)' == ''">
    <PackageReference Include="Disharmony" Version="$(DisharmonyVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisharmonySourceDirectory)' != ''">
    <ProjectReference Include="$(DisharmonyProjectDirectory)Disharmony\Disharmony.csproj" AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" />
    <ProjectReference Include="$(DisharmonyProjectDirectory)Disharmony.RimWorld\Disharmony.RimWorld.csproj" AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" />
    <ProjectReference Include="$(DisharmonyProjectDirectory)Disharmony.Analyzers\Disharmony.Analyzers.csproj" AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Waylith.Injection">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Waylith.Injection.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ModDestination Include="..\ModBin\XylXenos" />
    <ModAssembly Include="Xylib.dll" />
    <ModAssembly Include="0Harmony.dll;Disharmony.dll;Disharmony.RimWorld.dll" Condition="'$(DisharmonySourceDirectory)' != ''" />
  </ItemGroup>
  <Import Project="..\ModBuild.targets" />

</Project>
