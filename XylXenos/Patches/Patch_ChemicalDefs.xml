<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>
      Defs/ChemicalDef[not(
      modExtensions/li[@Class="XylXenos.ChemicalDefExtension"] or
      defName="Luciferium"
      )]
    </xpath>
    <value>
      <modExtensions>
        <li Class="XylXenos.ChemicalDefExtension">
          <prohibitedGenes>
            <li>XylLithoid</li>
          </prohibitedGenes>
        </li>
      </modExtensions>
    </value>
  </Operation>

</Patch>
