<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <!-- 
  Most outer-layer apparel that covers the torso disables flight.
  -->
  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>
      Defs/ThingDef[
        apparel/bodyPartGroups/li = "Torso" and
        apparel/bodyPartGroups/li = "Arms" and
        apparel/layers/li = "Shell" and
        not(
          defName="Apparel_Jacket" or
          defName="Apparel_Cape"
        )
      ]
    </xpath>
    <value>
      <modExtensions>
        <li Class="XylXenos.DefModExtension_Thing_Flight">
          <allowsFlight>false</allowsFlight>
        </li>
      </modExtensions>
    </value>
  </Operation>

</Patch>
