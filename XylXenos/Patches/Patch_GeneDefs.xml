<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <!-- Display categories -->

  <Operation Class="PatchOperationReplace">
    <xpath>
      Defs/GeneDef[
      defName="StrongStomach" or
      defName="RobustDigestion"
      ]/displayCategory
    </xpath>
    <value>
      <displayCategory>XylDiet</displayCategory>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>
      Defs/GeneDef[
      @Name="GeneTailBase" or
      defName="Furskin"
      ]/displayCategory
    </xpath>
    <value>
      <displayCategory>XylBody</displayCategory>
    </value>
  </Operation>

  <!-- Exclusion tags -->

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/GeneDef[defName="RobustDigestion"]</xpath>
    <value>
      <exclusionTags>
        <li>Digestion</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/GeneDef[defName="FacialRidges"]</xpath>
    <value>
      <exclusionTags>
        <li>Face</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/GeneDef[defName="Brow_Heavy"]</xpath>
    <value>
      <exclusionTags>
        <li>Brow</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/GeneDef[@Name="GeneHairStyleBase"]</xpath>
    <value>
      <exclusionTags>
        <li>HairStyleMale</li>
        <li>HairStyleFemale</li>
      </exclusionTags>
    </value>
  </Operation>

</Patch>
