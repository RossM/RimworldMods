<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <Operation Class="XylXenos.PatchOperationMerge">
    <xpath>
      Defs/ThoughtDef[
        defName="AteCorpse" or
        defName="AteInsectMeatDirect" or
        defName="AteInsectMeatAsIngredient" or
        defName="AteHumanlikeMeatDirect" or
        defName="AteHumanlikeMeatAsIngredient"
      ]
    </xpath>
    <value>
      <nullifyingGenes>
        <li>XylCarnivoreStomach</li>
      </nullifyingGenes>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationMerge">
    <xpath>Defs/ThoughtDef[defName="SleptInBarracks"]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylHerdInstinct</li>
      </nullifyingGenes>
      <modExtensions>
        <li Class="XylXenos.DefModExtension_Thought">
          <extraThoughts>
            <li>XylSleptInBarracks_HerdInstinct</li>
          </extraThoughts>
        </li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationMerge">
    <xpath>Defs/ThoughtDef[defName="HoldingMePrisoner"]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylHerdInstinct</li>
      </nullifyingGenes>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationMerge">
    <xpath>Defs/ThoughtDef[defName="SoakingWet"]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylAquatic</li>
      </nullifyingGenes>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationMerge">
    <xpath>Defs/ThoughtDef[nullifyingGenes/li="Furskin"]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylScaleskin</li>
      </nullifyingGenes>
    </value>
  </Operation>

</Patch>
