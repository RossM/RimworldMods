<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ideology</li>
    </mods>
    <match Class="XylXenos.PatchOperationAddOrMerge">
      <xpath>Defs/ThoughtDef[starts-with(defName,"AteNonMeat_")]</xpath>
      <value>
        <nullifyingGenes>
          <li>XylHerbivoreStomach</li>
        </nullifyingGenes>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ideology</li>
    </mods>
    <match Class="XylXenos.PatchOperationAddOrMerge">
      <xpath>Defs/ThoughtDef[starts-with(defName,"AteMeat_") and stages/li/baseMoodEffect &lt; 0]</xpath>
      <value>
        <nullifyingGenes>
          <li>XylMeatDependence</li>
          <li>XylCarnivoreStomach</li>
        </nullifyingGenes>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ideology</li>
    </mods>
    <match Class="XylXenos.PatchOperationAddOrMerge">
      <xpath>Defs/ThoughtDef[starts-with(defName,"AteHumanMeat_") and stages/li/baseMoodEffect &lt; 0]</xpath>
      <value>
        <nullifyingGenes>
          <li>XylCarnivoreStomach</li>
        </nullifyingGenes>
      </value>
    </match>
  </Operation>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>
      Defs/ThoughtDef[
        defName="AteCorpse" or
        defName="AteInsectMeatDirect" or
        defName="AteInsectMeatAsIngredient" or
        defName="AteHumanlikeMeatDirect" or
        defName="AteHumanlikeMeatAsIngredient"
      ]
    </xpath>
    <value>
      <nullifyingGenes>
        <li>XylCarnivoreStomach</li>
      </nullifyingGenes>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/ThoughtDef[defName="SleptInBarracks"]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylHerdInstinct</li>
      </nullifyingGenes>
      <modExtensions>
        <li Class="XylXenos.ThoughtDefExtension_Memory">
          <extraThoughts>
            <li>XylSleptInBarracks_HerdInstinct</li>
          </extraThoughts>
        </li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/ThoughtDef[defName="HoldingMePrisoner"]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylHerdInstinct</li>
      </nullifyingGenes>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperationAddOrMerge">
    <xpath>Defs/ThoughtDef[defName="SoakingWet"]</xpath>
    <value>
      <nullifyingGenes>
        <li>XylAquatic</li>
      </nullifyingGenes>
    </value>
  </Operation>

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThoughtDef/nullifyingGenes/li[text()="Furskin"]</xpath>
    <value>
      <li>XylScaleskin</li>
    </value>
  </Operation>

</Patch>
