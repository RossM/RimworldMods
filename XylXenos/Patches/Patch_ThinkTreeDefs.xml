<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <!-- Needs -->

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef//li[@Class="JobGiver_SatisfyChemicalNeed"]</xpath>
    <value>
      <li Class="XylXenos.JobGiver_SatisfyDietDependency"/>
    </value>
  </Operation>

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef//li[@Class="ThinkNode_Priority_GetJoy" and subNodes/li[@Class="JobGiver_GetJoy"]]</xpath>
    <order>Append</order>
    <value>
      <li Class="XylXenos.JobGiver_GetWetness">
        <showerJobDef>XylTakeShower</showerJobDef>
        <soakJobDef>XylSoak</soakJobDef>
      </li>
    </value>
  </Operation>

  <!-- Mental states -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThinkTreeDef[defName="MentalStateNonCritical"]/thinkRoot/subNodes</xpath>
    <order>Append</order>
    <value>

      <li Class="ThinkNode_ConditionalMentalState">
        <state>XylHuntingVermin</state>
        <subNodes>
          <li Class="XylXenos.JobGiver_HuntingVermin"/>
          <li Class="XylXenos.JobGiver_SatisfyDietDependency"/>
          <li Class="ThinkNode_PrioritySorter">
            <subNodes>
              <li Class="JobGiver_GetFood">
                <maxLevelPercentage>0.05</maxLevelPercentage>
              </li>
              <li Class="JobGiver_GetRest">
                <maxLevelPercentage>0.15</maxLevelPercentage>
              </li>
            </subNodes>
          </li>
          <li Class="JobGiver_WanderColony"/>
        </subNodes>
      </li>

    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThinkTreeDef[defName="MentalStateCritical"]/thinkRoot/subNodes</xpath>
    <order>Append</order>
    <value>

      <li Class="ThinkNode_ConditionalMentalState">
        <state>XylSeeingRed</state>
        <subNodes>
          <li Class="XylXenos.JobGiver_SeeingRed"/>
          <li Class="JobGiver_RunRandom">
            <maxDanger>Deadly</maxDanger>
          </li>
        </subNodes>
      </li>

    </value>
  </Operation>

</Patch>
