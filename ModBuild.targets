<Project>
  <PropertyGroup>
    <!-- Always assemble the mod when Visual Studio builds before launching the game. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <ModDataDirectory Condition="'$(ModDataDirectory)' == ''">Data</ModDataDirectory>
  </PropertyGroup>

  <Target Name="CollectModData">
    <ItemGroup>
      <SharedModData Include="$(SharedModDataDirectory)\**\*" Condition="'$(SharedModDataDirectory)' != ''" />
      <DirectoryModData Include="$(ModDataDirectory)\**\*" />
      <ModData Include="@(SharedModData);@(DirectoryModData)" ModRelativePath="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <!-- Each destination receives both shared and mod-specific data. -->
  <Target Name="SyncModData" AfterTargets="PostBuildEvent" DependsOnTargets="CollectModData"
          Outputs="%(ModDestination.Identity)">
    <PropertyGroup>
      <_ModDestination>%(ModDestination.FullPath)</_ModDestination>
    </PropertyGroup>
    <ItemGroup>
      <StaleModData Include="$(_ModDestination)\**\*"
                    Exclude="$(_ModDestination)\Assemblies\**\*;@(ModData->'$(_ModDestination)\%(ModRelativePath)')" />
    </ItemGroup>
    <Delete Files="@(StaleModData)" />
    <Copy SourceFiles="@(ModData)" DestinationFiles="@(ModData->'$(_ModDestination)\%(ModRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- The project's own assembly is automatic. ModAssembly entries name additional files in its build output. -->
  <Target Name="CollectModAssemblies">
    <!-- Bundle only explicitly requested runtimes. The SDK also adds transitive references to ProjectReference. -->
    <MSBuild Projects="@(ProjectReference)" Targets="GetRimWorldModAssemblies"
             Condition="'%(ProjectReference.BundleRimWorldModAssemblies)' == 'true'"
             Properties="TargetFramework=$(TargetFramework);Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_ModAssembly" />
    </MSBuild>
    <ItemGroup>
      <_ModAssembly Include="$(TargetPath);@(ModAssembly->'$(TargetDir)%(Identity)')" />
    </ItemGroup>
  </Target>

  <Target Name="SyncModAssemblies" AfterTargets="PostBuildEvent" DependsOnTargets="CollectModAssemblies"
          Outputs="%(ModDestination.Identity)">
    <PropertyGroup>
      <_ModAssemblyDestination>%(ModDestination.FullPath)\Assemblies</_ModAssemblyDestination>
    </PropertyGroup>
    <ItemGroup>
      <StaleModAssembly Include="$(_ModAssemblyDestination)\*.dll"
                        Exclude="@(_ModAssembly->'$(_ModAssemblyDestination)\%(Filename)%(Extension)')" />
    </ItemGroup>
    <Delete Files="@(StaleModAssembly)" />
    <Copy SourceFiles="@(_ModAssembly)"
          DestinationFolder="$(_ModAssemblyDestination)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CleanModOutput" AfterTargets="Clean">
    <RemoveDir Directories="@(ModDestination)" />
  </Target>
</Project>
