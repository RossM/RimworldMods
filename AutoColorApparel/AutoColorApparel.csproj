<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AutoColorApparel</AssemblyName>
    <RootNamespace>AutoColorApparel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisharmonySourceDirectory)' == ''">
    <PackageReference Include="Disharmony" Version="$(DisharmonyVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisharmonySourceDirectory)' != ''">
    <ProjectReference Include="$(DisharmonyProjectDirectory)Disharmony\Disharmony.csproj" AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" />
    <ProjectReference Include="$(DisharmonyProjectDirectory)Disharmony.Analyzers\Disharmony.Analyzers.csproj" AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Waylith.Injection">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Waylith.Injection.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ModDestination Include="..\ModBin\AutoColorApparel" OwnsOutput="true" />
  </ItemGroup>
  <PropertyGroup>
    <ModDataDirectory>Data</ModDataDirectory>
  </PropertyGroup>
  <Import Project="..\ModBuild.targets" />

</Project>