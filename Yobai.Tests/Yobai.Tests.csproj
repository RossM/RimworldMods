<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yobai\Yobai.csproj" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" />
    <Reference Include="DevTools" HintPath="$(DevToolsAssemblyPath)" Private="false" />
  </ItemGroup>
  <Target Name="CheckDevTools" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DevToolsAssemblyPath)')" Text="DevTools.dll was not found. Build the develop branch of SmashPhil/DevTools for RimWorld 1.7. Set DevToolsAssemblyPath in Directory.Build.local.props for Visual Studio and command-line builds, or pass -p:DevToolsAssemblyPath=path\to\DevTools.dll. See Yobai.Tests/README.md." />
  </Target>
  <Target Name="DeployTests" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\ModBin\Yobai.Tests\Assemblies" />
    <Copy SourceFiles="About\About.xml" DestinationFolder="..\ModBin\Yobai.Tests\About" />
    <Copy SourceFiles="Defs\TestBeds.xml" DestinationFolder="..\ModBin\Yobai.Tests\Defs" />
  </Target>
</Project>
