<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <XenotypeDef>
    <defName>XylTitan</defName>
    <label>titan</label>
    <description>These stony giants are grown in vats for one purpose: to build things that will outlast them. Towering and near-impervious, they work without pause in places that would kill most people: burning deserts, frozen tundras, poisonous wastelands. They don't talk much, don't reflect much, and don't seem to care. Walls go up, fire burns, storms howl—and the Titans keep working.</description>
    <iconPath>Xyl/UI/Icons/Xenotypes/Titan_small</iconPath>
    <displayPriority>-105</displayPriority>
    <inheritable>false</inheritable>
    <combatPowerFactor>2.0</combatPowerFactor>
    <genes>
      <li>XylRockToss</li>
      <li>XylPetrification</li>
      <li>XylMineralizedSkin</li>
      <li>XylLithoid</li>
      <li>WoundHealing_Slow</li>
      <li>Superclotting</li>
      <li>PsychicAbility_Deaf</li>
      <li>MoveSpeed_Slow</li>
      <li>ToxResist_Total</li>
      <li>XylSuperSpecialist</li>
      <li>Learning_Slow</li>
      <li>Beauty_Ugly</li>
      <li>Hair_BaldOnly</li>
      <li>Beard_NoBeardOnly</li>
      <li>Body_Hulk</li>
      <li>XylGiant</li>
      <li>XylJoyless</li>
    </genes>
    <modExtensions>
      <li Class="XylRacesCore.XenotypeDefExtension">
        <agreeingMemes>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Shipborn</li>
        </agreeingMemes>
      </li>
    </modExtensions>
  </XenotypeDef>
  
</Defs>