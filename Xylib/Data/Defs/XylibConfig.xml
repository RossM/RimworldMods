<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <Xylib.Config>
    <defName>XylibConfig</defName>

    <!-- 
    IMPORTANT! This will only work for hediffs that are applied via HealthUtility.AdjustSeverity.
    The list already includes all of the interesting ones that don't have an existing resistance
    stat, so unless you are adding new hediffs, you shouldn't need to patch this list.
    -->
    <resistanceStatByHediff>
      <li>
        <key>BloodLoss</key>
        <value>XylBloodLossResistance</value>
      </li>
      <li>
        <key>DrugOverdose</key>
        <value>XylDrugOverdoseResistance</value>
      </li>
      <li>
        <key>Heatstroke</key>
        <value>XylHeatstrokeResistance</value>
      </li>
      <li>
        <key>Hypothermia</key>
        <value>XylHypothermiaResistance</value>
      </li>
      <li>
        <key>Malnutrition</key>
        <value>XylMalnutritionResistance</value>
      </li>
    </resistanceStatByHediff>
  </Xylib.Config>

  <Xylib.FoodGroupDef>
    <defName>Meat</defName>
    <foodTypes>
      <li>Meat</li>
      <li>Corpse</li>
    </foodTypes>
    <rawNutritionStat>XylRawMeatNutritionFactor</rawNutritionStat>
    <cookedNutritionStat>XylCookedMeatNutritionFactor</cookedNutritionStat>
    <rawFoodPoisonChanceStat>XylRawMeatFoodPoisonChanceFactor</rawFoodPoisonChanceStat>
  </Xylib.FoodGroupDef>

  <Xylib.FoodGroupDef>
    <defName>Vegetable</defName>
    <foodTypes>
      <li>Fungus</li>
      <li>VegetableOrFruit</li>
      <li>Plant</li>
      <li>Seed</li>
    </foodTypes>
    <rawNutritionStat>XylRawVegetableNutritionFactor</rawNutritionStat>
    <cookedNutritionStat>XylCookedVegetableNutritionFactor</cookedNutritionStat>
    <rawFoodPoisonChanceStat>XylRawVegetableFoodPoisonChanceFactor</rawFoodPoisonChanceStat>
  </Xylib.FoodGroupDef>

  <Xylib.FoodGroupDef>
    <defName>AnimalProduct</defName>
    <foodTypes>
      <li>AnimalProduct</li>
    </foodTypes>
    <rawNutritionStat>XylRawAnimalProductNutritionFactor</rawNutritionStat>
    <cookedNutritionStat>XylCookedAnimalProductNutritionFactor</cookedNutritionStat>
    <rawFoodPoisonChanceStat>XylRawAnimalProductFoodPoisonChanceFactor</rawFoodPoisonChanceStat>
  </Xylib.FoodGroupDef>

  <Xylib.FoodGroupDef>
    <defName>Fungus</defName>
    <foodTypes>
      <li>Fungus</li>
    </foodTypes>
    <exact>true</exact>
    <rawNutritionStat>XylRawFungusNutritionFactor</rawNutritionStat>
    <cookedNutritionStat>XylCookedFungusNutritionFactor</cookedNutritionStat>
    <rawFoodPoisonChanceStat>XylRawFungusFoodPoisonChanceFactor</rawFoodPoisonChanceStat>
  </Xylib.FoodGroupDef>

  <Xylib.FoodGroupDef>
    <defName>Humanlike</defName>
    <foodTypes>
      <li>Meat</li>
      <li>Corpse</li>
    </foodTypes>
    <humanlike>true</humanlike>
  </Xylib.FoodGroupDef>

  <Xylib.FoodGroupDef>
    <defName>Insect</defName>
    <foodTypes>
      <li>Meat</li>
      <li>Corpse</li>
    </foodTypes>
    <fleshType>Insectoid</fleshType>
  </Xylib.FoodGroupDef>

</Defs>
