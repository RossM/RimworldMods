<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <DevToolsAssemblyPath>$(MSBuildThisFileDirectory)..\ModBin\DevTools\1.7\Assemblies\DevTools.dll</DevToolsAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" />
    <Reference Include="DevTools" HintPath="$(DevToolsAssemblyPath)" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)DevTools\DevTools.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Yobai.Tests'">
    <Compile Include="..\InGameTests\PawnTestFixture.cs" Link="PawnTestFixture.cs" />
    <Using Include="DevTools.Testing" />
    <Using Include="RimWorld" />
    <Using Include="Verse" />
    <Using Include="Xylib" />
    <Using Include="InGameTests" />
  </ItemGroup>
  <Target Name="DeployTests" AfterTargets="Build">
    <ItemGroup>
      <TestModData Include="About\**\*;Defs\**\*;Configs\**\*" />
      <TestModAssembly Include="$(TargetPath);$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(TestModAssembly)" DestinationFolder="..\ModBin\$(MSBuildProjectName)\Assemblies" />
    <Copy SourceFiles="@(TestModData)" DestinationFiles="@(TestModData->'..\ModBin\$(MSBuildProjectName)\%(Identity)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
