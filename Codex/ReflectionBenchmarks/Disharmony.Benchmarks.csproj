<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Fixtures/**/*.cs" />
    <ProjectReference Include="Fixtures/Forwarder/Forwarder.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures/Padding/Padding.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../Disharmony/Disharmony.csproj" />
    <ProjectReference Include="../../Disharmony.TestTargets/Disharmony.TestTargets.csproj" />
    <PackageReference Include="NUnitLite" Version="4.6.1" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <Compile Include="../../Disharmony/ReflectionTools.cs" Link="CurrentReflectionTools.cs" />
    <Compile Include="../../Disharmony.Tests/Unit/ReflectionToolsTests.cs" Link="CurrentReflectionToolsTests.cs" />
    <Compile Include="../../Disharmony.Tests/Unit/ReflectionTypeResolutionTests.cs" Link="ReflectionTypeResolutionTests.cs" />
  </ItemGroup>
  <Target Name="GenerateReflectionExperiments" BeforeTargets="CoreCompile">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Prepare-Experiments.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Experiments&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Experiments/*.cs" />
    </ItemGroup>
  </Target>
</Project>
