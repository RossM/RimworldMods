<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net4.7.2</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <AssemblyName>Disharmony.TestTargets</AssemblyName>
    <RootNamespace>Disharmony.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.3.2" />
  </ItemGroup>

  <Target Name="RequireReleaseConfiguration" BeforeTargets="CoreCompile" Condition="'$(Configuration)' != 'Release'">
    <Error Text="Disharmony test targets must be built with Configuration=Release." />
  </Target>

</Project>
