<?xml version="1.0" encoding="utf-8" ?> 

<Defs>
  
  <ThingDef ParentName="ThingDef_Seal">
    <defName>XylSelkie</defName>
    <label>selkie</label>
    <description>A genetically engineered seal used by nixies as a pack animal. They are larger than regular seals, and move faster on land.</description>
    <statBases>
      <MoveSpeed>3.9</MoveSpeed>
      <MarketValue>430</MarketValue>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <FilthRate>8</FilthRate>
      <Wildness>0.4</Wildness>
    </statBases>
    <tools Inherit="false">
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.6</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <packAnimal>true</packAnimal>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>1.0</baseHealthScale>
      <baseHungerRate>0.45</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
    </race>
  </ThingDef>

