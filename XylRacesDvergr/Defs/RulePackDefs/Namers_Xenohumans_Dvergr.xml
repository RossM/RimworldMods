<?xml version="1.0" encoding="utf-8" ?>

<Defs>
  <RulePackDef>
    <defName>XylNamerPersonDvergr</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[firstName] [lastName]</li>
        <li>r_name->[firstName] '[nickName]' [lastName]</li>

        <li>firstName->[SylD][SylD]</li>

        <li>lastName->[SylD][SylD][SylD]</li>

        <li>nickName->[nickStart][nickEnd]</li>
        <li>nickName(p=0.02)->[specialNickname]</li>

        <li>specialNickname->bashful</li>
        <li>specialNickname->doc</li>
        <li>specialNickname->dopey</li>
        <li>specialNickname->grumpy</li>
        <li>specialNickname->happy</li>
        <li>specialNickname->sleepy</li>
        <li>specialNickname->sneezy</li>
      </rulesStrings>
      <rulesFiles>
        <li>SylD->Xyl/WordParts/Syllables_Dvergr</li>
        <li>nickStart->Xyl/WordParts/Nickname_Starts_Dvergr</li>
        <li>nickEnd->Xyl/WordParts/Nickname_Ends_Dvergr</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

</Defs>