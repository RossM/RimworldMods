<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <XenotypeDef>
    <defName>XylDvergr</defName>
    <label>dvergr</label>
    <description>Dvergr hail from craggy, mineral-rich worlds where most things worth doing happen underground. Short and stoic, they're built for labor, not conversation—tireless workers who'd rather break rock than make small talk. Raw fungus keeps them alive, though they hate the taste, and they need alcohol to get them through the working day. Smiles are rare, rest rarer—and now and then, after a long silence, one of them makes something no one else could.</description>
    <iconPath>Xyl/UI/Icons/Xenotypes/Dvergr_small</iconPath>
    <displayPriority>-103</displayPriority>
    <inheritable>true</inheritable>
    <nameMaker>XylNamerPersonDvergr</nameMaker>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <genes>
      <li>PsychicAbility_Dull</li>
      <li>MoveSpeed_Slow</li>
      <li>XylStoic</li>
      <li>XylMelancholy</li>
      <li>MaxTemp_LargeIncrease</li>
      <li>Aggression_Aggressive</li>
      <li>Hair_BaldOnly</li>
      <li>Hair_ShortOnly</li>
      <li>Beard_BushyOnly</li>
      <li>XylEars_SmallPointed</li>
      <li>XylDwarf</li>
      <li>Skin_LightGray</li>
      <li>Skin_SlateGray</li>
      <li>Skin_InkBlack</li>
      <li>StrongStomach</li>
      <li>XylFungusEater</li>
      <li>DarkVision</li>
      <li>CaveDweller</li>
      <li>Unstoppable</li>
      <li>XylIndustrious</li>
      <li>AptitudeStrong_Construction</li>
      <li>AptitudeStrong_Mining</li>
      <li>AptitudeStrong_Crafting</li>
      <li>AptitudePoor_Medicine</li>
      <li>AptitudePoor_Social</li>
      <li>ChemicalDependency_Alcohol</li>
    </genes>
    <modExtensions>
      <li Class="XylRacesCore.XenotypeDefExtension">
        <agreeingMemes>
          <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
        </agreeingMemes>
        <disagreeingMemes>
          <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
        </disagreeingMemes>
      </li>
    </modExtensions>
  </XenotypeDef>

</Defs>