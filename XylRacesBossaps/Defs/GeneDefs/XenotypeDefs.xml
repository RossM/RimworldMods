<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <XenotypeDef>
    <defName>XylBossaps</defName>
    <label>bossaps</label>
    <description>Bossaps were engineered as sentient livestock by the gene-artisans of a glitterworld best left forgotten. When things are peaceful they are calm and mild-mannered. But when they're hurt, instinct takes over, and they charge their enemies like a raging bull.</description>
    <iconPath>Xyl/UI/Icons/Xenotypes/Bossaps_small</iconPath>
    <displayPriority>-101</displayPriority>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.6</combatPowerFactor>
    <nameMaker>XylNamerPersonBossapsMale</nameMaker>
    <nameMakerFemale>XylNamerPersonBossapsFemale</nameMakerFemale>
    <chanceToUseNameMaker>0.75</chanceToUseNameMaker>
    <genes>
      <li>XylHerdInstinct</li>
      <li>XylDocile</li>
      <li>XylLargeHorns</li>
      <li>XylSeeingRed</li>
      <li>MinTemp_SmallDecrease</li>
      <li>MaxTemp_SmallIncrease</li>
      <li>Robust</li>
      <li>XylPainReversal</li>
      <li>Fertile</li>
      <li>XylHyperlactation</li>
      <li>XylGender_UsuallyFemale</li>
      <li>Hair_LongOnly</li>
      <li>Body_Standard</li>
      <li>Body_Fat</li>
      <li>Body_Hulk</li>
      <li>XylEars_Cow</li>
      <li>Nearsighted</li>
      <li>XylHerbivoreStomach</li>
      <li>AptitudePoor_Cooking</li>
      <li>AptitudeStrong_Plants</li>
    </genes>
    <modExtensions>
      <li Class="XylRacesCore.XenotypeDefExtension">
        <agreeingMemes>
          <li>AnimalPersonhood</li>
          <li>Nudism</li>
        </agreeingMemes>
        <disagreeingMemes>
          <li>Rancher</li>
        </disagreeingMemes>
      </li>
    </modExtensions>
  </XenotypeDef>
  
</Defs>