<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Always sync data when Visual Studio builds before launching the game. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <BaseOutputPath>..\Build\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <IntermediateOutputPath>..\Build\obj\$(MSBuildProjectName)\</IntermediateOutputPath>
  </PropertyGroup>

  <Target Name="CollectModData">
    <PropertyGroup>
      <!-- SDK exclusion patterns are relative to a source root, including the shared one. -->
      <_SharedModDataExcludes>$(SharedModDataDirectory)\$([System.String]::Copy('$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)').Replace('/', '\').Replace(';', ';$(SharedModDataDirectory)\'))</_SharedModDataExcludes>
      <!-- Property functions escape wildcard characters; restore them for glob matching. -->
      <_SharedModDataExcludes>$([MSBuild]::Unescape('$(_SharedModDataExcludes)'))</_SharedModDataExcludes>
    </PropertyGroup>
    <ItemGroup>
      <SharedModData Include="$(SharedModDataDirectory)\**\*"
                     Exclude="$(_SharedModDataExcludes);$(SharedModDataDirectory)\bin\**;$(SharedModDataDirectory)\obj\**"
                     Condition="'$(SharedModDataDirectory)' != ''" />
      <ModData Include="@(SharedModData)" ModRelativePath="%(RecursiveDir)%(Filename)%(Extension)" />
      <ModData Include="@(None)" ModRelativePath="%(Identity)" />
    </ItemGroup>
  </Target>

  <!-- Batch by destination so the shared-data project can copy to both mods. -->
  <Target Name="SyncModData" AfterTargets="PostBuildEvent" DependsOnTargets="CollectModData"
          Outputs="%(ModDataDestination.Identity)">
    <PropertyGroup>
      <_ModDataDestination>%(ModDataDestination.FullPath)</_ModDataDestination>
      <_OwnsModDataOutput>%(ModDataDestination.OwnsOutput)</_OwnsModDataOutput>
    </PropertyGroup>
    <ItemGroup Condition="'$(_OwnsModDataOutput)' == 'true'">
      <!-- Shared-only builds cannot delete files belonging to the consuming mod. -->
      <StaleModData Include="$(_ModDataDestination)\**\*"
                    Exclude="$(_ModDataDestination)\Assemblies\**\*;@(ModData->'$(_ModDataDestination)\%(ModRelativePath)')" />
    </ItemGroup>
    <Delete Files="@(StaleModData)" />
    <Copy SourceFiles="@(ModData)" DestinationFiles="@(ModData->'$(_ModDataDestination)\%(ModRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CleanModOutput" AfterTargets="Clean">
    <RemoveDir Directories="@(ModDataDestination)" Condition="'%(ModDataDestination.OwnsOutput)' == 'true'" />
  </Target>
</Project>
