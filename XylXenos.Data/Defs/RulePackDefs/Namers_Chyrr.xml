<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <RulePackDef Name="NamerXylPersonChyrrBase" Abstract="True">
    <rulePack>
      <rulesStrings>
        <li>r_name->[firstName] [lastName]</li>
        <li>r_name(p=3)->[firstName] '[nickName]' [lastName]</li>

        <li>firstName->[consonant]'[consonant][vowel]</li>

        <li>lastName->[syl1][syl2][suffix]</li>
        <li>lastName(p=0.2)->[syl1][syl1][syl2][suffix]</li>
      </rulesStrings>
      <rulesFiles>
        <li>syl1->Xyl/WordParts/Chyrr/Syllables_1</li>
        <li>syl2->Xyl/WordParts/Chyrr/Syllables_2</li>
        <li>syl3->Xyl/WordParts/Chyrr/Syllables_2</li>
        <li>consonant->Xyl/WordParts/Chyrr/Consonants</li>
        <li>vowel->Xyl/WordParts/Chyrr/Vowels</li>
        <li>suffix->Xyl/WordParts/Chyrr/Name_Suffixes</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>

  <RulePackDef ParentName="NamerXylPersonChyrrBase">
    <defName>NamerXylPersonChyrrMale</defName>
    <rulePack>
      <rulesStrings>
        <li>nickName->[PersonJob]</li>
        <li>nickName->[Color]</li>
        <li>nickName->[AdjectiveAny]</li>
        <li>nickName->[ConceptAny]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef ParentName="NamerXylPersonChyrrBase">
    <defName>NamerXylPersonChyrrFemale</defName>
    <rulePack>
      <rulesStrings>
        <li>nickName->[NaturalObject]</li>
        <li>nickName->[TreeType]</li>
        <li>nickName->[TerrainFeature]</li>
        <li>nickName->[Vegetable]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

</Defs>
