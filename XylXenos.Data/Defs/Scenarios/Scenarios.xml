<?xml version="1.0" encoding="utf-8"?>

<Defs>
  
  <ScenarioDef ParentName="Crashlanded">
    <defName>XylMenagerie</defName>
    <label>Menagerie</label>
    <description>The classic Crashlanded scenario, but any character can be any non-archite xenotype.</description>
    <scenario>
      <summary>Any character can be any xenotype.</summary>
      <parts>
        <li Class="XylXenos.ScenPart_RandomXenotype">
          <def>XylRandomXenotypes</def>
          <chance>1</chance>
          <context>PlayerStarter</context>
        </li>
        <li Class="XylXenos.ScenPart_RandomXenotype">
          <def>XylRandomXenotypes</def>
          <chance>0.5</chance>
          <context>NonPlayer</context>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

  <ScenarioDef ParentName="ScenarioBase" MayRequire="Ludeon.RimWorld.Royalty">
    <defName>XylDvergrFortress</defName>
    <label>Dvergr Fortress</label>
    <description>Seven dvergr, a drop pod full of raw fungus and beer, and a rimworld laced with hidden veins of gold and plasteel. You’ve heard of worse starts. Not many, but some.\n\nYou didn't come here to explore or escape. You came to mine, to build, and maybe, if the alcohol holds out, to create something worth remembering. The fungus is barely edible. The days are long. The tantrums will come. But the stone is waiting.</description>
    <scenario>
      <summary>Seven dvergr, plenty of raw fungus and beer. Strike the earth!</summary>
      <parts>

        <!-- Config pages -->
        <li Class="XylXenos.ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes_Ext">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>7</pawnChoiceCount>
          <xenotypeCounts>
            <li>
              <xenotype>XylDvergr</xenotype>
              <count>7</count>
              <requiredAtStart>true</requiredAtStart>
            </li>
          </xenotypeCounts>
        </li>

        <!-- Starting techs -->
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Brewing</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Smithing</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>LongBlades</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>PlateArmor</project>
        </li>

        <!-- Player starting stuff spawn method-->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
          <visible>false</visible>
        </li>

        <!-- Player pawns modifiers -->
        <li Class="ScenPart_ForcedHediff">
          <def>ForcedHediff</def>
          <visible>false</visible>
          <context>PlayerStarter</context>
          <chance>0.5</chance>
          <hediff>CryptosleepSickness</hediff>
          <hideOffMap>true</hideOffMap>
          <severityRange>1~1</severityRange>
        </li>

        <!-- Player starting things -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>800</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>RawFungus</thingDef>
          <count>500</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Beer</thingDef>
          <count>50</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>30</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>30</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Axe</thingDef>
          <stuff>Steel</stuff>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Warhammer</thingDef>
          <stuff>Steel</stuff>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_LongSword</thingDef>
          <stuff>Steel</stuff>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Knife</thingDef>
          <stuff>Steel</stuff>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <count>3</count>
          <bondToRandomPlayerPawnChance>0.0</bondToRandomPlayerPawnChance>
        </li>

        <!-- Scatter some things near player start -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>450</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
        </li>

        <!-- Game start dialog -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>You have arrived. After the long journey across the stars from Svartalfheim, you've been dropped onto your target world. The seven of you have tools, fungus, and beer enough to get started.\n\nNow is the time to secure a food source and carve out lodgings, ere the wargs get hungry. A new chapter of dvergr history begins here. Strike the earth!</text>
          <closeSound>GameStartSting</closeSound>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>XylWarcatTribe</defName>
    <label>Warcat Tribe</label>
    <description>You were cast out from the pride. No one said exactly why, not to your face. You left with two slaves and a few supplies, and set out to find a new home in land no one else wanted. The old tribe expects you to die quickly. Maybe they're right. But you're still warcat: strong, fast, proud. The hunt is in your blood. The hunger won't wait.</description>
    <scenario>
      <summary>Three warcats and two slaves.</summary>
      <playerFaction>
        <factionDef>PlayerTribe</factionDef>
      </playerFaction>
      <parts>

        <!-- Config pages -->
        <li Class="XylXenos.ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes_Ext">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <customSummary>Start with 3 warcats and 2 others.</customSummary>
          <xenotypeCounts>
            <li>
              <xenotype>XylWarcat</xenotype>
              <count>3</count>
              <requiredAtStart>true</requiredAtStart>
            </li>
            <li>
              <xenotype>XylBossaps</xenotype>
              <count>2</count>
            </li>
          </xenotypeCounts>
        </li>

        <!-- Player starting stuff spawn method-->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <!-- Player starting things -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Meat_Deer</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>20</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Bow_Short</thingDef>
          <count>3</count>
        </li>
        <li Class="XylXenos.ScenPart_StartingSlaves">
          <def>XylStartingSlaves</def>
          <count>2</count>
        </li>

        <!-- Scatter some things near player start -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>500</count>
        </li>

        <!-- Game start dialog -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>You were cast out. The pride didn't say much, and you didn't ask. No one tried to stop you. You took what you could carry and walked away, claws clean, heads high.\n\nThe land here is unfamiliar, but it'll do. Shelter first. Then food. Meat. The hunger doesn't wait long. You'll survive together, or you won't. This is your territory now... if you can hold it.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
