<?xml version="1.0" encoding="utf-8" ?>

<Patch>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/XenotypeDef[defName="Sanguophage"]</xpath>
    <value>
      <doubleXenotypeChances>
        <XylBossaps>0.02</XylBossaps>
        <XylChyrr>0.02</XylChyrr>
        <XylDvergr>0.02</XylDvergr>
        <XylNixie>0.02</XylNixie>
        <XylOmegabeaver>0.02</XylOmegabeaver>
        <XylScaleborn>0.02</XylScaleborn>
        <XylSuccuboid>0.02</XylSuccuboid>
        <XylTrog>0.02</XylTrog>
        <XylWarcat>0.02</XylWarcat>
        <XylZeegee>0.02</XylZeegee>
      </doubleXenotypeChances>
    </value>
  </Operation>

  <Operation Class="XylXenos.PatchOperation_DisableXenotypes">
    <patches>
      <li Class="Xylib.PatchOperationMerge">
        <xpath>Defs/FactionDef[xenotypeSet/xenotypeChances/{0} &gt;= 1 or xenotypeSet/defaultXenotype="{0}"]</xpath>
        <value>
          <displayInFactionSelection>false</displayInFactionSelection>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/FactionDef/xenotypeSet/xenotypeChances/{0}[text() &lt; 1]/text()</xpath>
        <value>0</value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/PawnKindDef/xenotypeSet/xenotypeChances/{0}[text() &lt; 1]/text()</xpath>
        <value>0</value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/MemeDef/xenotypeSet/xenotypeChances/{0}[text() &lt; 1]/text()</xpath>
        <value>0</value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/XenotypeDef/doubleXenotypeChances/{0}/text()</xpath>
        <value>0</value>
      </li>
    </patches>
  </Operation>

  <Operation Class="XylXenos.PatchOperation_DisableXenotypes">
    <xenotype>XylBossaps</xenotype>
    <patches>
      <li Class="PatchOperationReplace">
        <xpath>Defs/IncidentDef/XylWildBossapsHerd/baseChance/text()</xpath>
        <value>0</value>
      </li>
    </patches>
  </Operation>

  <Operation Class="XylXenos.PatchOperation_DisableXenotypes">
    <xenotype>XylTitan</xenotype>
    <patches>
      <li Class="PatchOperationReplace">
        <xpath>Defs/QuestScriptDef/QuestScriptDef/rootSelectionWeight/text()</xpath>
        <value>0</value>
      </li>
    </patches>
  </Operation>

</Patch>