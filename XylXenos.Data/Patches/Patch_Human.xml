<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThingDef[defName="Human"]/recipes/li[text()="ExciseCarcinoma"]</xpath>
    <order>Append</order>
    <value>
      <li>XylExcisePetrifiedFlesh</li>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/PawnRenderTreeDef[defName="Humanlike"]//li[tagDef="Body"]</xpath>
    <value>
      <subworkerClasses>
        <li>Xylib.PawnRenderSubWorker_Body</li>
      </subworkerClasses>
    </value>
  </Operation>
  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/PawnRenderTreeDef[defName="Humanlike"]//li[tagDef="Head" or nodeClass="PawnRenderNode_Stump"]</xpath>
    <value>
      <subworkerClasses>
        <li>Xylib.PawnRenderSubWorker_Head</li>
      </subworkerClasses>
    </value>
  </Operation>

</Patch>
