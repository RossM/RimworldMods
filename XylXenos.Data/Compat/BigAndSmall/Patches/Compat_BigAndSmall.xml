<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <Operation Class="Xylib.PatchOperationReplaceGenes">
    <entries>
      <li>
        <original>XylNocturnal</original>
        <replacement>BS_NightOwl</replacement>
      </li>
    </entries>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="BS_NightOwl"]</xpath>
    <value>
      <exclusionTags>
        <li>XylNightOwl</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="BS_AutoPregnancy" or defName="BS_AutoPregnancyArchite"]</xpath>
    <value>
      <exclusionTags>
        <li>XylAsexualPregnancy</li>
      </exclusionTags>
    </value>
  </Operation>

  <Operation Class="Xylib.PatchOperationMerge">
    <xpath>Defs/GeneDef[defName="BS_Diet_Herbivore" or defName="BS_Diet_Fuel"]</xpath>
    <value>
      <exclusionTags>
        <li>XylMeatRequirement</li>
      </exclusionTags>
    </value>
  </Operation>

</Patch>
